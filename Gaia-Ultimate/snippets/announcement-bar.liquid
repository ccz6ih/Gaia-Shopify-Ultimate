{%- assign show_announcement = false -%}
{%- assign announcement_block_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'announcement' -%}
    {%- assign show_announcement = true -%}
    {%- assign announcement_block_count = announcement_block_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
 
{% if show_announcement %}
<div class="toolbar__item toolbar__item--announcements" {% if section.settings.one-text == true %} not-a-slider {% endif %}>
    <div class="announcement-bar{% if section.settings.announcement_center %} text-center{% endif %}">
      <div class="slideshow-wrapper announcement-wrapper">
        <button type="button" class="visually-hidden slideshow__pause" data-id="{{ section.id }}" aria-live="polite">
          <span class="slideshow__pause-stop">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-pause" viewBox="0 0 10 13"><g fill="#000" fill-rule="evenodd"><path d="M0 0h3v13H0zM7 0h3v13H7z"/></g></svg>
            <span class="icon__fallback-text">{{ 'sections.slideshow.pause_slideshow' | t }}</span>
          </span>
          <span class="slideshow__pause-play">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="18.24 17.35 24.52 28.3"><path fill="#323232" d="M22.1 19.151v25.5l20.4-13.489-20.4-12.011z"/></svg>
            <span class="icon__fallback-text">{{ 'sections.slideshow.play_slideshow' | t }}</span>
          </span>
        </button>


      
        <div

    class="announcement-slider {% if section.settings.one-text != true %} spl-new-slide {% endif %}"
          data-block-count="{{ announcement_block_count }}">
          <div class="splide__arrows">
            <button class="splide__arrow splide__arrow--prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="8" height="14" viewBox="0 0 8 14" fill="none">
              <path d="M7.229 13.604C7.40478 13.4282 7.49267 13.2085 7.49267 12.9448C7.49267 12.6812 7.40478 12.4614 7.229 12.2856L2.26318 7.31982L7.229 2.354C7.40478 2.17822 7.49268 1.9585 7.49268 1.69482C7.49268 1.43115 7.40478 1.21143 7.229 1.03565C7.03857 0.845216 6.81519 0.750001 6.55884 0.750001C6.30249 0.750001 6.08643 0.845215 5.91064 1.03565L0.285644 6.66064C0.183105 6.74854 0.109863 6.85107 0.0659173 6.96826C0.021972 7.08545 -6.41054e-07 7.20264 -6.52697e-07 7.31982C-6.64339e-07 7.43701 0.021972 7.5542 0.0659173 7.67139C0.109863 7.78857 0.183105 7.89111 0.285644 7.979L5.91064 13.604C6.08642 13.7944 6.30249 13.8896 6.55884 13.8896C6.81518 13.8896 7.03857 13.7944 7.229 13.604Z" fill="white" fill-opacity="0.4"/>
            </svg>
                            </button>
            <button class="splide__arrow splide__arrow--next">
              <svg xmlns="http://www.w3.org/2000/svg" width="8" height="14" viewBox="0 0 8 14" fill="none">
              <path d="M0.756348 1.03564C0.580567 1.21143 0.492676 1.43115 0.492676 1.69482C0.492676 1.9585 0.580567 2.17822 0.756348 2.354L5.72217 7.31982L0.756348 12.2856C0.580567 12.4614 0.492676 12.6812 0.492676 12.9448C0.492676 13.2085 0.580567 13.4282 0.756348 13.604C0.946778 13.7944 1.17017 13.8896 1.42651 13.8896C1.68286 13.8896 1.89893 13.7944 2.07471 13.604L7.69971 7.979C7.80225 7.89111 7.87549 7.78857 7.91943 7.67139C7.96338 7.5542 7.98535 7.43701 7.98535 7.31982C7.98535 7.20264 7.96338 7.08545 7.91943 6.96826C7.87549 6.85107 7.80225 6.74854 7.69971 6.66064L2.07471 1.03564C1.89893 0.845215 1.68286 0.75 1.42651 0.75C1.17017 0.75 0.946778 0.845215 0.756348 1.03564Z" fill="white" fill-opacity="0.4"/>
            </svg>            </button>
      </div>  
          {%- assign slide_index = 0 -%}
          <div class="splide__track">
            <ul class="splide__list" {% if section.settings.one-text == true %} style="justify-content:center;" {% endif %}>
          {%- for block in section.blocks -%}
            {%- if block.type == 'announcement' -%}
              <div
                id="AnnouncementSlide-{{ block.id }}"
                class=" splide__slide"
                data-index="{{ slide_index }}"
                {{ block.shopify_attributes }}>
                <div class="announcement-slider__content">
                  {%- if block.settings.richtext_mobile != blank -%}
                    <div class="medium-up--hide">
                      {{ block.settings.richtext_mobile }}
                    </div>
                    <div class="small--hide">
                      {{ block.settings.richtext }} 
                      {% if customer %}
                        {% if block.settings.login-yes != blank %}                        
                          <span onclick="location.href = '{{ block.settings.login-link-yes }}'" class="logged-in-customer log-an-link">{{ block.settings.login-yes }}</span>
                        {% endif %}
                          {%else %}
                          {% if block.settings.login-no != blank %}
                            <span onclick="location.href = '{{ block.settings.login-link }}'" class="not-logged-in-customer log-an-link">{{ block.settings.login-no }}</span>
                           
                           {%endif %}
                           {% if block.settings.signup-no != blank %}
                           <span class="or-handle">or</span>  
                           <span onclick="location.href = '{{ block.settings.signup-link }}'" class="not-logged-in-customer log-an-link">{{ block.settings.signup-no }}</span>
                          {% endif %}
                      {% endif %}
                    </div>
                  {%- else -%}
                    {{ block.settings.richtext }}
                    {% if customer %}
                      {% if block.settings.login-yes != blank %}                        
                        <span onclick="location.href = '{{ block.settings.login-link-yes }}'" class="logged-in-customer log-an-link">{{ block.settings.login-yes }}</span>
                      {% endif %}
                        {%else %}
                        {% if block.settings.login-no != blank %}

                          <span onclick="location.href = '{{ block.settings.login-link }}'" class="not-logged-in-customer log-an-link">{{ block.settings.login-no }}</span>
                      
                         {%endif%}
                         {% if block.settings.signup-no != blank %}
                          <span class="or-handle">or</span> 
                         <span onclick="location.href = '{{ block.settings.signup-link }}'" class="not-logged-in-customer log-an-link">{{ block.settings.signup-no }}</span>
                        {% endif %}
                      
                    {%endif%}
                  {%- endif -%}
                </div>
              </div>
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}
{% if section.settings.one-text != true %}
<script>


var splide = new Splide('.spl-new-slide', {
    perPage: 1,
    arrows: true,
    pagination: false,
    perMove: 1,
    type: 'loop',
    autoplay: 'pause',
    adaptiveHeight: true,
    rewind: true,
    drag: true,
    interval: 4000,
    speed: 2000,
    keyboard: true
  });

  splide.mount();



</script>
{% endif %}