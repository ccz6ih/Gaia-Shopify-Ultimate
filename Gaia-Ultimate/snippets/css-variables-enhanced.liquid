{%- comment -%}
  Enhanced CSS Variables
  ======================
  Extends Dawn's CSS variables with Fetch-inspired customization options.
  This snippet outputs additional CSS custom properties for:
  - Typography enhancements (letter-spacing, line-height)
  - Design options (edges, button styles)
  - Icon customization
  - Product grid styling
  - Animation timing
{%- endcomment -%}

{%- style -%}
:root {
  /* Typography Enhancements */
  --type-header-spacing: {{ settings.type_header_spacing | default: '0' | divided_by: 1000.00 }}em;
  --type-header-line-height: {{ settings.type_header_line_height | default: 1.2 }};
  --type-body-spacing: {{ settings.type_body_spacing | default: '0' | divided_by: 1000.00 }}em;
  --type-body-line-height: {{ settings.type_body_line_height | default: 1.6 }};
  --type-nav-size: {{ settings.type_navigation_size | default: 16 }}px;

  /* Design: Edge Styles */
  {%- if settings.edges == 'round' -%}
    --edge-radius: 20px;
    --edge-radius-small: 10px;
  {%- else -%}
    --edge-radius: 0px;
    --edge-radius-small: 0px;
  {%- endif -%}

  /* Design: Button Styles */
  {%- case settings.button_style -%}
    {%- when 'round' -%}
      --button-radius: 50px;
      --button-padding: 11px 25px;
    {%- when 'round-slight' -%}
      --button-radius: 6px;
      --button-padding: 11px 25px;
    {%- else -%}
      --button-radius: 0px;
      --button-padding: 11px 20px;
  {%- endcase -%}

  /* Icon Customization */
  --icon-weight: {{ settings.icon_weight | default: '5px' }};
  --icon-linecaps: {{ settings.icon_linecaps | default: 'miter' }};

  /* Product Grid Styles */
  {%- case settings.product_grid_style -%}
    {%- when 'gridlines-thick' -%}
      --grid-border-width: 2px;
    {%- when 'gridlines-thin' -%}
      --grid-border-width: 1px;
    {%- else -%}
      --grid-border-width: 0px;
  {%- endcase -%}

  --product-tile-margin: {{ settings.product_grid_image_margin | default: 10 }}%;
  --collection-tile-margin: {{ settings.collection_grid_image_margin | default: 10 }}%;
  --swatch-size: {{ settings.swatch_size | default: 30 }}px;

  /* Additional Colors */
  --color-price: {{ settings.color_price | default: '#121212' }};
  --color-sale-price: {{ settings.color_sale_price | default: '#ff4e4e' }};
  --color-cart-badge: {{ settings.color_cart_badge | default: '#ff4f33' }};

  /* Section Padding Presets */
  --section-padding-small: {{ settings.section_padding_small | default: 20 }}px;
  --section-padding-medium: {{ settings.section_padding_medium | default: 40 }}px;
  --section-padding-large: {{ settings.section_padding_large | default: 60 }}px;
  --mobile-padding-multiplier: {{ settings.mobile_padding_multiplier | default: 75 | divided_by: 100.0 }};

  /* Animation Settings */
  --animation-duration: {{ settings.animation_duration | default: 400 }}ms;
  --animation-easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Mobile Adjustments */
@media screen and (max-width: 749px) {
  :root {
    --section-padding-small: calc({{ settings.section_padding_small | default: 20 }}px * var(--mobile-padding-multiplier));
    --section-padding-medium: calc({{ settings.section_padding_medium | default: 40 }}px * var(--mobile-padding-multiplier));
    --section-padding-large: calc({{ settings.section_padding_large | default: 60 }}px * var(--mobile-padding-multiplier));

    {%- if settings.edges == 'round' -%}
      --edge-radius: 15px;
      --edge-radius-small: 8px;
    {%- endif -%}
  }
}

/* RTL Support */
{%- if settings.text_direction == 'rtl' -%}
html {
  direction: rtl;
}

.rtl-flip {
  transform: scaleX(-1);
}
{%- endif -%}

/* Heading Capitalization */
{%- if settings.type_header_capitalize -%}
h1, h2, h3, h4, h5, h6,
.h0, .h1, .h2, .h3, .h4, .h5 {
  text-transform: uppercase;
}
{%- endif -%}

/* Navigation Capitalization */
{%- if settings.type_navigation_capitalize -%}
.header__menu-item,
.menu-drawer__menu-item {
  text-transform: uppercase;
}
{%- endif -%}

/* Navigation Font Style */
{%- if settings.type_navigation_style == 'heading' -%}
.header__menu-item,
.menu-drawer__menu-item {
  font-family: var(--font-heading-family);
  font-weight: var(--font-heading-weight);
}
{%- endif -%}
{%- endstyle -%}
