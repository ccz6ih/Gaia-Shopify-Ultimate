{% comment %} this file displays discounted pricing when applicable {% endcomment %}

{%- liquid
  assign global_discount_percent = 10.0
  assign global_discount_price_percent = 100.0 | minus : global_discount_percent
  assign is_gaia_plus = false

  assign discount_percent = 0.0
  assign discount_price_percent = 100.0

  assign eligible_vendors_igniton = "Igniton" | downcase
  assign vendor_downcase = product.vendor | downcase

  if eligible_vendors_igniton == vendor_downcase
    assign global_discount_percent = 15.0
    assign global_discount_price_percent = 100.0 | minus : global_discount_percent
    if customer.tags contains '290' or customer.tags contains '253' or customer.tags contains '280'
      assign discount_percent = 15.0
      assign discount_price_percent = 100.0 | minus : discount_percent
    endif
  elsif customer.tags contains '290'
    assign eligible_vendors_events = "Gaia Meetup,GaiaSphere" | downcase | split: ','
    if eligible_vendors_events contains vendor_downcase
      assign discount_percent = 25.0
      assign global_discount_percent = 25.0
      assign global_discount_price_percent = 100.0 | minus : global_discount_percent
      assign is_gaia_plus = true
      assign discount_price_percent = 100.0 | minus : discount_percent
    else
      assign discount_percent = 10.0
      assign discount_price_percent = 100.0 | minus : discount_percent
    endif
  elsif customer.tags contains '253' or customer.tags contains '280'
    assign discount_percent = 10.0
    assign discount_price_percent = 100.0 | minus : discount_percent
  endif

  if product.tags contains 'NO-DISCOUNT'
    assign discount_percent = 0.0
    assign discount_price_percent = 100.0
    assign global_discount_percent = 0.0
    assign global_discount_price_percent = 100.0
  endif

  assign discount_price = price | divided_by: 100.0 | times: discount_price_percent
  assign discount_amount = price | minus : discount_price
  assign global_discount_price = price | divided_by: 100.0 | times: global_discount_price_percent
  assign global_discount_amount = price | minus : global_discount_price
  assign global_formatted_price = price | money
  assign global_formatted_discount_price = global_discount_price | money
  assign global_formatted_discount_amount = global_discount_amount | money

  assign formatted_price = price | money
  if discount_percent > 0
    assign formatted_discount_price = discount_price | money
    assign formatted_discount_amount = discount_amount | money
    assign mod = discount_amount | modulo: 1
    if mod == 0.5
      assign revised_discount_amount = discount_amount | minus: 1.0
      assign formatted_discount_amount = revised_discount_amount | money
    endif
  endif

  assign global_price_mod = price | modulo: 100
  assign global_discount_price_mod = global_discount_price | modulo: 100
  if price > 100000 and global_price_mod == 0.0 and global_discount_price_mod == 0.0
    assign global_formatted_discount_price = global_discount_price | money_without_trailing_zeros
    assign global_formatted_price = price | money_without_trailing_zeros
    assign global_formatted_discount_amount = global_discount_amount | money_without_trailing_zeros
  endif
-%}

{%- unless shop.money_format contains 'money' or shop.money_format contains '.' -%}
  {%- if settings.superscript_decimals -%}
    {%- if shop.money_format contains '{{amount}}' or shop.money_format contains '{{ amount }}' -%}
      {% capture formatted_price %}{{ formatted_price | replace: '.','<sup>' }}</sup>{% endcapture %}
    {%- elsif shop.money_format contains '{{amount_with_comma_separator}}' or shop.money_format contains '{{
      amount_with_comma_separator }}' -%}
      {% capture formatted_price %}{{ formatted_price | replace: ',','<sup>' }}</sup>{% endcapture %}
    {%- endif -%}
  {%- endif -%}
{%- endunless -%}

{% if product.metafields.external_product.hide_pricing == true %}
  <span class="product-price">{{ product.metafields.external_product.price_text }}</span>
{% elsif display_basic %}
  <span aria-hidden="true">{{ formatted_price }}</span>
  <span class="visually-hidden">{{ price | money }}</span>
{% elsif display_unified %}
  {% if from and list_view and price < 100000 %}
    <span aria-hidden="true" class="grid-product__price--from" style="display: none;"><span>from </span></span>
  {% endif %}
  <span class="product-price"
    data-regular-price="{{ price }}"
    data-global-discount-percent="{{ global_discount_percent }}"
    data-global-discount="{{ global_discount_amount }}"
    data-global-discount-price="{{ global_discount_price }}"
  >
    {% if list_view %}
      {% if price > 100000 %}
        {%- liquid
          if price_max
            assign members_save_value =  price_max | times: global_discount_percent | divided_by: 100
          else
            assign members_save_value =  price | times: global_discount_percent | divided_by: 100
          endif
          assign members_save_mod = members_save_value | modulo: 100
          if members_save_mod == 0.0 and members_save_value > 100000
            assign members_save_formatted = members_save_value | money_without_trailing_zeros
          else
            assign members_save_formatted = members_save_value | money
          endif
        -%}
        Gaia{%- if is_gaia_plus %}+ {%  endif %} Members save {%- if price_max and price_max != price %} {% endif %} {{ members_save_formatted }}
      {% else %}
      <span class="global-fm-price">   {% if from and list_view and price < 100000 %}
        <span aria-hidden="true" class="grid-product__price--from"><span>from </span></span>
      {% endif %} {{ global_formatted_price }}</span>
        {% if global_discount_percent > 0 %}
          <span class="gmembers"> Gaia{%- if is_gaia_plus %}+ {%  endif %} Members {{ global_formatted_discount_price }} </span>
        {% endif %}
      {% endif %}
    {% else %}
      Original: {{ global_formatted_price }} {{ product.metafields.custom.price_suffix }}
      {% if global_discount_percent > 0 %}
        <br />Gaia{%- if is_gaia_plus %}+ {%  endif %} Members: {{ global_formatted_discount_price }} (Save {{ global_formatted_discount_amount }})
      {% endif %}
    {% endif %}
  </span>
{% else %}
  {% if discount_percent > 0 %}
    {% comment %} if you change this be sure to check theme.js and custom.js for references {% endcomment %}
    <span class="data-discounted-product-price">
      <span aria-hidden="true" data-price="{{ price }}" class="psONPrice">
        <div class="gaia-discount-price">{{ formatted_discount_price }}</div>
        <div class="line-through-discount-price">{{ formatted_price }}</div>
        <span class="discount-text-item"
          data-discount-percent="{{ discount_percent }}"
          data-discount-price="{{ discount_price }}"
          data-discount="{{ discount_amount }}"
        >Gaia{%- if is_gaia_plus %}+ {%  endif %} Members Save {{ formatted_discount_amount }}</span>
      </span>
  {% else %}
    <span class="discount-text-item no-discount"
      data-discount-price="{{ discount_price }}"
      data-discount="{{ discount_amount }}"
      data-global-discount="{{ global_discount_amount }}"
      data-global-discount-percent="{{ global_discount_percent }}"
      data-global-discount-price="{{ global_discount_price }}"
      aria-hidden="true"
    >{{ formatted_price }}</span>
    <span class="visually-hidden">{{ price | money }}</span>
  {% endif %}
{% endif %}

<style>
  .template-cart #CartPageForm .cart__item-sub div[data-subtotal] div span>span {
    display: none;
  }

  .template-cart #CartPageForm .cart__item-sub div[data-subtotal] div span>div {
    text-decoration: none !important;
  }
</style>