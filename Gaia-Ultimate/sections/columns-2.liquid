{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} .index-section {
  {% if section.settings.background_image != blank %}
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    {% if section.settings.top_padding == true %}
    padding-top: var(--indexSectionPadding);
    {% endif %}
    {% if section.settings.bottom_padding == true %}
    padding-bottom: var(--indexSectionPadding);
    {% endif %} 
  {% endif %}
  {% if section.settings.top_padding == false %}
    padding-top: 0 !important;
    {%- if section.settings.color_scheme != blank -%}
    margin-top: 0 !important;
    {%- endif -%}
  {% endif %}
  {% if section.settings.bottom_padding == false %}
    padding-bottom: 0 !important;
    {%- if section.settings.color_scheme != blank -%}
    margin-bottom: 0 !important;
    {%- endif -%}
  {% endif %}
  }
{% endstyle %}

<div class="index-section {% if section.settings.background_image != blank %}index-bg{% endif %} color-scheme-{{ section.settings.color_scheme }} {% if section.settings.show_wave %}background-svg--wave{% endif %}"
     {% if section.settings.background_image != blank %}style="background-image: url({{ section.settings.background_image | image_url: width: img_width, height: img_height, format: format }}{% endif %}">
  {%- if section.settings.color_scheme != 'none' -%}
    {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme -%}
  {%- endif -%}

  <div class="page-width">
    {%- unless section.settings.title == blank -%}
      <h2 class="{{ section.settings.heading_size }} text-{{ section.settings.align_heading }}">{{ section.settings.title | newline_to_br }}</h2>
    {%- endunless -%}
    {%- if section.settings.subheading -%}
      {%- unless section.settings.subheading == blank -%}
        <p class="text-{{ section.settings.align_heading }}">{{ section.settings.subheading | escape }}</p>
      {%- endunless -%}
    {%- endif -%}

    <div class="grid">
      <div class="grid__item medium-up--one-half text-{{ section.settings.column_left_align_text }}">
        {%- for block in section.blocks -%}
          {% if block.settings.parent_column == "left" %}
          <div class="theme-block {{ block.type }}-block {% if block.type == 'sales_point' or block.type ==  'heading' %}rte no-margin{% endif %}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2 class="{{ block.settings.heading_size }}">{{ block.settings.title | escape }}</h2>
              {%- when 'page' -%}
                <div class="rte">
                  {%- if block.settings.page_text != blank -%}
                    {{ pages[block.settings.page_text].content }}
                  {%- else -%}
                    {{ 'home_page.onboarding.no_content' | t }}
                  {%- endif -%}
                </div>
              {%- when 'text' -%}
                <div class="rte">
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
                    {{ block.settings.text }}
                    {%- if block.settings.enlarge_text %}</div>{% endif -%}
                  {%- else -%}
                    {{ 'home_page.onboarding.no_content' | t }}
                  {%- endif -%}
                </div>
              {%- when 'sales_point' -%}
                <ul class="sales-points">
                  <li class="sales-point">
                    <span class="icon-and-text">
                      {% case block.settings.icon %}
                        {% when 'checkmark-no-circle' %}<svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-no-circle-checkmark" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000000;stroke-width:2;}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M14,37.2l8.5,8.5L50,18.2"/></svg>
                        {% when 'checkmark' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-circle-checkmark" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M52.68 24.48A22 22 0 1 1 47 15.93M21 32l8.5 8.5L57 13"/></svg>
                        {% when 'gift' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-gift" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M9 20.23h46v8.68H9zM13.34 28.91h36.89v24.3H13.34zM27.82 20.66v32.98M35.91 20.88v32.98M20.52 11.43a3.73 3.73 0 0 0-.74 2.87 4.57 4.57 0 0 0 .8 2.27C22 18.09 25.15 20 32 20.23a12 12 0 0 0-2.43-7 7.52 7.52 0 0 0-5.66-3.12 4 4 0 0 0-3.39 1.32z"/><path color="{{ block.settings.icon_color }}" class="a" d="M43.37 11.43a3.73 3.73 0 0 1 .74 2.87 4.48 4.48 0 0 1-.8 2.27c-1.42 1.52-4.57 3.41-11.42 3.66a12.08 12.08 0 0 1 2.43-7A7.56 7.56 0 0 1 40 10.14a4 4 0 0 1 3.37 1.29z"/></svg>
                        {% when 'globe' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-globe" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><circle color="{{ block.settings.icon_color }}" class="a" cx="32" cy="32" r="22"/><path color="{{ block.settings.icon_color }}" class="a" d="M13 21h38M10 32h44M13 43h38M32 10c-12 8-12 37 0 44M32 10c12 8 12 37 0 44"/></svg>
                        {% when 'heart' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-heart" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M51.27 15.05a13 13 0 0 0-18.44 0l-.83.83-.83-.83a13 13 0 0 0-18.44 18.44l.83.83L32 52.77l18.44-18.45.83-.83a13 13 0 0 0 0-18.44z"/></svg>
                        {% when 'leaf' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-leaf" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M52 11L13 50M35 13v15h16"/><path color="{{ block.settings.icon_color }}" class="a" d="M52 11c6 24-16.72 47.29-33 32C7 22 29 10 52 11z"/></svg>
                        {% when 'lock' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-lock" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M19.45 23.6v-3.2c0-7 5.89-11.75 12.55-11.75 7.21 0 12.55 5.49 12.55 11.75v3.2M10 23.6h44v31.75H10zM32 37.47v7.47"/><circle color="{{ block.settings.icon_color }}" class="a" cx="32" cy="35.87" r="1.6"/></svg>
                        {% when 'package' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-package" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M32 54.52L10 41.95v-19.9L32 9.48l22 12.57v19.9L32 54.52z"/><path color="{{ block.settings.icon_color }}" class="a" d="M32 54.52v-19.9l22-12.57M32 34.62L10 22.05M41.7 15.02L21 28.33v8.38"/></svg>
                        {% when 'phone' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-phone" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M18.4 9.65l10.2 10.2-6.32 6.32c2.1 7 6.89 12.46 15.55 15.55l6.32-6.32 10.2 10.2-8.75 8.75C25.71 50.3 13.83 38.21 9.65 18.4z"/></svg>
                        {% when 'ribbon' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-ribbon" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M28.57 42.31l-8.36 13.07-2.6-7.17-7.61.65 8.35-13.07a17.05 17.05 0 0 0 8.12 5.94 17.3 17.3 0 0 0 1.74.5zM54 48.86l-7.61-.65-2.61 7.17-8.36-13.07.37-.08a16.4 16.4 0 0 0 1.73-.5 17 17 0 0 0 8.12-5.93z"/><path color="{{ block.settings.icon_color }}" class="a" d="M49 25.64a16.79 16.79 0 0 1-3.14 9.85 3.55 3.55 0 0 1-.23.31 17 17 0 0 1-8.12 5.93 16.4 16.4 0 0 1-1.73.5l-.37.08a16.74 16.74 0 0 1-3.42.35 16.91 16.91 0 0 1-3.43-.35l-.36-.08a17.3 17.3 0 0 1-1.74-.5 17.05 17.05 0 0 1-8.12-5.94c-.07-.09-.15-.19-.22-.3A16.86 16.86 0 0 1 15 25.64a17 17 0 0 1 34 0z"/><path color="{{ block.settings.icon_color }}" class="a" d="M36.09 27.78l.96 5.63L32 30.75l-5.05 2.66.96-5.63-4.09-3.98 5.65-.82L32 17.86l2.53 5.12 5.64.82-4.08 3.98z"/></svg>
                        {% when 'shield' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-shield" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M21.18 31.69L28.54 39l15.91-15.88"/><path color="{{ block.settings.icon_color }}" class="a" d="M53 12.54v15.24a31.41 31.41 0 0 1-3.7 14.95A25.46 25.46 0 0 1 32 56a25.46 25.46 0 0 1-17.3-13.27A31.41 31.41 0 0 1 11 27.78V12.54C24.88 13.67 32 8 32 8s7.12 5.67 21 4.54z"/></svg>
                        {% when 'tag' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-tag" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M46.69 10.34l-10.55.07-25.8 25.8 17.45 17.45 25.8-25.8.07-10.55-6.97-6.97z"/><circle color="{{ block.settings.icon_color }}" class="a" cx="43.95" cy="20.05" r="3.53"/><path color="{{ block.settings.icon_color }}" class="a" d="M14.4 32.15L31.85 49.6"/></svg>
                        {% when 'truck' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-truck" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M16.5 43.22H6.88V16.5h33.14v26.72H23.94M45.42 43.22h-5.4V30.4h17.1v12.82h-4.23M57.12 30.4l-6.41-8.56H40.02"/><circle color="{{ block.settings.icon_color }}" class="a" cx="20.24" cy="43.76" r="3.74"/><path color="{{ block.settings.icon_color }}" class="a" d="M45.42 43.23a3.82 3.82 0 1 1 0 .37v-.37"/></svg>
                      {% endcase %}
                      <span>{{ block.settings.text }}</span>
                    </span>
                  </li>
                </ul>
              {%- when 'liquid' -%}
                {%- if block.settings.code != blank -%}
                  <div class="rte">
                    {{ block.settings.code }}
                  </div>
                {%- else -%}
                  <div class="rte">
                    {{ 'home_page.onboarding.no_content' | t }}
                  </div>
                {%- endif -%}
              {%- when 'button' -%}
                {%- liquid
                  assign link = block.settings.link
                  assign link_text = block.settings.link_text
                  for customer_entitlement_string in customer.tags
                    if customer_entitlement_string == '253' or customer_entitlement_string == '280' or customer_entitlement_string == '290'
                      assign link = block.settings.link_entitled
                      if block.settings.link_text_entitled != blank
                        assign link_text = block.settings.link_text_entitled
                      endif
                    endif
                  endfor
                -%}
                <div class="rte text-{{ block.settings.align_button }}">
                  <a href="{{ link }}" class="btn">
                    {{ link_text }}
                  </a>
                </div>
              {%- when 'video' -%}
                <div class="video-row feature-row--{{ block.settings.video_width }}">
                  <div class="video-wrapper">
                    {%- if block.settings.video_url == blank -%}
                      <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?rel=0&showinfo=0&vq=720" title="YouTube iframe"
                              width="850" height="480" frameborder="0" allowfullscreen></iframe>
                    {%- else -%}
                      {%- if block.settings.video_url.type == "youtube" -%}
                        <iframe src="//www.youtube.com/embed/{{ block.settings.video_url.id }}?rel=0&showinfo=0&vq=720"
                                title="YouTube iframe" width="850" height="480" frameborder="0" allowfullscreen></iframe>
                      {%- endif -%}
                      {%- if block.settings.video_url.type == "vimeo" -%}
                        <iframe src="//player.vimeo.com/video/{{ block.settings.video_url.id }}?color={{ settings.color_button | remove: "#" }}&byline=0&portrait=0&badge=0"
                                title="Vimeo iframe" width="850" height="480" frameborder="0" allowfullscreen></iframe>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- when 'video_mp4' -%}
                <div class="video-row feature-row--{{ block.settings.video_width }}">
                  <div class="video-wrapper">
                    {%- if block.settings.video_url == blank -%}
                      <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?rel=0&showinfo=0&vq=720" title="YouTube iframe"
                              width="850" height="480" frameborder="0" allowfullscreen></iframe>
                    {%- else -%}
                      {%- if block.settings.video_url contains '.mp4' or block.settings.video_url contains '.MP4' -%}
                        <video
                          id="Mp4Video-{{ block.id }}"
                          class="video-div"
                          data-type="mp4"
                          src="{{ block.settings.video_url }}"
                          {% if block.settings.controls %}controls{% endif %} {% if block.settings.loop %}loop{% endif %} {% if block.settings.autoplay %}muted playsinline autoplay{% endif %}></videoo>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- when 'dropdown' -%}
                {% render 'dropdown-with-image', block: block %}
              {%- when 'image' -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <div class="image-wrap
                              {% if block.settings.image_mask != 'none' %}svg-mask svg-mask--{{ block.settings.image_mask }}{% endif %}"
                              {% if block.settings.image != blank %}style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%;"{% endif %}>
                    {%- liquid
                      assign blockWidth = 100
                      if forloop.index == 1 and blockWidth >= 50
                        assign loading = block.settings.lazyload_images
                      else
                        assign loading = true
                      endif
                    -%}
                    {%- render 'image-element',
                      img: block.settings.image,
                      loading: loading,
                      sizeVariable: block.settings.width,
                      widths: '360, 540, 720, 900, 1080, 1600',
                    -%}
                  </div>
                {%- else -%}
                  <div class="image-wrap">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          </div>
          {% endif %}
        {%- endfor -%}
      </div>
      <div class="grid__item medium-up--one-half text-{{ section.settings.column_right_align_text }}">
        {%- for block in section.blocks -%}
          {% if block.settings.parent_column == "right" %}
          <div class="theme-block {{ block.type }}-block {% if block.type == 'sales_point' or block.type ==  'heading' %}rte no-margin{% endif %}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2 class="{{ block.settings.heading_size }}">{{ block.settings.title | escape }}</h2>
              {%- when 'page' -%}
                <div class="rte">
                  {%- if block.settings.page_text != blank -%}
                    {{ pages[block.settings.page_text].content }}
                  {%- else -%}
                    {{ 'home_page.onboarding.no_content' | t }}
                  {%- endif -%}
                </div>
              {%- when 'text' -%}
                <div class="rte">
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
                    {{ block.settings.text }}
                    {%- if block.settings.enlarge_text %}</div>{% endif -%}
                  {%- else -%}
                    {{ 'home_page.onboarding.no_content' | t }}
                  {%- endif -%}
                </div>
              {%- when 'sales_point' -%}
                <ul class="sales-points">
                  <li class="sales-point">
                    <span class="icon-and-text">
                      {% case block.settings.icon %}
                        {% when 'checkmark-no-circle' %}<svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-no-circle-checkmark" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000000;stroke-width:2;}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M14,37.2l8.5,8.5L50,18.2"/></svg>
                        {% when 'checkmark' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-circle-checkmark" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M52.68 24.48A22 22 0 1 1 47 15.93M21 32l8.5 8.5L57 13"/></svg>
                        {% when 'gift' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-gift" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M9 20.23h46v8.68H9zM13.34 28.91h36.89v24.3H13.34zM27.82 20.66v32.98M35.91 20.88v32.98M20.52 11.43a3.73 3.73 0 0 0-.74 2.87 4.57 4.57 0 0 0 .8 2.27C22 18.09 25.15 20 32 20.23a12 12 0 0 0-2.43-7 7.52 7.52 0 0 0-5.66-3.12 4 4 0 0 0-3.39 1.32z"/><path color="{{ block.settings.icon_color }}" class="a" d="M43.37 11.43a3.73 3.73 0 0 1 .74 2.87 4.48 4.48 0 0 1-.8 2.27c-1.42 1.52-4.57 3.41-11.42 3.66a12.08 12.08 0 0 1 2.43-7A7.56 7.56 0 0 1 40 10.14a4 4 0 0 1 3.37 1.29z"/></svg>
                        {% when 'globe' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-globe" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><circle color="{{ block.settings.icon_color }}" class="a" cx="32" cy="32" r="22"/><path color="{{ block.settings.icon_color }}" class="a" d="M13 21h38M10 32h44M13 43h38M32 10c-12 8-12 37 0 44M32 10c12 8 12 37 0 44"/></svg>
                        {% when 'heart' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-heart" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M51.27 15.05a13 13 0 0 0-18.44 0l-.83.83-.83-.83a13 13 0 0 0-18.44 18.44l.83.83L32 52.77l18.44-18.45.83-.83a13 13 0 0 0 0-18.44z"/></svg>
                        {% when 'leaf' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-leaf" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M52 11L13 50M35 13v15h16"/><path color="{{ block.settings.icon_color }}" class="a" d="M52 11c6 24-16.72 47.29-33 32C7 22 29 10 52 11z"/></svg>
                        {% when 'lock' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-lock" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M19.45 23.6v-3.2c0-7 5.89-11.75 12.55-11.75 7.21 0 12.55 5.49 12.55 11.75v3.2M10 23.6h44v31.75H10zM32 37.47v7.47"/><circle color="{{ block.settings.icon_color }}" class="a" cx="32" cy="35.87" r="1.6"/></svg>
                        {% when 'package' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-package" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M32 54.52L10 41.95v-19.9L32 9.48l22 12.57v19.9L32 54.52z"/><path color="{{ block.settings.icon_color }}" class="a" d="M32 54.52v-19.9l22-12.57M32 34.62L10 22.05M41.7 15.02L21 28.33v8.38"/></svg>
                        {% when 'phone' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-phone" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M18.4 9.65l10.2 10.2-6.32 6.32c2.1 7 6.89 12.46 15.55 15.55l6.32-6.32 10.2 10.2-8.75 8.75C25.71 50.3 13.83 38.21 9.65 18.4z"/></svg>
                        {% when 'ribbon' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-ribbon" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M28.57 42.31l-8.36 13.07-2.6-7.17-7.61.65 8.35-13.07a17.05 17.05 0 0 0 8.12 5.94 17.3 17.3 0 0 0 1.74.5zM54 48.86l-7.61-.65-2.61 7.17-8.36-13.07.37-.08a16.4 16.4 0 0 0 1.73-.5 17 17 0 0 0 8.12-5.93z"/><path color="{{ block.settings.icon_color }}" class="a" d="M49 25.64a16.79 16.79 0 0 1-3.14 9.85 3.55 3.55 0 0 1-.23.31 17 17 0 0 1-8.12 5.93 16.4 16.4 0 0 1-1.73.5l-.37.08a16.74 16.74 0 0 1-3.42.35 16.91 16.91 0 0 1-3.43-.35l-.36-.08a17.3 17.3 0 0 1-1.74-.5 17.05 17.05 0 0 1-8.12-5.94c-.07-.09-.15-.19-.22-.3A16.86 16.86 0 0 1 15 25.64a17 17 0 0 1 34 0z"/><path color="{{ block.settings.icon_color }}" class="a" d="M36.09 27.78l.96 5.63L32 30.75l-5.05 2.66.96-5.63-4.09-3.98 5.65-.82L32 17.86l2.53 5.12 5.64.82-4.08 3.98z"/></svg>
                        {% when 'shield' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-shield" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M21.18 31.69L28.54 39l15.91-15.88"/><path color="{{ block.settings.icon_color }}" class="a" d="M53 12.54v15.24a31.41 31.41 0 0 1-3.7 14.95A25.46 25.46 0 0 1 32 56a25.46 25.46 0 0 1-17.3-13.27A31.41 31.41 0 0 1 11 27.78V12.54C24.88 13.67 32 8 32 8s7.12 5.67 21 4.54z"/></svg>
                        {% when 'tag' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-tag" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M46.69 10.34l-10.55.07-25.8 25.8 17.45 17.45 25.8-25.8.07-10.55-6.97-6.97z"/><circle color="{{ block.settings.icon_color }}" class="a" cx="43.95" cy="20.05" r="3.53"/><path color="{{ block.settings.icon_color }}" class="a" d="M14.4 32.15L31.85 49.6"/></svg>
                        {% when 'truck' %} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-truck" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path color="{{ block.settings.icon_color }}" class="a" d="M16.5 43.22H6.88V16.5h33.14v26.72H23.94M45.42 43.22h-5.4V30.4h17.1v12.82h-4.23M57.12 30.4l-6.41-8.56H40.02"/><circle color="{{ block.settings.icon_color }}" class="a" cx="20.24" cy="43.76" r="3.74"/><path color="{{ block.settings.icon_color }}" class="a" d="M45.42 43.23a3.82 3.82 0 1 1 0 .37v-.37"/></svg>
                      {% endcase %}
                      <span>{{ block.settings.text }}</span>
                    </span>
                  </li>
                </ul>
              {%- when 'liquid' -%}
                {%- if block.settings.code != blank -%}
                  <div class="rte">
                    {{ block.settings.code }}
                  </div>
                {%- else -%}
                  <div class="rte">
                    {{ 'home_page.onboarding.no_content' | t }}
                  </div>
                {%- endif -%}
              {%- when 'button' -%}
                {%- liquid
                  assign link = block.settings.link
                  assign link_text = block.settings.link_text
                  for customer_entitlement_string in customer.tags
                    if customer_entitlement_string == '253' or customer_entitlement_string == '280' or customer_entitlement_string == '290'
                      assign link = block.settings.link_entitled
                      if block.settings.link_text_entitled != blank
                        assign link_text = block.settings.link_text_entitled
                      endif
                    endif
                  endfor
                -%}
                <div class="rte text-{{ block.settings.align_button }}">
                  <a href="{{ link }}" class="btn">
                    {{ link_text }}
                  </a>
                </div>
              {%- when 'video' -%}
                <div class="video-row feature-row--{{ block.settings.video_width }}">
                  <div class="video-wrapper">
                    {%- if block.settings.video_url == blank -%}
                      <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?rel=0&showinfo=0&vq=720" title="YouTube iframe"
                              width="850" height="480" frameborder="0" allowfullscreen></iframe>
                    {%- else -%}
                      {%- if block.settings.video_url.type == "youtube" -%}
                        <iframe src="//www.youtube.com/embed/{{ block.settings.video_url.id }}?rel=0&showinfo=0&vq=720"
                                title="YouTube iframe" width="850" height="480" frameborder="0" allowfullscreen></iframe>
                      {%- endif -%}
                      {%- if block.settings.video_url.type == "vimeo" -%}
                        <iframe src="//player.vimeo.com/video/{{ block.settings.video_url.id }}?color={{ settings.color_button | remove: "#" }}&byline=0&portrait=0&badge=0"
                                title="Vimeo iframe" width="850" height="480" frameborder="0" allowfullscreen></iframe>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- when 'video_mp4' -%}
                <div class="video-row feature-row--{{ block.settings.video_width }}">
                  <div class="video-wrapper">
                    {%- if block.settings.video_url == blank -%}
                      <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?rel=0&showinfo=0&vq=720" title="YouTube iframe"
                              width="850" height="480" frameborder="0" allowfullscreen></iframe>
                    {%- else -%}
                      {%- if block.settings.video_url contains '.mp4' or block.settings.video_url contains '.MP4' -%}
                        <video
                          id="Mp4Video-{{ block.id }}"
                          class="video-div"
                          data-type="mp4"
                          src="{{ block.settings.video_url }}"
                          {% if block.settings.controls %}controls{% endif %} {% if block.settings.loop %}loop{% endif %} {% if block.settings.autoplay %}muted playsinline autoplay{% endif %}></videoo>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
{%- when 'dropdown_video' -%}
  <div class="dropdown-with-image-block text-spacing" {{ block.shopify_attributes }} style="background: {{ block.settings.background_color | default: "#fff" }}; color: {{ block.settings.text_color | default: "inherit" }}">
    <div class="grid">
      {%- if block.settings.image != blank -%}
        <div class="grid__item medium-up--one-third" {{ block.shopify_attributes }}>
          <div class="image-wrap" style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%;">
            {%- liquid
              assign blockWidth = block.settings.width | remove: '%' | times: 1
              if forloop.index == 1 and blockWidth >= 50
                assign loading = block.settings.lazyload_images
              else
                assign loading = true
              endif
            -%}
            {%- render 'image-element',
              img: block.settings.image,
              loading: loading,
              sizeVariable: block.settings.width,
              widths: '360, 540, 720, 900, 1080, 1600',
            -%}
          </div>
        </div>
      {%- endif -%}
      <div class="grid__item {% if block.settings.image != blank %}medium-up--two-thirds{% else %}one-whole{% endif %}" {{ block.shopify_attributes }}>
        <button type="button" class="label dropdown-content-trigger collapsible-trigger collapsible-trigger-btn no-border" {% if block.settings.dropdown_text == blank %}style="cursor: default;"{% endif %} aria-controls="dropdown-content-{{ block.id }}" dropdown-expanded={{ block.settings.reveal }}>
          <span class="collapsible-trigger__layout">
            <span>
              <span>{{ block.settings.title }}</span>
            </span>
            {% if block.settings.dropdown_text != blank or block.settings.dropdown_image != blank %}
              {%- render 'collapsible-icons' -%}
            {% endif %}
          </span>
          <div class="rte">
            {{ block.settings.text }}
          </div>
        </button>
        {% if block.settings.dropdown_text != blank %}
        <div id="dropdown-content-{{ block.id }}" class="collapsible-content collapsible-content--all no-border">
          <div class="collapsible-content__inner rte">
            {{ block.settings.dropdown_text }}
            {%- if block.settings.dropdown_video != blank -%}
              <div class="video-row feature-row--{{ block.settings.videodrop_width }}">
                <div class="video-wrapper">
                  {%- if block.settings.videodropvideo_url == blank -%}
                    <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?rel=0&showinfo=0&vq=720" title="YouTube iframe" width="850" height="480" frameborder="0" allowfullscreen></iframe>
                  {%- else -%}
                    {%- if block.settings.videodropvideo_url contains '.mp4' or block.settings.videodropvideo_url contains '.MP4' -%}
                      <video id="Mp4Video-{{ block.id }}" class="video-div" data-type="mp4" src="{{ block.settings.videodropvideo_url }}" {% if block.settings.videodropcontrols %}controls{% endif %} {% if block.settings.videodroploop %}loop{% endif %} {% if block.settings.videodropautoplay %}muted playsinline autoplay{% endif %}></video>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
              {%- when 'dropdown' -%}
                <div class="dropdown-with-image-block text-spacing" {{ block.shopify_attributes }} style="background: {{ block.settings.background_color | default: "#fff" }}; color: {{ block.settings.text_color | default: "inherit" }}">
                  <div class="grid">
                    {%- if block.settings.image != blank -%}
                    <div class="grid__item medium-up--one-third" {{ block.shopify_attributes }}>
                      <div class="image-wrap" style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%;">
                        {%- liquid
                          assign blockWidth = block.settings.width | remove: '%' | times: 1
                          if forloop.index == 1 and blockWidth >= 50
                            assign loading = block.settings.lazyload_images
                          else
                            assign loading = true
                          endif
                        -%}
                        {%- render 'image-element',
                          img: block.settings.image,
                          loading: loading,
                          sizeVariable: block.settings.width,
                          widths: '360, 540, 720, 900, 1080, 1600',
                        -%}
                      </div>
                    </div>
                    {%- endif -%}
                    <div class="grid__item {% if block.settings.image != blank %}medium-up--two-thirds{% else %}one-whole{% endif %}" {{ block.shopify_attributes }}>
                      <button type="button"
                              class="label dropdown-content-trigger collapsible-trigger collapsible-trigger-btn no-border"
                              {% if block.settings.dropdown_text == blank %}
                              style="cursor: default;"
                              {% endif %}
                              aria-controls="dropdown-content-{{ block.id }}"
                              dropdown-expanded={{ block.settings.reveal }}>
                        <span class="collapsible-trigger__layout">
                          <span>
                            <span>{{ block.settings.title }}</span>
                          </span>
                          {% if block.settings.dropdown_text != blank or block.settings.dropdown_image != blank %}
                            {%- render 'collapsible-icons' -%}
                          {% endif %}
                        </span>
                        <div class="rte">
                          {{ block.settings.text }}
                        </div>
                      </button>
                      {% if block.settings.dropdown_text != blank %}
                      <div id="dropdown-content-{{ block.id }}" class="collapsible-content collapsible-content--all no-border">
                        <div class="collapsible-content__inner rte">
                          {{ block.settings.dropdown_text }}
                          {%- if block.settings.dropdown_image != blank -%}
                            <div class="image-wrap" style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.dropdown_image.aspect_ratio }}%;">
                              {%- liquid
                                assign blockWidth = block.settings.width | remove: '%' | times: 1
                                if forloop.index == 1 and blockWidth >= 50
                                  assign loading = block.settings.lazyload_images
                                else
                                  assign loading = true
                                endif
                              -%}
                              {%- render 'image-element',
                                      img: block.settings.dropdown_image,
                                      loading: loading,
                                      sizeVariable: block.settings.width,
                                      widths: '360, 540, 720, 900, 1080, 1600',
                              -%}
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {%- when 'image' -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <div class="image-wrap
                              {% if block.settings.image_mask != 'none' %}svg-mask svg-mask--{{ block.settings.image_mask }}{% endif %}"
                              {% if block.settings.image != blank %}style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%;"{% endif %}>
                    {%- liquid
                      assign blockWidth = 100
                      if forloop.index == 1 and blockWidth >= 50
                        assign loading = block.settings.lazyload_images
                      else
                        assign loading = true
                      endif
                    -%}
                    {%- render 'image-element',
                      img: block.settings.image,
                      loading: loading,
                      sizeVariable: block.settings.width,
                      widths: '360, 540, 720, 900, 1080, 1600',
                    -%}
                  </div>
                {%- else -%}
                  <div class="image-wrap">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          </div>
          {% endif %}
        {%- endfor -%}
      </div>
    </div>

    {%- unless section.settings.cta_button == blank -%}
      {%- liquid
        assign link = section.settings.cta_button_url
        assign link_text = section.settings.cta_button
        for customer_entitlement_string in customer.tags
          if customer_entitlement_string == '253' or customer_entitlement_string == '280' or customer_entitlement_string == '290'
            assign link = section.settings.cta_button_url_entitled
            if section.settings.cta_button_entitled != blank
              assign link_text = section.settings.cta_button_entitled
            endif
          endif
        endfor
      -%}
      <div class="rte text-{{ section.settings.align_cta_button }} margin-top-same-as-theme-block">
        <a href="{{ link }}" class="btn">
          {{ link_text | escape }}
        </a>
      </div>
    {%- endunless -%}
  </div>

</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

