<div class="conscious-blocks-parent">
    <div class="conscious-block-holder" {% if section.settings.rm-bottom-padding == true  %} style="padding-bottom:unset;" {% endif %}>
      {%if section.settings.title != blank %}
        <h2 class="title-conscious-title">{{section.settings.title}}</h2>
      {%endif %}
        <div class="conscious-block-el">
            {% for block in section.blocks %}
                <div class="conscious-image">
                    <img class="cover-conscious-block" alt="{{block.settings.image.alt}}" src="{{block.settings.image |  img_url: 'master'}}" />
                    <div class="shadow-cover"></div>
                    <h4 class="title-conscious-in-block">{{block.settings.title}}</h4>
                </div> 
            {% endfor %}  
        </div>
    </div>
</div>
 
{% schema %}
    {
      "name": "Discover conscious Blocks",
      "class": "conscious-below-banner",
      "settings": [
    
      {
              "type": "text",
              "id": "title",
              "label": "Section Title"
            },
            {
  "type": "checkbox",
  "id": "rm-bottom-padding",
  "label": "Remove bottom padding",
  "default": true
}

       
      ],

      "blocks": [
        {
          "type": "section",
          "name": "section-block",
          "settings": [
            {
        "type": "image_picker",
        "id": "image",
        "label": "Image Cover"
        },
            {
              "type": "text",
              "id": "title",
              "label": "Experience Title"
            },
              
            {
            "type": "url",
            "id": "btn-link",
            "label": "Image Block link"
            } 
         
          ]
        }
      ],
      "presets": [
        {
          "name": "Discover conscious Blocks",
          "category": "Page Banners"
        }
      ]
    } 
  {% endschema %}  