<div class="events-hero--banner-parent">
    <div class="events-hero--banner-holder">
      <div class="splide-collection-slideshow" aria-label="Splide Basic HTML Example">
  <div class="splide__track">
		<ul class="splide__list">
      {% for  slidemeta in collection.metafields.hero-cover-subheading.key%}
<li class="splide__slide {% if collection.metafields.content-alignment.key == "center-right" %} center-right-flex-li  {% elsif  collection.metafields.content-alignment.key == "bottom-right" %} bottom-right-flex-li {% endif %}" >
      {% if collection.metafields.hero-cover-image-or-video.key[forloop.index0] != blank %}
            {% if collection.metafields.hero-cover-image.key[forloop.index0] != blank %}
              <img alt="{{section.settings.image.alt}}" width="1500" height="500" loading="lazy" class="image-cover-absolute-event-banner" src="{{ collection.metafields.hero-cover-image.key[forloop.index0] }}"/>
              {% else  %}
              <video class="video-cover-in-banner" muted playsinline loop autoplay  width='100%' height='100%' src='{{ collection.metafields.hero-cover-video.key[forloop.index0] }}' type='video/mp4'></video>
            {% endif %}
      {% else %}
            {% if section.settings.image-video == "image" %}
              {%- if section.settings.image != blank -%}
              <img alt="{{section.settings.image.alt}}" width="1500" height="500" loading="lazy" class="image-cover-absolute-event-banner" src="{{section.settings.image | img_url: 'master'}}"/>
              {% else %}
              <img  src="{{ collection.image |  image_url: 'master'  }}"  width="1500" height="500" loading="lazy" class="image-cover-absolute-event-banner"/>
              {%- endif -%}
              {% else %}
              <video class="video-cover-in-banner" muted playsinline loop autoplay  width='100%' height='100%' src='{{ section.settings.v-link }}' type='video/mp4'></video>
            {% endif %}
        {% endif %}
        <div class="events-hero--banner-el 
        {% if collection.metafields.content-alignment.key == "center-left" %}
          center-left-flex
        {% elsif  collection.metafields.content-alignment.key == "center" %}
          center-flex
        {% elsif  collection.metafields.content-alignment.key == "center-right" %}
          center-right-flex
        {% elsif  collection.metafields.content-alignment.key == "bottom-left" %}
          bottom-left-flex
        {% elsif  collection.metafields.content-alignment.key == "bottom-right" %}
          bottom-right-flex
        {% else %}
          bottom-center-flex
        {% endif %}
        ">

          {% if slidemeta != blank %}
            <h3 class="event-banner-title-intro">{{ slidemeta }}</h3>
            {% else %}
            {% if section.settings.title-intro != blank %}
            <h3 class="event-banner-title-intro">{{section.settings.title-intro}}</h3>
            {% endif %}
          {% endif %}

            {% if collection.metafields.hero-cover-title.key[forloop.index0] != blank %}
              <h1 class="event-banner-title">{{ collection.metafields.hero-cover-title.key[forloop.index0] |  newline_to_br }}</h1>
              {% else %}
            {% if section.settings.title %}
            <h1 class="event-banner-title">{{section.settings.title |  newline_to_br }}</h1>
            {%endif %}
          {% endif %}
          {% if collection.metafields.hero-cover-paragraph.key[forloop.index0] != blank %}
            <p class="event-banner-body-text">{{ collection.metafields.hero-cover-paragraph.key[forloop.index0]}}</p>
            {% else %}
            {% if section.settings.body-text %}
            <p class="event-banner-body-text">{{section.settings.body-text}}</p>
            {% endif %}
          {% endif %}
        </div>  
        </li>
        {% endfor %}
        </ul>
        </div> 
      </div>
    </div>  
</div> 
<style>
  .events-hero--banner-el{
    position: relative;
    z-index: 2;
    min-height: {{collection.metafields.collection-cover-height.key}}px;
  }
  .bottom-center-flex {
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: center;
    padding-bottom: 55px;
}
.events-hero--banner-el.center-flex {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.center-left-flex {
    display: flex;
    justify-content: center;
    padding-left: 40px;
    flex-direction: column;
    text-align: left;
    align-items: start;
    max-width: 600px;
}
.center-left-flex h3{
  text-align: left;
}
.center-left-flex h1{
  text-align: left;
}
.center-right-flex-li{
    display: flex;
    align-items: end;
    justify-content: end;
}
.center-right-flex {
    align-items: end;
    padding-right: 40px;
    max-width: 560px;
    text-align: left;
    padding-bottom: unset;
    display: flex;
    flex-direction: column;
    align-items: start;
    text-align: left;
    justify-content: center;
}
.center-right-flex h1, h3{
  text-align: left;

}
.bottom-left-flex {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: end;
    padding-bottom: 55px;
    padding-left: 40px;
}
.bottom-left-flex h1, h3{
  text-align: left;

}

.bottom-right-flex {
  align-items: end;
    padding-right: 40px;
    padding-bottom: 55px;
    max-width: 560px;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: start;
    text-align: left;
    justify-content: end;
}
.bottom-right-flex h1, h3{
  text-align: left;
}
.bottom-right-flex-li {
    display: flex;
    align-items: end;
    justify-content: end;
}
.event-banner-title{
  font-size: {{collection.metafields.collection-heading-size.key}}px;
}

.events-hero--banner-holder .splide__slide:before {
    content: '';
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background: black;
    height: 100%;
    z-index: 1;
    opacity: .{{collection.metafields.background-overlay.key}};
}
.splide-collection-slideshow button.splide__pagination__page {
    display: inline-block;
    vertical-align: middle;
    width: 6px;
    height: 6px;
    margin: 0 5px;
    border-radius: 100%;
    cursor: pointer;
    background-color: currentColor;
    opacity: .2;
    background: white;
}
.splide-collection-slideshow button.splide__pagination__page.is-active {
    opacity: unset;
}

@media(max-width:768px){
  .events-hero--banner-el{
    min-height:  {{collection.metafields.collection-banner-mobile-height.key}}px;
        }
}
</style>
  <script>



var splide = new Splide('.splide-collection-slideshow', {
    perPage: 1,
    arrows: false,
    pagination: true,
    perMove: 1,
    type: 'fade',
    autoplay: 'pause',
    adaptiveHeight: true,
    rewind: true,
    drag: true,
    interval: 4000,
    speed: 2000,
    keyboard: true
  });

  splide.mount();




  </script>
{% schema %}
    {
      "name": "Custom Events Banner",
      "class": "hero-event-banner",
      "settings": [
        {
  "type": "radio",
  "id": "image-video",
  "label": "Image or Video ",
  "options": [
    {
      "value": "image",
      "label": "Image"
    },
    {
      "value": "video",
      "label": "Video"
    }
  ],
  "default": "image"
},
{
  "type": "url",
  "id": "v-link",
  "label": "Video Url link"
},
        {
        "type": "image_picker",
        "id": "image",
        "label": "Image Cover"
        },
        {
          "type": "text",
          "id": "title-intro",
          "label": "Title Intro",
          "default": "Hand-Curated Experiences"
        },
       {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "default": "Explore your spirituality"
        },
        {
          "type": "textarea",
          "id": "body-text",
          "label": "Body Text Below Title",
          "default": "Retreats, tours, and third-party events hosted by Gaia talent and hand-selected Gaia partners."
        }
      ],
      "presets": [
        {
          "name": "Custom Events Banner",
          "category": "Page Banners"
        }
      ]
    } 
  {% endschema %}  