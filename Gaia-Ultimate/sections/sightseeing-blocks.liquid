<div class="sightseeing-block-parent">
<div class="sightseeing-block-holder">
  {% if product.metafields.sec-icon-title.key != blank %}
    <h2 class="IconicTitle">
        {{ product.metafields.sec-icon-title.key }}
    </h2>
  {% endif %}
    {% comment %} 
      {%if product.metafields.icon-title-desktop.key != blank %}
           <div class="main-block mainTitle fullCapacity-modules fulCap-Desktop">
            {{product.metafields.icon-title-desktop.key}}
           </div>
      {% endif %}

         {%if product.metafields.icon-title-mobile.key != blank %}
            <div class="main-block mainTitle fullCapacity-modules fulCap-Mobile">
              {{ product.metafields.icon-title-mobile.key }}
              </div>
          {% endif %}
      {% endcomment %}

    <div class="sightseeing-block-el">
        {% for sight in  product.metafields.experience-image.key %}
        <div class="sightSeeing-block-item {% if forloop.index > 1 %} available-for-expand goes-hidden-on-mobile {% endif %}">
        <div class="sightseeing-image">
        <img loading="eager" alt="{{ sight.alt }}" class="sighseeingImageKey" src="{{ sight }}" />
        </div>
        <div class="sightseeing-info-key tab-type-{{forloop.index}}">
          {% if product.metafields.sightseeing-type.key[forloop.index0] != blank %}
        <h3 class="sightseeingInfoTitle">
        {{ product.metafields.sightseeing-type.key[forloop.index0] }}
          {% if forloop.index > 1 %} <span class="plOpenAccordionPdpInfo">+</span> {%endif %}
            </h3>
          {% endif %}
          {% comment %}
            <div class="fullCapacity-modules fulCap-Desktop">
            {% if product.metafields.sight-title.key[forloop.index0] != blank %}   {{product.metafields.sight-title.key[forloop.index0]}}
            {% if forloop.index > 1 %} <span class="plOpenAccordionPdpInfo">+</span> {%endif%} {% endif %}
            </div>

            <div class="fullCapacity-modules fulCap-Mobile">
              {% if product.metafields.sight-title-m.key[forloop.index0] != blank %}   {{product.metafields.sight-title-m.key[forloop.index0]}}
              {% if forloop.index > 1 %} <span class="plOpenAccordionPdpInfo">+</span> {%endif%} {% endif %}
              </div>
              {% endcomment %}
            <p class="sightseeingInfoBody">
              {% if product.metafields.sightseeing-type.info[forloop.index0] != blank %}
              {{ product.metafields.sightseeing-type.info[forloop.index0] }}
              {% endif %}
              </p>
              <div class="fullCapacity-modules fulCap-Desktop">
                {% if  product.metafields.sight-inf.key-full[forloop.index0] != blank %}
                  {{product.metafields.sight-inf.key-full[forloop.index0]}}
                {% endif %}
              </div>
              <div class="fullCapacity-modules fulCap-Mobile keepHiddenonMobile">
                {% if  product.metafields.sight-inf-m.key-full[forloop.index0] != blank %}
                  {{product.metafields.sight-inf-m.key-full[forloop.index0]}}
                {% endif %}
              </div>
        </div>
        </div>
        {% endfor %}
    </div>
</div>
</div>
<script>
$(".available-for-expand").click(function(){
  $(this).toggleClass("goes-hidden-on-mobile");
  $(this).children(".sightseeing-info-key").children("h3").children("span").toggleClass("transformRotatePlus");
})
</script>


{% schema %}
    {
      "name": "Sightseeing Block",
      "class": "book-with-confidence",
      "settings": [

      
       {
          "type": "text",
          "id": "title",
          "label": "Book With Confidence Section title",
          "default": "Book With Confidence"
        }
       
      ],
      "presets": [
        {
            "name": "Sightseeing Block",
            "category": "Product Page Widgets"
        }
      ]
    } 
  {% endschema %}  