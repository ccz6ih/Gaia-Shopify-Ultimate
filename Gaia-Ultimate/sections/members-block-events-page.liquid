<div {%if collection.metafields.hide-sec-rev.key == true %}style="display:none;"{% endif %} class="members-events-block-parent {% if section.settings.add-top-padding == true %} ad-top-p {% endif %} {% if section.settings.add-bottom-padding == true %} add-bot-p {% endif %}" >
    <div class="members-events-block-holder">
        <div class="members-events-block-el">
            <h4 class="mem-events-title">{{section.settings.title}}</h4>
            <a class="buttonlink-href" href="{{section.settings.btn-link}}">{{section.settings.btn-text}}</a>
        </div>
    </div>
 
</div>  
 <style>
  .ad-top-p{
    margin-top: var(--indexSectionPadding);
  }
  .add-bot-p{
    margin-bottom: var(--indexSectionPadding);

  }
 </style>

{% schema %}
    {
      "name": "Members Block Events",
      "class": "members-block-event-banner",
      "settings": [
        {
  "type": "checkbox",
  "id": "add-top-padding",
  "label": "Top Padding",
  "default": false
},
{
  "type": "checkbox",
  "id": "add-bottom-padding",
  "label": "Bottom Padding",
  "default": false
},
      
       {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Members Enjoy 10% Off Gaia members get 10% off all marketplace items."
        },  
        {
          "type": "text",
          "id": "btn-text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
            "type": "url",
            "id": "btn-link",
            "label": "Button link"
        }
      ],
      "presets": [
        {
          "name": "Members Block Events",
          "category": "Page Banners"
        }
      ]
    } 
  {% endschema %}  