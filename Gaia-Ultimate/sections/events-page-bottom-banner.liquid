{% if collection.title == "Hand-Curated Experiences" %}

<div class="events-banner-bottom-parent">
    <div class="events-banner-bottom-holder">
        <img class="background-image-cover-bottom-holder-banner" src="{{section.settings.image | img_url: 'master' }}"/>
        <div class="events-banner-bottom-el">
            <div class="text-block-in-banner">
                <h2 class="title-in-bottom-banner">{{section.settings.title}}</h2>
                <p class="body-text-in-bottom-banner">{{section.settings.body-text}}</p>
                <a class="button-bottom-banner" href="{{section.settings.btn-link}}">{{section.settings.btn-text}}</a>
            </div>
        </div>
    </div>
</div>
{%endif%}
{% schema %} 
    {
      "name": "Events Banner Bottom",
      "class": "bottom-event-banner", 
      "settings": [
        {
        "type": "image_picker",
        "id": "image",
        "label": "Image Cover"
        },
     
       {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lorem ipsum"
        },
        {
          "type": "textarea",
          "id": "body-text",
          "label": "Body Text Below Title",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod."
        },
        {
          "type": "text",
          "id": "btn-text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
            "type": "url",
            "id": "btn-link",
            "label": "Button link"
            }

      ],
      "presets": [
        {
          "name": "Events Banner Bottom",
          "category": "Page Banners"
        }
      ]
    } 
  {% endschema %}  