
{% if collection.title != "Hand-Curated Experiences" %}
<div class="events-page-hero-banner-bottom-parent">
    <div class="events-page-hero-banner-bottom-holder">
        <img alt="{{section.settings.image.alt}}" class="cover-image" src="{{section.settings.image | img_url: "master" }}" />
        <div class="events-page-hero-banner-bottom-el">
            <div class="left-block-holder-in-banner-bottom even-block-main">
                    <h2 class="title-in-bottom-banner-on-events">{{section.settings.title}}</h2>
            </div>
            <div class="right-block-holder-in-banner-bottom even-block-main">
                <h4 class="title-in-bottom-banner-on-events-two">{{section.settings.title-two}}</h4>
                <p class="body-text-in-bottom-banner-on-events-two">{{section.settings.body-text}}</p>
                <a class="body-text-in-bottom-banner-cta" href="{{section.settings.btn-link}}">{{section.settings.btn-text}}</a>
            </div>
        </div>
    </div>
</div> 
{% endif %}
{% schema %}
    {
      "name": "Spirituality Block Events",
      "class": "spirituality-block-event-banner",
      "settings": [
        {
        "type": "image_picker",
        "id": "image",
        "label": "Image Cover"
        },
       {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Explore your spirituality"
        },  
       {
          "type": "text",
          "id": "title-two",
          "label": "Title",
          "default": "Have you seen our hand curated experiences?"
        },  
        {
          "type": "textarea",
          "id": "body-text",
          "label": "Section Body Text",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod."
        },  
        {
          "type": "text",
          "id": "btn-text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
         "type": "url",
         "id": "btn-link",
         "label": "Button link"
        }
      ],
      "presets": [
        {
          "name": "Spirituality Block Events",
          "category": "Page Banners"
        }
      ]
    } 
  {% endschema %} 