{% schema %}
    {
      "name": "Footer v2 Block",
      "class": "members-block-event-banner",
      "settings": [
        {
          "type": "link_list",
          "id": "policies_menu",
          "label": "Policies"
        },

       {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "lorem ipsum"
        },
        {
          "type": "textarea",
          "id": "body-text",
          "label": "Body Text Below Title",
          "default": "Sign up for free videos and the latest from Gaia."
        },
        {
            "type": "url",
            "id": "fb-link",
            "label": "Facebook Social link"
        },
        {
            "type": "url",
            "id": "tw-link",
            "label": "Twitter Social link"
        },
        {
            "type": "url",
            "id": "insta-link",
            "label": "Instagram Social link"
        },
        {
            "type": "url",
            "id": "yb-link",
            "label": "Youtube Social link"
        },
        {
            "type": "url",
            "id": "pin-link",
            "label": "Pinterest Social link"
        },
        {
          "type": "checkbox",
          "id": "show_newsletter",
          "label": "Show Newsletter"
        }
      ],
    "blocks": [
      {
        "type": "footer-links",
        "name": "links",
        "settings": [
            {
            "type": "text",
            "id": "footer_linklist_title",
            "label": "Heading",
            "default": "Quick links"
          }, {
            "type": "link_list",
            "id": "menu",
            "label": "Menu"
          }

        ]
      }
    ],
      "presets": [
        {
          "name": "Footer v2 Block",
          "category": "Page Banners"
        }
      ]
    }
  {% endschema %}