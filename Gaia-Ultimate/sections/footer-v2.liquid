      {% comment %} FOOTER LINKS {% endcomment %}
      <div class="footer-links-block">
        {%for block in section.blocks %}
          <ul class="hc-quicklinks  menu-{{ block.settings.footer_linklist_title }}">
            <li class="linksTitleMain">
              {{ block.settings.footer_linklist_title }}
            </li>
            {% for link in linklists[block.settings.menu].links %}
              <li class="main-links-font">
                <a href="{{ link.url }}" {% if link.title == "Accessibility View" %} data-acsb-custom-trigger="true" {% endif %}>{{ link.title }}</a>
              </li>
            {% endfor %}
            <li class="main-links-font">
              <button onclick="javascript:OneTrust.ToggleInfoDisplay();">Cookie Settings</button>
            </li>
          </ul>
        {% endfor %}
        {%-  comment -%}
        {%- if linklists[section.settings.policies_menu].links.size > 0 -%}
          <ul class="hc-quicklinks  menu-policies">
            <li class="linksTitleMain">
              Policies
            </li>
              {%- for link in linklists[section.settings.policies_menu].links -%}
                <li class="main-links-font">
                  <a href="{{ link.url }}" {% if link.title == "Accessibility View" %} data-acsb-custom-trigger="true" {% endif %}>{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
        {%- endif -%}
          {%- endcomment -%}
      </div>

