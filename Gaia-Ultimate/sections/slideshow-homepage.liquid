{%- comment -%}
  Section to be shown will be based on the customer's subscription level
{%- endcomment -%}
{%- liquid
  if content_for_header contains 'Shopify.designMode = true'
    # if in theme customize mode
    assign preview_mode = section.settings.preview_customer_status
  else
    assign preview_mode = false
  endif

  assign isAnonymous = true
  assign isEntitled = false
  assign isTrial = false
  assign isInactive = false
 
  if preview_mode == "entitled"
    assign isAnonymous = false
    assign isEntitled = true
    assign isTrial = false
    assign isInactive = false
  elsif preview_mode == "trial"
    assign isAnonymous = false
    assign isEntitled = false
    assign isTrial = true
    assign isInactive = false
  elsif preview_mode == "inactive"
    assign isAnonymous = false
    assign isEntitled = false
    assign isTrial = false
    assign isInactive = true
  endif

  if customer
    assign isAnonymous = false
    assign isEntitled = false
    assign isTrial = false
    assign isInactive = true
    for tag in customer.tags
      if tag == '253' or tag == '280' or tag == '290'
        assign isAnonymous = false
        assign isEntitled = true
        assign isTrial = false
        assign isInactive = false
      endif
      if tag == 'TRIAL'
        assign isAnonymous = false
        assign isEntitled = false
        assign isTrial = true
        assign isInactive = false
      endif
    endfor
  endif
-%}

  {%- unless section.settings.full_width -%}
    <div class="page-width hero--padded">
  {%- endunless -%}

  {% style %}
    .hero--{{ section.id }} {
      height: {{ section.settings.height }}px;
    }

    @media screen and (max-width: 768px) {
      .hero--{{ section.id }} {
        height: {{ section.settings.height_mobile }}px;
      }
    }
  {% endstyle %}

  <div
    data-section-id="{{ section.id }}"
    data-section-type="slideshow-section"
    data-immediate-load>
    {%- if section.blocks.size > 0 -%}
      <div class="slideshow-wrapper">
        {%- if section.settings.autoplay and section.settings.style == 'bars' and section.blocks.size > 1 -%}
          {%- style -%}
            [data-bars][data-autoplay="true"] .flickity-page-dots .dot:after {
              animation-duration: {{ section.settings.autoplay_speed | times: 1000 }}ms;
            }
          {%- endstyle -%}
          <button type="button" class="visually-hidden slideshow__pause" data-id="{{ section.id }}" aria-live="polite">
            <span class="slideshow__pause-stop">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-pause" viewBox="0 0 10 13"><g fill="#000" fill-rule="evenodd"><path d="M0 0h3v13H0zM7 0h3v13H7z"/></g></svg>
              <span class="icon__fallback-text">{{ 'sections.slideshow.pause_slideshow' | t }}</span>
            </span>
            <span class="slideshow__pause-play">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="18.24 17.35 24.52 28.3"><path fill="#323232" d="M22.1 19.151v25.5l20.4-13.489-20.4-12.011z"/></svg>
              <span class="icon__fallback-text">{{ 'sections.slideshow.play_slideshow' | t }}</span>
            </span>
          </button>
        {%- endif -%}

        {% if preview_mode %}
          <div style="width: 100%; text-align: center; background: rgba(255, 0, 0, .5); color: #fff;
                      position: absolute; top: 0; z-index: 999;">
            <strong style="text-transform: uppercase;">preview customer status - {{ preview_mode }}</strong><br/>
            {%- if preview_mode == 'entitled' -%}
              Use copy and button set from block level.
            {%- else -%}
              Use copy and button set from section level, unless block is set to override.
            {%- endif -%}
        </div>
        {% endif %}

        <div id="Slideshow-{{ section.id }}"
          class="hero hero--{{ section.id }} loading loading--delayed"
          data-autoplay="{{ section.settings.autoplay }}"
          data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
          {% if section.settings.style == 'arrows' %}
            data-arrows="true"
          {% endif %}
          {% if section.settings.style == 'dots' %}
            data-dots="true"
          {% endif %}
          {% if section.settings.style == 'bars' %}
            data-dots="true"
            data-bars="true"
          {% endif %}
          data-slide-count="{{ section.blocks.size }}">
          {%- for block in section.blocks -%}

            {% liquid
              assign text_align = section.settings.text_align
              assign title_size = section.settings.title_size
              if isEntitled or block.settings.override_section_text == true
                # use block copy when customer is entitled or override is set from block level
                assign top_subheading = block.settings.top_subheading
                assign title = block.settings.title
                assign subheading = block.settings.subheading
                assign link = block.settings.link
                assign link2 = block.settings.link2
                assign link_text = block.settings.link_text
                assign link_text_2 = block.settings.link_text_2
              elsif isAnonymous
                assign top_subheading = section.settings.anonymous_top_subheading
                assign title = section.settings.anonymous_title
                assign subheading = section.settings.anonymous_subheading
                assign link = section.settings.anonymous_link
                assign link2 = ''
                assign link_text = section.settings.anonymous_link_text
                assign link_text_2 = ''
              elsif isTrial
                assign top_subheading = section.settings.trial_top_subheading
                assign title = section.settings.trial_title
                assign subheading = section.settings.trial_subheading
                assign link = section.settings.trial_link
                assign link2 = ''
                assign link_text = section.settings.trial_link_text
                assign link_text_2 = ''
              elsif isInactive
                assign top_subheading = section.settings.inactive_top_subheading
                assign title = section.settings.inactive_title
                assign subheading = section.settings.inactive_subheading
                assign link = section.settings.inactive_link
                assign link2 = ''
                assign link_text = section.settings.inactive_link_text
                assign link_text_2 = ''
              endif
            %}

            {%- case block.type -%}
              {%- when 'slide' -%}
                <div
                  {{ block.shopify_attributes }}
                  class="slideshow__slide slideshow__slide--{{ block.id }}"
                  data-index="{{ forloop.index0 }}"
                  data-id="{{ block.id }}">
                  {%- style -%}
                    .slideshow__slide--{{ block.id }} .hero__title {
                      font-size: {{ title_size | times: 0.43 }}px;
                    }
                    @media only screen and (min-width: 769px) {
                      .slideshow__slide--{{ block.id }} .hero__title {
                        font-size: {{ title_size }}px;
                      }
                    }
                  {%- endstyle -%}
                  <div class="hero__sidebyside hero__sidebyside-text--{{ block.settings.text_position }} color-scheme-{{ block.settings.color_scheme }}">
                    {%- if block.settings.indent_image -%}
                      {%- if block.settings.color_scheme != 'none' -%}
                        {%- render 'color-scheme-texture', color_scheme: block.settings.color_scheme -%}
                      {%- endif -%}
                    {%- endif -%}
                    <div class="hero__sidebyside-content">
                      <div class="hero__sidebyside-content-inner{% if block.settings.indent_image %} hero__sidebyside-content-inner--indented{% endif %} small--text-center">
                        {%- unless block.settings.indent_image -%}
                          {%- if block.settings.color_scheme != 'none' -%}
                            {%- render 'color-scheme-texture', color_scheme: block.settings.color_scheme -%}
                          {%- endif -%}
                        {%- endunless -%}
                        {%- unless top_subheading == blank -%}
                          <div class="hero__top-subtitle">
                            <div class="hero__animation-contents">
                              {{ top_subheading | escape }}
                            </div>
                          </div>
                        {%- endunless -%}

                        {%- unless title == blank -%}
                          <h2 class="h1 hero__title">
                            <div class="hero__animation-contents">
                            {{ title | newline_to_br }}
                            </div>
                          </h2>
                        {%- endunless -%}

                        {%- if subheading or link or link_2 -%}
                          {%- if link_text != blank or link_text_2 != blank -%}
                            <div class="hero__link">
                              {%- if link_text != blank -%}
                                <a href="{{ link }}" class="btn">
                                  {{ link_text }}
                                </a>
                              {%- endif -%}
                              {%- if link_text_2 != blank -%}
                                <a href="{{ link_2 }}" class="btn">
                                  {{ link_text_2 }}
                                </a>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                          {%- unless subheading == blank -%}
                            <div class="hero__subtitle">
                              <div class="hero__animation-contents smmmn">
                                {{ subheading | escape }}
                              </div>
                            </div>
                          {%- endunless -%}
                        {%- endif -%}

                      </div>
                    </div>
                    <div class="hero__sidebyside-image{% if block.settings.indent_image %} hero__sidebyside-image--indented{% endif %}">
                      {%- if block.settings.image != blank -%}
                        {%- if link != blank -%}
                          <a href="{{ link }}" class="hero__sidebyside-image-link" aria-hidden="true">
                        {%- endif -%}

                        {%- capture image_classes -%}
                          hero__image hero__image--{{ block.id }}
                        {%- endcapture -%}

                        {%- liquid
                          if forloop.index == 1
                            assign loading = section.settings.lazyload_images
                          else
                            assign loading = true
                          endif
                        -%}

                        {%- render 'image-element',
                          img: block.settings.image,
                          loading: loading,
                          classes: image_classes,
                          sizeVariable: '60vw',
                        -%}

                        {%- if block.settings.link != blank -%}
                          </a>
                        {%- endif -%}
                      {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- when 'hero' -%}
                <div
                  {{ block.shopify_attributes }}
                  class="slideshow__slide slideshow__slide--{{ block.id }}"
                  data-index="{{ forloop.index0 }}"
                  data-id="{{ block.id }}">
                  {%- style -%}
                    {%- if block.settings.invert_color -%}
                    .slideshow__slide--{{ block.id }} {
                      color: var(--colorTextBody);
                    }
                    .slideshow__slide--{{ block.id }} .hero__text-shadow:after {
                      background: radial-gradient(rgba(255,255,255,.3) 0%,transparent 60%);
                    }
                    .slideshow__slide--{{ block.id }} .hero__text-shadow {
                      text-shadow: 0 3px 7px rgba(255, 255, 255, 0.15);
                    }
                    {%- endif -%}
                    {%- assign title_mobile_size = title_size | times: 0.43 -%}
                    .slideshow__slide--{{ block.id }} .hero__title {
                      {%- unless title_mobile_size < 24 -%}
                      font-size: {{ title_mobile_size }}px;
                      {%- else -%}
                      font-size: calc(var(--typeHeaderSize)*0.63);
                      {%- endunless -%}
                    }
                    .slideshow__slide--{{ block.id }} .enlarge-text {
                      font-size: calc(var(--typeBaseSize));
                    }
                    @media only screen and (min-width: 769px) {
                      .slideshow__slide--{{ block.id }} .hero__title {
                        font-size: {{ title_size }}px;
                      }
                      .slideshow__slide--{{ block.id }} .enlarge-text {
                        font-size: calc(var(--typeBaseSize) + 4px);
                      }
                    }

                    {% if block.settings.overlay_opacity > 0 %}
                      .slideshow__slide--{{ block.id }} .hero__image-wrapper:after {
                        content: '';
                        position: absolute;
                        left: 0;
                        right: 0;
                        top: 0;
                        bottom: 0;
                        z-index: 3;
                        background-color: #000;
                        opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
                      }
                    {% endif %}
                  {%- endstyle -%}

                  {%- liquid
                    assign hero_text = false
                    if top_subheading != blank or title != blank or subheading != blank or link_text != blank
                      assign hero_text = true
                    endif

                    assign has_mobile_image = false
                    if block.settings.image_mobile != blank
                      assign has_mobile_image = true
                    endif
                  -%}

                  <div
                    class="hero__image-wrapper {% unless hero_text %} hero__image-wrapper--no-overlay{% endunless %}"
                  >
                    {%- if block.settings.image != blank -%}
                      {% capture image_classes %}
                        hero__image hero__image--{{ block.id }}
                        {% if has_mobile_image %} small--hide{% endif %}
                      {% endcapture %}

                      {% comment %} Full width images so don't need to adjust sizes attribute, fallback is 100vw {% endcomment %}
                      {%- liquid
                        if forloop.index == 1
                          assign loading = section.settings.lazyload_images
                        else
                          assign loading = true
                        endif
                      -%}
                
                      {%- render 'image-element',
                        img: block.settings.image,
                        loading: loading,
                        classes: image_classes,
                      -%}
                      {%- if has_mobile_image -%}
                        {% capture image_classes %}
                          hero__image hero__image--{{ block.id }} medium-up--hide
                        {% endcapture %}
                        {%- render 'image-element',
                          img: block.settings.image_mobile,
                          loading: loading,
                          classes: image_classes,
                        -%}
                      {%- endif -%}
                      {% elsif block.settings.vlink != blank  %}
                        <video class="video-cover-in-banner-main" muted playsinline loop autoplay  width='100%' height='100%' src='{{ block.settings.vlink }}' type='video/mp4'></video>

                    {%- else -%}
                      {%- if template == 'password' -%}
                        {%- assign password_image = 'password-page-background.jpg' -%}
                        {%- render 'image-element',
                          asset: password_image,
                          host: 'theme',
                          loading: section.settings.lazyload_images,
                          type: 'asset',
                          classes: 'hero__image',
                        -%}
                      {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  {%- if link != blank and link_2 == blank -%}
                    <div class="hero__link">
                      <a href="{{ link }}" class="hero__slide-link" aria-hidden="true"></a>
                    </div>
                  {%- endif -%}

                  {%- if hero_text -%}
                    <div class="hero__text-wrap smsmsm">
                      <div class="page-width">
                        <div class="hero__text-content {{ text_align }}">
                          <div class="hero__text-shadow">
                            {%- unless top_subheading == blank -%}
                              <div class="hero__top-subtitle">
                                <div class="hero__animation-contents sa">
                                  {{ top_subheading | escape }}
                                </div>
                              </div>
                            {%- endunless -%}
                            {%- unless title == blank -%}
                              <h2 class="h1 hero__title">
                                <div class="hero__animation-contents saaaaa">
                                {{ title | newline_to_br }}
                                </div>
                              </h2>
                            {%- endunless -%}
                            {%- if subheading or link or link_2 -%}
                              {%- unless subheading == blank -%}
                                <div class="hero__subtitle {% if section.settings.full_hide == true %} hide-on-mobile-full  {% endif %}" >
                                  <div class="hero__animation-contents sadada">
                                    {{ subheading | newline_to_br }}
                                  </div>
                                </div>
                              {%- endunless -%}
                              {%- if link_text != blank or link_text_2 != blank -%}
                                <div class="hero__link">
                                  {%- if link_text != blank -%}
                                    <a href="{{ link }}" class="btn{% if block.settings.color_accent contains 'rgba(0,0,0,0)' %} btn--inverse{% endif %}">
                                      {{ link_text }}
                                    </a>
                                  {%- endif -%}
                                  {%- if link_text_2 != blank -%}
                                    <a href="{{ link_2 }}" class="btn{% if block.settings.color_accent contains 'rgba(0,0,0,0)' %} btn--inverse{% endif %}">
                                      {{ link_text_2 }}
                                    </a>
                                  {%- endif -%}
                                </div>
                              {%- endif -%}
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <div class="placeholder-noblocks">
        {{ 'home_page.onboarding.no_content' | t }}
      </div>
    {%- endif -%}
  </div>
  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}


{% schema %}
{
  "name": "t:sections.slideshow-homepage.name",
  "class": "index-section--hero",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "preview_customer_status",
      "label": "Preview Customer Status",
      "info": "Headings and texts under section settings will be used, unless the customer is entitled or the slide block settings is marked as 'Override section text'.",
      "default": "anonymous",
      "options": [
        {
          "value": "anonymous",
          "label": "Anonymous"
        },
        {
          "value": "trial",
          "label": "Trial"
        },
        {
          "value": "inactive",
          "label": "Inactive"
        },
        {
          "value": "entitled",
          "label": "Entitled"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.slideshow-homepage.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_hide",
      "label": "Hide Copy on Mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:sections.slideshow-homepage.settings.height.label",
      "default": 650,
      "min": 450,
      "max": 750,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "t:sections.slideshow-homepage.settings.height_mobile.label",
      "default": 450,
      "min": 350,
      "max": 650,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.slideshow-homepage.settings.style.label",
      "default": "arrows",
      "options": [
        {
          "value": "minimal",
          "label": "t:sections.slideshow-splihomepage.settings.style.options.minimal.label"
        },
        {
          "value": "arrows",
          "label": "t:sections.slideshow-homepage.settings.style.options.arrows.label"
        },
        {
          "value": "bars",
          "label": "t:sections.slideshow-homepage.settings.style.options.bars.label"
        },
        {
          "value": "dots",
          "label": "t:sections.slideshow-homepage.settings.style.options.dots.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow-homepage.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.slideshow-homepage.settings.autoplay_speed.label",
      "default": 7,
      "min": 5,
      "max": 10,
      "step": 1,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "lazyload_images",
      "label": "t:common.lazyload_images.label",
      "info": "t:common.lazyload_images.info",
      "default": true
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.title_size.label",
      "default": 60,
      "min": 40,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.slideshow-homepage.blocks.hero.settings.text_align.label",
      "default": "vertical-center horizontal-left",
      "options": [
        {
          "value": "vertical-center horizontal-left",
          "label": "t:sections.slideshow-homepage.blocks.hero.settings.text_align.options.vertical-center_horizontal-left.label"
        },
        {
          "value": "vertical-center horizontal-center",
          "label": "t:sections.slideshow-homepage.blocks.hero.settings.text_align.options.vertical-center_horizontal-center.label"
        },
        {
          "value": "vertical-center horizontal-right",
          "label": "t:sections.slideshow-homepage.blocks.hero.settings.text_align.options.vertical-center_horizontal-right.label"
        },
        {
          "value": "vertical-bottom horizontal-left",
          "label": "t:sections.slideshow-homepage.blocks.hero.settings.text_align.options.vertical-bottom_horizontal-left.label"
        },
        {
          "value": "vertical-bottom horizontal-center",
          "label": "t:sections.slideshow-homepage.blocks.hero.settings.text_align.options.vertical-bottom_horizontal-center.label"
        },
        {
          "value": "vertical-bottom horizontal-right",
          "label": "t:sections.slideshow-homepage.blocks.hero.settings.text_align.options.vertical-bottom_horizontal-right.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "ANONYMOUS"
    },
    {
      "type": "text",
      "id": "anonymous_top_subheading",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.top_subheading.label"
    },
    {
      "type": "textarea",
      "id": "anonymous_title",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.title.label",
      "default": "Side by Side Slide"
    },
    {
      "type": "textarea",
      "id": "anonymous_subheading",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.subheading.label",
      "default": "Add optional subtext"
    },
    {
      "type": "url",
      "id": "anonymous_link",
      "label": "t:sections.slideshow-splihomepage.blocks.slide.settings.link.label"
    },
    {
      "type": "text",
      "id": "anonymous_link_text",
      "label": "t:sections.slideshow-splihomepage.blocks.slide.settings.link_text.label",
      "default": "Optional button"
    },
    {
      "type": "header",
      "content": "INACTIVE"
    },
    {
      "type": "text",
      "id": "inactive_top_subheading",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.top_subheading.label"
    },
    {
      "type": "textarea",
      "id": "inactive_title",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.title.label",
      "default": "Side by Side Slide"
    },
    {
      "type": "textarea",
      "id": "inactive_subheading",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.subheading.label",
      "default": "Add optional subtext"
    },
    {
      "type": "url",
      "id": "inactive_link",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.link.label"
    },
    {
      "type": "text",
      "id": "inactive_link_text",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.link_text.label",
      "default": "Optional button"
    },
    {
      "type": "header",
      "content": "TRAIL"
    },
    {
      "type": "text",
      "id": "trial_top_subheading",
      "label": "t:sections.slideshow-splihomepage.blocks.slide.settings.top_subheading.label"
    },
    {
      "type": "textarea",
      "id": "trial_title",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.title.label",
      "default": "Side by Side Slide"
    },
    {
      "type": "textarea",
      "id": "trial_subheading",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.subheading.label",
      "default": "Add optional subtext"
    },
    {
      "type": "url",
      "id": "trial_link",
      "label": "t:sections.slideshow-homepage.blocks.slide.settings.link.label"
    },
    {
      "type": "text",
      "id": "trial_link_text",
      "label": "t:sections.slideshow-splihomepage.blocks.slide.settings.link_text.label",
      "default": "Optional button"
    },
    {
      "type": "header",
      "content": "ENTITLED",
      "info": "each block heading and text will be used for entitled customers."
    }
  ],
  "blocks": [
