

<div class="rich-text-meta-info-parent">
    <div class="rich-text-meta-info-holder">
        <div class="rich-text-meta-info-el">
          {% if collection.metafields.rich-text.key != blank %}
            <h2 class="meta-info-title-prop">{{ collection.metafields.rich-text.key }}</h2>
          {% else %}
            <h2 class="meta-info-title-prop">{{section.settings.title}}</h2>
          {% endif %}
            <div class="block-holder-in-block-icons desktop-view" {% if section.settings.hide-blocks == true %} style="display:none;" {% endif %}>
              {% if collection.metafields.trigger-meta-content.key != blank  %}
                {% for perk in collection.metafields.rich-text.perk %}
                  {% if perk != blank %}
                  <div class="block-element-in-blocks">
                      <div class="tick-icon">
