</div>
          {% if collection.metafields.rich-text-body-snippet.key != blank %}
            <p class="meta-info-body-text">{{ collection.metafields.rich-text-body-snippet.key }}</p>
            {% else %}
            <p class="meta-info-body-text">{{section.settings.body-text}}</p>
          {% endif %}
        </div>
    </div>
</div> 


 
{% schema %}
    {
      "name": "Rich Text Meta Info",
      "class": "rich-text-banner",
      "settings": [
      
        {
          "type": "richtext",
          "id": "title",
          "label": "Title Intro"

        }, 
        {
  "type": "checkbox",
  "id": "hide-blocks",
  "label": "Hide Blocks",
  "default": false
},

       
        {
          "type": "textarea",
          "id": "body-text",
          "label": "Body Text Below Title",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit..."
}
      ],
      "blocks": [
        {
          "type": "section",
          "name": "section-block", 
          "settings": [
           
              {
              "type": "text",
              "id": "body-text",
              "label": "Block Body Text"
            }
         
          ]
        }
      ],
      "presets": [
        {
          "name": "Rich Text Meta Info",
          "category": "Page Banners"
        }
      ]
    } 
  {% endschema %}  