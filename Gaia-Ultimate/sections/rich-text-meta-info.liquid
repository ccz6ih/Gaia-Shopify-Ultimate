                  {% endif %}
              {% endfor %}
    
                {% else %}
            {% for block in section.blocks %}
              {% if block.settings.body-text != blank %}
              <div class="block-element-in-blocks">
                  <div class="tick-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
