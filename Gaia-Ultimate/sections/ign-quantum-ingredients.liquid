{% comment %}
  IGN QUANTUM INGREDIENT SHOWCASE WITH LEARN MORE MODALS
  Interactive grid displaying ingredients with hover effects, quantum enhancement callouts,
  and detailed modals for in-depth ingredient information and formulation synergies
{% endcomment %}

{{ 'ign-quantum-ingredients.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ign-quantum-ingredients-wrapper {
    background-color: {{ section.settings.background_color }};
  }

  .ign-ingredients-heading {
    color: {{ section.settings.primary_color }};
  }

  .ign-quantum-badge {
    background: linear-gradient(135deg, {{ section.settings.accent_color }} 0%, {{ section.settings.primary_color }} 100%);
  }

  .ign-image-overlay {
    background: linear-gradient(135deg, {{ section.settings.accent_color }}30 0%, {{ section.settings.primary_color }}30 100%);
  }

  .ign-ingredient-name {
    color: {{ section.settings.primary_color }};
  }

  .ign-ingredient-tagline {
    color: {{ section.settings.accent_color }};
  }

  .ign-benefits-label {
    color: {{ section.settings.primary_color }};
  }

  .ign-quantum-detail {
    border-left-color: {{ section.settings.accent_color }};
  }

  .ign-quantum-detail span {
    color: {{ section.settings.primary_color }};
  }

  .ign-learn-more-btn {
    background: linear-gradient(135deg, {{ section.settings.accent_color }} 0%, {{ section.settings.primary_color }} 100%);
  }

  .ign-modal-badge {
    background: linear-gradient(135deg, {{ section.settings.accent_color }} 0%, {{ section.settings.primary_color }} 100%);
  }

  .ign-modal-title {
    color: {{ section.settings.primary_color }};
  }

  .ign-modal-tagline {
    color: {{ section.settings.accent_color }};
  }

  .ign-modal-section-title {
    color: {{ section.settings.primary_color }};
  }

  .ign-modal-highlight {
    background: {{ section.settings.background_color }};
    border-left-color: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<section class="ign-quantum-ingredients-wrapper">
  <div class="ign-ingredients-container">
    {% if section.settings.section_heading != blank %}
      <div class="ign-ingredients-header">
        <h2 class="ign-ingredients-heading">
          {{ section.settings.section_heading }}
        </h2>
        {% if section.settings.section_description != blank %}
          <div class="ign-ingredients-description">
            {{ section.settings.section_description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ign-ingredients-grid" data-columns="{{ section.settings.grid_columns }}">
      {% for block in section.blocks %}
        {% if block.type == 'ingredient' %}
          <div class="ign-ingredient-card" {{ block.shopify_attributes }} {% if block.settings.anchor_id != blank %}id="{{ block.settings.anchor_id }}"{% endif %} style="scroll-margin-top: 100px;">
            <div class="ign-card-inner">
              {% if section.settings.show_quantum_badge and block.settings.quantum_enhancement != blank %}
                <div class="ign-quantum-badge">
                  <svg class="ign-quantum-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="white"/>
                  </svg>
                  <span class="ign-quantum-label">QUANTUM-ENHANCED</span>
                </div>
              {% endif %}

              {% if block.settings.ingredient_image %}
                <div class="ign-ingredient-image-wrapper">
                  <img
                    src="{{ block.settings.ingredient_image | image_url: width: 400 }}"
                    alt="{{ block.settings.ingredient_name | escape }}"
                    loading="lazy"
                    class="ign-ingredient-image"
                  >
                  <div class="ign-image-overlay"></div>
                </div>
              {% endif %}

              <div class="ign-ingredient-content">
                <h3 class="ign-ingredient-name">
                  {{ block.settings.ingredient_name }}
                </h3>
                
                {% if block.settings.ingredient_tagline != blank %}
                  <div class="ign-ingredient-tagline">
                    {{ block.settings.ingredient_tagline }}
                  </div>
                {% endif %}

                {% if block.settings.ingredient_description != blank %}
                  <div class="ign-ingredient-description">
                    {{ block.settings.ingredient_description }}
                  </div>
                {% endif %}

                {% if block.settings.benefits_list != blank %}
                  {% assign benefits = block.settings.benefits_list | newline_to_br | split: '<br />' %}
                  <div class="ign-benefits-wrapper">
                    <div class="ign-benefits-label">
                      <b>MAY SUPPORT:</b>
                    </div>
                    <ul class="ign-benefits-list">
                      {% for benefit in benefits %}
                        {% if benefit != blank %}
                          <li class="ign-benefit-item">
                            <svg class="ign-benefit-check" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M10 0C4.48 0 0 4.48 0 10C0 15.52 4.48 20 10 20C15.52 20 20 15.52 20 10C20 4.48 15.52 0 10 0ZM8 15L3 10L4.41 8.59L8 12.17L15.59 4.58L17 6L8 15Z" fill="{{ section.settings.accent_color }}"/>
                            </svg>
                            {{ benefit | strip }}
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}

                {% if section.settings.show_quantum_badge and block.settings.quantum_enhancement != blank %}
                  <div class="ign-quantum-detail">
                    <svg class="ign-quantum-spark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="{{ section.settings.accent_color }}"/>
                    </svg>
                    <span>{{ block.settings.quantum_enhancement }}</span>
                  </div>
                {% endif %}

                <!-- Learn More Button -->
                <button 
                  class="ign-learn-more-btn" 
                  data-ign-ingredient-modal="{{ block.id }}"
                  aria-label="Learn more about {{ block.settings.ingredient_name }}"
                >
                  <span>Learn More</span>
                  <svg class="ign-btn-arrow" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.5 15L12.5 10L7.5 5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Modal for this ingredient -->
          <div class="ign-ingredient-modal" id="ign-modal-{{ block.id }}" data-ign-modal="{{ block.id }}" role="dialog" aria-modal="true" aria-labelledby="ign-modal-title-{{ block.id }}">
            <div class="ign-modal-overlay" data-ign-modal-close="{{ block.id }}"></div>
            <div class="ign-modal-container">
              <div class="ign-modal-content">
                <button class="ign-modal-close" data-ign-modal-close="{{ block.id }}" aria-label="Close modal">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </button>

                <div class="ign-modal-header">
                  <div class="ign-modal-badge">
                    <svg class="ign-modal-badge-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="white"/>
                    </svg>
                  </div>
                  <h2 id="ign-modal-title-{{ block.id }}" class="ign-modal-title">
                    {{ block.settings.ingredient_name }}
                  </h2>
                  {% if block.settings.ingredient_tagline != blank %}
                    <div class="ign-modal-tagline">
                      {{ block.settings.ingredient_tagline }}
                    </div>
                  {% endif %}
                </div>

                <div class="ign-modal-body">
                  {% if block.settings.extended_description != blank %}
                    <div class="ign-modal-section">
                      <h3 class="ign-modal-section-title">What It Is</h3>
                      <div class="ign-modal-section-content">
                        {{ block.settings.extended_description }}
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.how_it_works != blank %}
                    <div class="ign-modal-section">
                      <h3 class="ign-modal-section-title">How It Works</h3>
                      <div class="ign-modal-section-content">
                        {{ block.settings.how_it_works }}
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.formulation_synergy != blank %}
                    <div class="ign-modal-section ign-modal-highlight">
                      <h3 class="ign-modal-section-title">
                        <svg class="ign-synergy-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="{{ section.settings.accent_color }}"/>
                        </svg>
                        Synergy in the Igniton Formula
                      </h3>
                      <div class="ign-modal-section-content">
                        {{ block.settings.formulation_synergy }}
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.research_highlights != blank %}
                    {% assign research_items = block.settings.research_highlights | newline_to_br | split: '<br />' %}
                    <div class="ign-modal-section">
                      <h3 class="ign-modal-section-title">Research Highlights</h3>
                      <ul class="ign-modal-list">
                        {% for item in research_items %}
                          {% if item != blank %}
                            <li>
                              <svg class="ign-list-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M10 0C4.48 0 0 4.48 0 10C0 15.52 4.48 20 10 20C15.52 20 20 15.52 20 10C20 4.48 15.52 0 10 0ZM8 15L3 10L4.41 8.59L8 12.17L15.59 4.58L17 6L8 15Z" fill="{{ section.settings.accent_color }}"/>
                              </svg>
                              {{ item | strip }}
                            </li>
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  <div class="ign-modal-footer">
                    {% if block.settings.dosage_info != blank %}
                      <div class="ign-modal-info-block">
                        <div class="ign-modal-info-label">Dosage</div>
                        <div class="ign-modal-info-content">{{ block.settings.dosage_info }}</div>
                      </div>
                    {% endif %}

                    {% if block.settings.safety_notes != blank %}
                      {% assign safety_items = block.settings.safety_notes | newline_to_br | split: '<br />' %}
                      <div class="ign-modal-info-block">
                        <div class="ign-modal-info-label">Safety Profile</div>
                        <div class="ign-modal-info-content ign-modal-safety-content">
                          <ul>
                            {% for item in safety_items %}
                              {% if item != blank %}
                                <li>
                                  <svg class="ign-safety-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M10 0L12.5 5L17.5 5.5L13.5 9.5L14.5 15L10 12L5.5 15L6.5 9.5L2.5 5.5L7.5 5L10 0Z" fill="{{ section.settings.accent_color }}"/>
                                  </svg>
                                  {{ item | strip }}
                                </li>
                              {% endif %}
                            {% endfor %}
                          </ul>
                        </div>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  // IGN Modal functionality with mobile enhancements
  (function() {
    const modals = document.querySelectorAll('.ign-ingredient-modal');
    const openButtons = document.querySelectorAll('[data-ign-ingredient-modal]');
    const closeButtons = document.querySelectorAll('[data-ign-modal-close]');
    
    // Open modal
    openButtons.forEach(button => {
      button.addEventListener('click', () => {
        const modalId = button.getAttribute('data-ign-ingredient-modal');
        const modal = document.querySelector(`[data-ign-modal="${modalId}"]`);
        
        if (modal) {
          modal.classList.add('active');
          document.body.classList.add('ign-modal-open');
          
          // Focus trap
          const focusableElements = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
          if (focusableElements.length) {
            focusableElements[0].focus();
          }
          
          // Mobile scroll enhancements
          if (window.innerWidth <= 768) {
            const modalBody = modal.querySelector('.ign-modal-body');
            if (modalBody) {
              // Reset scroll state
              modalBody.scrollTop = 0;
              modalBody.classList.remove('has-scrolled', 'scrolled-bottom');
              
              // Add scroll detection for mobile
              const handleScroll = function() {
                if (this.scrollTop > 50) {
                  this.classList.add('has-scrolled');
                }
                
                const isAtBottom = this.scrollHeight - this.scrollTop <= this.clientHeight + 10;
                if (isAtBottom) {
                  this.classList.add('scrolled-bottom');
                } else {
                  this.classList.remove('scrolled-bottom');
                }
              };
              
              modalBody.addEventListener('scroll', handleScroll);
              
              // Store handler for cleanup
              modalBody._scrollHandler = handleScroll;
            }
          }
        }
      });
    });
    
    // Close modal
    closeButtons.forEach(button => {
      button.addEventListener('click', () => {
        const modalId = button.getAttribute('data-ign-modal-close');
        const modal = document.querySelector(`[data-ign-modal="${modalId}"]`);
        
        if (modal) {
          modal.classList.remove('active');
          document.body.classList.remove('ign-modal-open');
          
          // Cleanup mobile scroll handler
          if (window.innerWidth <= 768) {
            const modalBody = modal.querySelector('.ign-modal-body');
            if (modalBody && modalBody._scrollHandler) {
              modalBody.removeEventListener('scroll', modalBody._scrollHandler);
              delete modalBody._scrollHandler;
            }
          }
        }
      });
    });
    
    // Close on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const activeModal = document.querySelector('.ign-ingredient-modal.active');
        if (activeModal) {
          activeModal.classList.remove('active');
          document.body.classList.remove('ign-modal-open');
          
          // Cleanup mobile scroll handler
          if (window.innerWidth <= 768) {
            const modalBody = activeModal.querySelector('.ign-modal-body');
            if (modalBody && modalBody._scrollHandler) {
              modalBody.removeEventListener('scroll', modalBody._scrollHandler);
              delete modalBody._scrollHandler;
            }
          }
        }
      }
    });
    
    // Prevent scroll on modal content from closing
    modals.forEach(modal => {
      const modalContent = modal.querySelector('.ign-modal-container');
      modalContent.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    });
    
    // Add swipe down to close on mobile
    if (window.innerWidth <= 768) {
      modals.forEach(modal => {
        const modalContainer = modal.querySelector('.ign-modal-container');
        let touchStartY = 0;
        let touchEndY = 0;
        
        modalContainer.addEventListener('touchstart', (e) => {
          touchStartY = e.changedTouches[0].screenY;
        }, { passive: true });
        
        modalContainer.addEventListener('touchmove', (e) => {
          const modalBody = modal.querySelector('.ign-modal-body');
          // Only allow swipe to close when scrolled to top
          if (modalBody.scrollTop === 0) {
            touchEndY = e.changedTouches[0].screenY;
          }
        }, { passive: true });
        
        modalContainer.addEventListener('touchend', (e) => {
          const modalBody = modal.querySelector('.ign-modal-body');
          if (modalBody.scrollTop === 0) {
            touchEndY = e.changedTouches[0].screenY;
            const swipeDistance = touchEndY - touchStartY;
            
            // If swiped down more than 100px, close the modal
            if (swipeDistance > 100) {
              modal.classList.remove('active');
              document.body.classList.remove('ign-modal-open');
            }
          }
        }, { passive: true });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "IGN Quantum Ingredients",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Quantum-Enhanced Ingredients"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Section Description",
      "default": "<p>Each ingredient is enhanced with ignitons through our proprietary cold plasma and laser-photonics process, increasing bioavailability and effectiveness.</p>"
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "Grid Columns (Desktop)",
      "options": [
        {
          "value": "2",
          "label": "2 Columns"
        },
        {
          "value": "3",
          "label": "3 Columns"
        },
        {
          "value": "4",
          "label": "4 Columns"
        }
      ],
      "default": "3"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#191880"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D3A23C"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF6F2"
    },
    {
      "type": "checkbox",
      "id": "show_quantum_badge",
      "label": "Show Quantum Enhancement Badge",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient Name",
          "default": "Citicoline"
        },
        {
          "type": "text",
          "id": "ingredient_tagline",
          "label": "Catchy Tagline",
          "default": "THE MEMORY ARCHITECT",
          "info": "All caps recommended for impact"
        },
        {
          "type": "richtext",
          "id": "ingredient_description",
          "label": "Description",
          "default": "<p>Citicoline supports the production of acetylcholine, a neurotransmitter essential for memory, attention, and cognitive function.</p>"
        },
        {
          "type": "textarea",
          "id": "benefits_list",
          "label": "Benefits List (one per line)",
          "default": "Memory Enhancement\nImproved Focus\nMental Energy\nNeuroprotection",
          "info": "Enter each benefit on a new line"
        },
        {
          "type": "image_picker",
          "id": "ingredient_image",
          "label": "Ingredient Image (Optional)"
        },
        {
          "type": "text",
          "id": "quantum_enhancement",
          "label": "Quantum Enhancement Detail",
          "default": "60% increased bioavailability",
          "info": "Shows when quantum badge is enabled"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Anchor ID (for deep linking)",
          "info": "e.g., quantum-ingredient-citicoline (no spaces, lowercase)",
          "default": "quantum-ingredient"
        },
        {
          "type": "header",
          "content": "LEARN MORE MODAL CONTENT"
        },
        {
          "type": "richtext",
          "id": "extended_description",
          "label": "Extended Description",
          "default": "<p>Citicoline, also known as CDP-choline, is a naturally occurring compound found in every cell of the body. It plays a crucial role in the synthesis of phosphatidylcholine, a major component of brain tissue. By enhancing the production of acetylcholine—one of the brain's most important neurotransmitters—citicoline supports memory formation, learning, and cognitive processing.</p><p>Clinical studies have demonstrated that citicoline supplementation can improve attention span, focus, and memory recall, particularly in individuals experiencing age-related cognitive decline.</p>",
          "info": "Detailed scientific explanation for the modal"
        },
        {
          "type": "richtext",
          "id": "how_it_works",
          "label": "How It Works",
          "default": "<p>Citicoline works through multiple mechanisms to enhance brain health. First, it increases the availability of choline in the brain, which is essential for acetylcholine synthesis. Second, it supports the production of phospholipids that maintain healthy cell membranes. Third, it enhances cerebral blood flow, ensuring optimal oxygen and nutrient delivery to brain tissue.</p>",
          "info": "Explanation of mechanism of action"
        },
        {
          "type": "richtext",
          "id": "formulation_synergy",
          "label": "Formulation Synergy",
          "default": "<p>In the IgniCognition formula, citicoline works synergistically with Alpha-GPC to provide dual-pathway choline support, maximizing acetylcholine production. When combined with PQQ and NR, it creates a powerful cognitive stack that addresses both immediate mental performance and long-term brain health.</p><p>The quantum enhancement process increases citicoline's absorption rate, allowing for lower doses while maintaining efficacy—reducing the risk of side effects while maximizing benefits.</p>",
          "info": "How this ingredient works with others in the formula"
        },
        {
          "type": "textarea",
          "id": "research_highlights",
          "label": "Research Highlights (one per line)",
          "default": "Clinical trial showed 18% improvement in memory recall after 90 days\nMeta-analysis of 14 studies confirmed cognitive benefits\nSupported by over 2,000 published scientific studies\nUsed in medical settings for stroke recovery",
          "info": "Key research findings, one per line"
        },
        {
          "type": "text",
          "id": "dosage_info",
          "label": "Dosage Information",
          "default": "250mg per serving (Quantum-Enhanced)",
          "info": "Dosage and form information"
        },
        {
          "type": "textarea",
          "id": "safety_notes",
          "label": "Safety Notes (one per line)",
          "default": "Generally well-tolerated\nNo significant side effects at recommended doses\nThird-party tested for purity",
          "info": "Safety profile, one item per line"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IGN Quantum Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "ingredient_name": "Citicoline",
            "ingredient_tagline": "THE MEMORY ARCHITECT",
            "ingredient_description": "<p>Supports the production of acetylcholine, a neurotransmitter essential for memory, attention, and cognitive function.</p>",
            "benefits_list": "Memory Enhancement\nImproved Focus\nMental Energy\nNeuroprotection",
            "quantum_enhancement": "60% increased bioavailability"
          }
        },
        {
          "type": "ingredient",
          "settings": {
