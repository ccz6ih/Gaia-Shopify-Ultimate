{{ 'ign-product-info-tabs.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ign-product-info-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .ign-product-info-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Color customizations */
  .ign-product-info-section-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }
  
  .ign-product-info-section-{{ section.id }} .ign-tab-button {
    color: {{ section.settings.tab_text_color }};
    border-color: {{ section.settings.tab_border_color }};
  }
  
  .ign-product-info-section-{{ section.id }} .ign-tab-button:hover {
    background-color: {{ section.settings.tab_hover_bg }};
    color: {{ section.settings.tab_active_color }};
  }
  
  .ign-product-info-section-{{ section.id }} .ign-tab-button.active {
    background-color: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_color }};
    border-color: {{ section.settings.accent_color }};
  }
  
  .ign-product-info-section-{{ section.id }} .ign-info-block {
    background-color: {{ section.settings.block_bg_color }};
    border-color: {{ section.settings.block_border_color }};
  }
  
  .ign-product-info-section-{{ section.id }} .ign-info-content {
    color: {{ section.settings.text_color }};
  }
  
  .ign-product-info-section-{{ section.id }} .ign-info-content h1,
  .ign-product-info-section-{{ section.id }} .ign-info-content h2,
  .ign-product-info-section-{{ section.id }} .ign-info-content h3,
  .ign-product-info-section-{{ section.id }} .ign-info-content h4,
  .ign-product-info-section-{{ section.id }} .ign-info-content h5,
  .ign-product-info-section-{{ section.id }} .ign-info-content h6 {
    color: {{ section.settings.heading_color }};
    font-family: 'Poppins', sans-serif;
  }
  
  .ign-product-info-section-{{ section.id }} .ign-separator {
    border-color: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div class="ign-product-info-section ign-product-info-section-{{ section.id }} ign-product-info-{{ section.id }}-padding">
  {%- if section.blocks.size > 0 -%}
    <div class="page-width{% if section.settings.max_width %} page-width--narrow{% endif %}">
      
      {%- comment -%} Section Header {%- endcomment -%}
      {%- if section.settings.section_title != blank -%}
        <div class="ign-product-info-header">
          <h2 class="ign-product-info-title">{{ section.settings.section_title }}</h2>
          {%- if section.settings.section_subtitle != blank -%}
            <p class="ign-product-info-subtitle">{{ section.settings.section_subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Collect all tabs first {%- endcomment -%}
      {%- assign has_tabs = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' or block.type == 'contact' or block.settings.is_tab -%}
          {%- assign has_tabs = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Tab Navigation {%- endcomment -%}
      {%- if has_tabs -%}
        <div class="ign-tabs-wrapper">
          <div class="ign-tabs-nav" role="tablist">
            {%- assign tab_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' or block.type == 'contact' or block.settings.is_tab -%}
                {%- assign tab_index = tab_index | plus: 1 -%}
                <button
                  class="ign-tab-button{% if tab_index == 1 %} active{% endif %}"
                  role="tab"
                  aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
                  aria-controls="ign-tab-panel-{{ block.id }}"
                  data-tab-target="ign-tab-panel-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.type == 'tab' -%}
                    {{ block.settings.title | default: 'Tab ' | append: tab_index }}
                  {%- elsif block.type == 'contact' -%}
                    {{ block.settings.title | default: 'Contact Us' }}
                  {%- elsif block.type == 'description' -%}
                    {{ 'Product Details' }}
                  {%- endif -%}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="ign-tabs-content">
            {%- assign tab_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' or block.type == 'contact' or block.settings.is_tab -%}
                {%- assign tab_index = tab_index | plus: 1 -%}
                <div
                  id="ign-tab-panel-{{ block.id }}"
                  class="ign-tab-panel{% if tab_index == 1 %} active{% endif %}"
                  role="tabpanel"
                  aria-hidden="{% if tab_index == 1 %}false{% else %}true{% endif %}"
                >
                  <div class="ign-tab-content">
                    {%- case block.type -%}
                      {%- when 'tab' -%}
                        {{ block.settings.content }}
                        {{ block.settings.page.content }}
                      {%- when 'contact' -%}
                        {%- render 'tab-contact', id: block.id, block: block -%}
                      {%- when 'description' -%}
                        {%- if block.settings.is_tab -%}
                          <div class="ign-product-description">
                            {{ product.description }}
                          </div>
                        {%- endif -%}
                    {%- endcase -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Non-tab blocks {%- endcomment -%}
      <div class="ign-info-blocks">
        {%- for block in section.blocks -%}
          {%- unless block.type == 'tab' or block.type == 'contact' or block.settings.is_tab -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="ign-info-block ign-info-block--app">
                  {% render block %}
                </div>
              {%- when 'separator' -%}
                <div class="ign-separator-wrapper">
                  <hr class="ign-separator">
                </div>
              {%- when 'text' -%}
                <div class="ign-info-block ign-info-block--text" {{ block.shopify_attributes }}>
                  <div class="ign-info-content">
                    {{ block.settings.text }}
                  </div>
                </div>
              {%- when 'description' -%}
                {%- unless block.settings.is_tab -%}
                  <div class="ign-info-block ign-info-block--description" {{ block.shopify_attributes }}>
                    <div class="ign-info-content">
                      <h3 class="ign-block-title">{{ 'Product Description' }}</h3>
                      {{ product.description }}
                    </div>
                  </div>
                {%- endunless -%}
              {%- when 'share' -%}
                <div class="ign-info-block ign-info-block--share" {{ block.shopify_attributes }}>
                  <div class="ign-share-wrapper">
                    <h4 class="ign-share-title">Share this product</h4>
                    {%- render 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product -%}
                  </div>
                </div>
              {%- when 'custom' -%}
                <div class="ign-info-block ign-info-block--custom" {{ block.shopify_attributes }}>
                  <div class="ign-custom-content">
                    {{ block.settings.code }}
                  </div>
                </div>
            {%- endcase -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>

    </div>
  {%- endif -%}
</div>

{{ 'ign-product-info-tabs.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "IGN Product Info Tabs",
  "class": "ign-product-info",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Product Information"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section subtitle"
    },
    {
      "type": "checkbox",
      "id": "max_width",
      "label": "Limit width",
      "info": "Make content narrower for better readability",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#191880"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#D3A23C"
    },
    {
      "type": "header",
      "content": "Tab Colors"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "Tab border color",
      "default": "#E5E5E5"
    },
    {
      "type": "color",
      "id": "tab_hover_bg",
      "label": "Tab hover background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "tab_active_bg",
      "label": "Tab active background",
      "default": "#191880"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Tab active text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Block Colors"
    },
    {
      "type": "color",
      "id": "block_bg_color",
      "label": "Block background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "block_border_color",
      "label": "Block border",
      "default": "#E5E5E5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "is_tab",
          "label": "Display as tab",
          "default": true
        }
      ]
    },
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Add additional product information here</p>",
          "label": "Text content"
        }
      ]
    },
    {
      "type": "tab",
      "name": "Information tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Shipping Information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>Add your shipping and delivery information here.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Or select a page"
        }
      ]
    },
    {
      "type": "share",
      "name": "Share buttons",
      "limit": 1
    },
    {
      "type": "separator",
      "name": "Separator line"
    },
    {
      "type": "contact",
      "name": "Contact form tab",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Ask a Question"
        },
        {
          "type": "checkbox",
          "id": "phone",
          "label": "Include phone field"
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom HTML/Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "code",
          "label": "Custom code",
          "default": "<h4>Custom content</h4><p>Add your custom HTML, JavaScript, or Liquid code here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IGN Product Info Tabs",
      "blocks": [
        {
          "type": "description",
          "settings": {
            "is_tab": true
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Shipping & Returns",
            "content": "<p><strong>Free Shipping</strong> on all orders over $50</p><p><strong>30-Day Returns</strong> for your peace of mind</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Quality Guarantee",
            "content": "<p>All our products are backed by our quality guarantee. We use only the finest materials and rigorous testing.</p>"
          }
        },
        {
          "type": "share"
        }
      ]
    }
  ]
}
{% endschema %}