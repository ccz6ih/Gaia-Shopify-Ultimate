                    <defs>
                        <linearGradient id="paint0_linear_235_2825" x1="-0.212524" y1="0.000122253" x2="77.7875" y2="12.0001" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#EEB462"/>
                        <stop offset="1" stop-color="#A56812"/>
                        </linearGradient>
                    </defs>
                    </svg>
                </div>
                <p class="actual-customer-review-from-metafields">{{rev}}</p>
                <h3 class="customer-review-name-metafields">
                    {%if product.metafields.custom-name-and-image.key[forloop.index0] != blank %}
                    <div class="image-inside-circle"><img class="imageCircleInReviewItem-item" src="{{product.metafields.custom-name-and-image.key[forloop.index0]}}" width="50" height="50" /></div>
                    {% endif %}
                    {{product.metafields.name-holder-type.key[forloop.index0]}}</h3>
            </div>
             {% endfor %}

             
     
      
        {% comment %} End Actual Review Block {% endcomment %}
         <p {% if count <= 3 %} style="display:none" {% endif %} class="view-More-reviews-drop">
            <span class="reviewsTextViewMore">View More</span>
            <span class="reviewsArrowForReverse"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="9" viewBox="0 0 14 9" fill="none">
            <path d="M12.854 1.01733C12.6782 0.841553 12.4585 0.753663 12.1948 0.753663C11.9312 0.753663 11.7114 0.841553 11.5356 1.01733L6.56982 5.98315L1.604 1.01733C1.42822 0.841553 1.2085 0.753663 0.944824 0.753663C0.681152 0.753663 0.461426 0.841553 0.285645 1.01733C0.0952148 1.20776 0 1.43115 0 1.6875C0 1.94385 0.0952148 2.15991 0.285645 2.33569L5.91064 7.96069C5.99854 8.06323 6.10107 8.13647 6.21826 8.18042C6.33545 8.22437 6.45264 8.24634 6.56982 8.24634C6.68701 8.24634 6.8042 8.22437 6.92139 8.18042C7.03857 8.13647 7.14111 8.06323 7.229 7.96069L12.854 2.33569C13.0444 2.15991 13.1396 1.94385 13.1396 1.6875C13.1396 1.43115 13.0444 1.20776 12.854 1.01733Z" fill="#26B4B2"/>
          </svg></span>
         </p>
        </div>
    </div>
</div>

<script>
$(".view-More-reviews-drop").click(function() {
    // Toggle the class
    $(".toBeExpandedFullReview").toggleClass("expandReviewOnFull");
    $(".reviewsArrowForReverse").toggleClass("svgArrowReverseTop");
    // Change the button text
    if ($(".reviewsTextViewMore").text().trim() === "View More") {
        $(".reviewsTextViewMore").text("View Less");
    
    } else {
        $(".reviewsTextViewMore").text("View More");
    }
});

</script>

{% schema %}
    {
      "name": "Reviews Metafields Block",
      "class": "mapping",
      "settings": [

      
       {
          "type": "text",
          "id": "title",
          "label": "Section Title",
          "default": "Customer Reviews"
        }
       
      ],
      "presets": [
        {
            "name": "Reviews Metafields Block",
            "category": "Product Page Widgets"
        }
      ]
    } 
{% endschema %}  