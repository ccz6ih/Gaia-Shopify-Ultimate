{% assign count = 0 %}
<div class="custom-reviews-metafields-block-parent">
    <div class="custom-reviews-metafields-block-holder">
        {% if product.metafields.c-re-title.key != blank %}
        <h2 class="titleinReviewsCustomer">  
            {{ product.metafields.c-re-title.key }}
        </h2>
        {%else %}
        <h2 class="titleinReviewsCustomer">
        {{section.settings.title}}
        </h2>
    {% endif %} 

        <div class="custom-reviews-metafields-block-el">
            {% comment %} Actual Review Block {% endcomment %}
             {% for rev in product.metafields.rev-text-holder.key %}
                {% assign count = count | plus: 1 %}
             <div  class="actual-review-block {% if count > 3 %} more-than-three-reviews toBeExpandedFullReview {% endif %}">
                <div class="icon-stars-custom-reviews-star-metafields">
                    <svg xmlns="http://www.w3.org/2000/svg" width="79" height="13" viewBox="0 0 79 13" fill="none">
