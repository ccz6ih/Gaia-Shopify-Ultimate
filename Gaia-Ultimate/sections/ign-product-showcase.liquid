{{ 'ign-product-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign featured_products = section.settings.featured_products
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ign-product-showcase {
    --ign-primary: {{ section.settings.primary_color | default: '#191880' }};
    --ign-primary-dark: {{ section.settings.primary_color_dark | default: '#1B1B57' }};
    --ign-gold: {{ section.settings.accent_color | default: '#D3A23C' }};
    --ign-gold-dark: {{ section.settings.accent_color_dark | default: '#B26E26' }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient ign-product-showcase-wrapper">
  <div class="ign-product-showcase section-{{ section.id }}-padding">
    <div class="page-width ign-showcase-container">
      
      {%- comment -%} Animated Header {%- endcomment -%}
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="ign-showcase__header">
          <div class="ign-showcase__header-left">
            {%- if section.settings.heading != blank -%}
              <h2 class="ign-showcase__heading {{ section.settings.heading_size }}">
                {{ section.settings.heading }}
              </h2>
            {%- endif -%}
            
            {%- if section.settings.subheading != blank -%}
              <div class="ign-showcase__subheading rte">
                {{ section.settings.subheading }}
              </div>
            {%- endif -%}
          </div>
          
          {%- if section.settings.show_view_all and section.settings.view_all_text != blank -%}
            <a href="{{ section.settings.view_all_link }}" class="ign-showcase__view-all">
              {{ section.settings.view_all_text }}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Main Layout {%- endcomment -%}
      <div class="ign-showcase__layout">
        
        {%- comment -%} Enhanced Feature Card Hero {%- endcomment -%}
        {%- if section.settings.show_feature_card -%}
          <div class="ign-showcase__hero">
            <div class="ign-feature-card">
              {%- if section.settings.feature_image != blank -%}
                <div class="ign-feature-card__image">
                  {{ section.settings.feature_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                </div>
              {%- endif -%}
              
              <div class="ign-feature-card__content">
                {%- if section.settings.feature_heading != blank -%}
                  <h3 class="ign-feature-card__heading">{{ section.settings.feature_heading }}</h3>
                {%- endif -%}
                
                {%- if section.settings.feature_text != blank -%}
                  <div class="ign-feature-card__text rte">
                    {{ section.settings.feature_text }}
                  </div>
                {%- endif -%}

                {%- comment -%} Animated Product Tabs {%- endcomment -%}
                {%- if section.settings.enable_tabs -%}
                  <div class="ign-feature-tabs" data-tabs>
                    <div class="ign-feature-tabs__nav">
                      <span class="ign-feature-tabs__indicator"></span>
                      
                      {%- for i in (1..3) -%}
                        {%- assign tab_label = 'tab_' | append: i | append: '_label' -%}
                        {%- assign tab_active = false -%}
                        {%- if i == 1 -%}
                          {%- assign tab_active = true -%}
                        {%- endif -%}
                        
                        {%- if section.settings[tab_label] != blank -%}
                          <button 
                            class="ign-feature-tabs__button{% if tab_active %} active{% endif %}"
                            data-tab="{{ i }}"
                            type="button"
                          >
                            <span class="ign-feature-tabs__button-text">{{ section.settings[tab_label] }}</span>
                          </button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    {%- comment -%} Tab Panels with Stats {%- endcomment -%}
                    {%- for i in (1..3) -%}
                      {%- assign panel_subtitle = 'tab_' | append: i | append: '_subtitle' -%}
                      {%- assign panel_active = false -%}
                      {%- if i == 1 -%}
                        {%- assign panel_active = true -%}
                      {%- endif -%}
                      
                      <div class="ign-feature-tabs__panel{% if panel_active %} active{% endif %}" data-panel="{{ i }}">
                        {%- if section.settings[panel_subtitle] != blank -%}
                          <p class="ign-feature-tabs__subtitle">{{ section.settings[panel_subtitle] }}</p>
                        {%- endif -%}
                        
                        <div class="ign-feature-stats">
                          {%- for j in (1..3) -%}
                            {%- assign stat_value = 'tab_' | append: i | append: '_stat_' | append: j | append: '_value' -%}
                            {%- assign stat_label = 'tab_' | append: i | append: '_stat_' | append: j | append: '_label' -%}
                            {%- assign stat_desc = 'tab_' | append: i | append: '_stat_' | append: j | append: '_desc' -%}
                            
                            {%- if section.settings[stat_value] != blank -%}
                              <div class="ign-stat-card" data-stat>
                                <div class="ign-stat-card__icon">
                                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                                  </svg>
                                </div>
                                <div class="ign-stat-card__number" 
     data-target="{{ section.settings[stat_value] | remove: '%' | remove: '+' | remove: '-' }}"
     data-prefix="{% if section.settings[stat_value] contains '+' %}+{% elsif section.settings[stat_value] contains '-' %}-{% endif %}"
     data-suffix="%">0</div>
                                <div class="ign-stat-card__progress">
                                  <div class="ign-stat-card__progress-bar" style="width: 0%" data-progress></div>
                                </div>
                                {%- if section.settings[stat_label] != blank -%}
                                  <div class="ign-stat-card__label">{{ section.settings[stat_label] }}</div>
                                {%- endif -%}
                                {%- if section.settings[stat_desc] != blank -%}
                                  <div class="ign-stat-card__desc">{{ section.settings[stat_desc] }}</div>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Flexible Product Grid {%- endcomment -%}
        <div class="ign-showcase__grid">
          {%- if featured_products != blank -%}
            {%- for product in featured_products limit: section.settings.products_to_show -%}
              {%- assign product_index = forloop.index0 -%}
              <div class="ign-product-card" style="--index: {{ product_index }}">
                <a href="{{ product.url }}" class="ign-product-card__link">
                  
                  {%- comment -%} Dynamic Badge {%- endcomment -%}
                  {%- assign badge_text = 'product_' | append: forloop.index | append: '_badge' -%}
                  {%- assign badge_type = 'product_' | append: forloop.index | append: '_badge_type' -%}
                  {%- if section.settings[badge_text] != blank -%}
                    <span class="ign-product-card__badge ign-product-card__badge--{{ section.settings[badge_type] | default: 'new' }}">
                      {{ section.settings[badge_text] }}
                    </span>
                  {%- endif -%}

                  <div class="ign-product-card__content">
                    <div class="ign-product-card__top">
                      {%- assign product_code = 'product_' | append: forloop.index | append: '_code' -%}
                      {%- if section.settings[product_code] != blank -%}
                        <div class="ign-product-card__code">{{ section.settings[product_code] }}</div>
                      {%- endif -%}
                      <h3 class="ign-product-card__title">{{ product.title }}</h3>
                    </div>

                    <div class="ign-product-card__media">
                      {%- if product.featured_image -%}
                        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ign-product-card__image' }}
                      {%- endif -%}
                      
                      {%- comment -%} Quantum Enhancement Indicator {%- endcomment -%}
                      {%- if section.settings.show_quantum_indicator -%}
                        <div class="ign-product-card__quantum">
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                          </svg>
                          <span>Quantum Enhanced</span>
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="ign-product-card__bottom">
                      <button type="button" class="ign-product-card__button">
                        {{ section.settings.button_text | default: 'Shop Now' }}
                      </button>
                      <p class="ign-product-card__price">
                        {%- if product.price_varies -%}
                          From {{ product.price_min | money }}
                        {%- else -%}
                          {{ product.price | money }}
                        {%- endif -%}
                      </p>
                    </div>
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- elsif collection != blank -%}
            {%- for product in collection.products limit: section.settings.products_to_show -%}
              {%- assign product_index = forloop.index0 -%}
              <div class="ign-product-card" style="--index: {{ product_index }}">
                <a href="{{ product.url }}" class="ign-product-card__link">
                  
                  {%- comment -%} Collection-based badge {%- endcomment -%}
                  {%- if product.available == false -%}
                    <span class="ign-product-card__badge ign-product-card__badge--sale">
                      Sold Out
                    </span>
                  {%- elsif product.compare_at_price > product.price -%}
                    <span class="ign-product-card__badge ign-product-card__badge--sale">
                      Sale
                    </span>
                  {%- endif -%}

                  <div class="ign-product-card__content">
                    <div class="ign-product-card__top">
                      <h3 class="ign-product-card__title">{{ product.title }}</h3>
                    </div>

                    <div class="ign-product-card__media">
                      {%- if product.featured_image -%}
                        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ign-product-card__image' }}
                      {%- endif -%}
                      
                      {%- if section.settings.show_quantum_indicator -%}
                        <div class="ign-product-card__quantum">
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                          </svg>
                          <span>Quantum Enhanced</span>
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="ign-product-card__bottom">
                      <button type="button" class="ign-product-card__button">
                        {{ section.settings.button_text | default: 'Shop Now' }}
                      </button>
                      <p class="ign-product-card__price">
                        {%- if product.price_varies -%}
                          From {{ product.price_min | money }}
                        {%- else -%}
                          {{ product.price | money }}
                        {%- endif -%}
                      </p>
                    </div>
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const showcase = document.querySelector('.ign-product-showcase');
    if (!showcase) return;

    // Tab functionality
    const tabs = showcase.querySelector('[data-tabs]');
    if (tabs) {
      const buttons = tabs.querySelectorAll('[data-tab]');
      const panels = tabs.querySelectorAll('[data-panel]');
      const indicator = tabs.querySelector('.ign-feature-tabs__indicator');
      
      function updateIndicator(button) {
        if (indicator && button) {
          const rect = button.getBoundingClientRect();
          const navRect = button.parentElement.getBoundingClientRect();
          indicator.style.left = `${rect.left - navRect.left}px`;
          indicator.style.width = `${rect.width}px`;
        }
      }
      
      buttons.forEach(button => {
        button.addEventListener('click', () => {
          const tabId = button.dataset.tab;
          
          // Update buttons
          buttons.forEach(b => b.classList.remove('active'));
          button.classList.add('active');
          
          // Update panels
          panels.forEach(p => p.classList.remove('active'));
          const targetPanel = tabs.querySelector(`[data-panel="${tabId}"]`);
          if (targetPanel) {
            targetPanel.classList.add('active');
            
            // Animate stats when panel becomes active
            animateStats(targetPanel);
          }
          
          // Update indicator
          updateIndicator(button);
        });
      });
      
      // Initialize indicator position
      const activeButton = tabs.querySelector('.ign-feature-tabs__button.active');
      if (activeButton) {
        updateIndicator(activeButton);
      }
    }

    // Animate stats
    function animateStats(container) {
      const stats = container.querySelectorAll('[data-stat]');
      
      stats.forEach((stat, index) => {
        setTimeout(() => {
          const number = stat.querySelector('[data-target]');
          const progressBar = stat.querySelector('[data-progress]');
          
          if (number) {
  const target = parseFloat(number.dataset.target);
  const prefix = number.dataset.prefix || '';
  const suffix = number.dataset.suffix || '';
  let current = 0;
  const increment = target / 50;
  
  const timer = setInterval(() => {
    current += increment;
    if (current >= target) {
      current = target;
      clearInterval(timer);
    }
    number.textContent = prefix + Math.round(current) + suffix;
  }, 30);
}
          
          if (progressBar) {
            const target = parseFloat(progressBar.parentElement.previousElementSibling.dataset.target);
            progressBar.style.width = Math.min(target, 100) + '%';
          }
        }, index * 200);
      });
    }

    // Animate first tab panel on load
    const firstPanel = showcase.querySelector('.ign-feature-tabs__panel.active');
    if (firstPanel) {
      setTimeout(() => animateStats(firstPanel), 500);
    }

    // Intersection Observer for scroll animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observe product cards
    const cards = showcase.querySelectorAll('.ign-product-card');
    cards.forEach(card => {
      observer.observe(card);
    });
  });
</script>

