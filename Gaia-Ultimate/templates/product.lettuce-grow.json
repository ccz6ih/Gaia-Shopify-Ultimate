      "settings": {
        "narrow_column": false,
        "title": "Meet The Farmstand",
        "heading_size": "h2",
        "subheading": "",
        "align_heading": "center",
        "column_align_text": "left",
        "color_scheme": "1",
        "show_wave": false,
