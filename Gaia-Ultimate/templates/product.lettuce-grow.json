    "5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2": {
      "type": "testimonials",
      "blocks": {
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-1": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I love my new Farmstand, it’s just blooming now and almost ready to harvest! THANK YOU for this amazing product! Salads for EVERYONE!”</p>",
            "author": "Jennifer M.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-2": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“The Farmstand has exceeded all my expectations! I love everything about the Farmstand. It’s so fun to watch the plants grow. It’s fun to nurture the plants to maturity. It’s fun to harvest the plants but most of all, this farm stand is a work of art.”</p>",
            "author": "Susan L.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-3": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“In the six weeks I’ve been growing on the Farmstand, it has literally changed our lives. The weekly maintenance is straightforward, and it is very empowering to eat meals that you have grown.”</p>",
            "author": "Nicole A.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-4": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“What a great product… Everything about it is top notch. The tower is well constructed, and on top of being a great alternative to the grocery store, it is great for winter. Love this product -  well worth the investment.”</p>",
            "author": "Lori A. ",
            "author_info": ""
          }
        }
      },
      "block_order": [
