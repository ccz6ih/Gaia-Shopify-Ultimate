        "52340400-a01a-409b-ad53-f395c528891c": {
          "type": "text",
          "settings": {
            "parent_column": "left",
            "enlarge_text": true,
            "text": "<h3>METAL BASE DIMENSIONS</h3><p>30\" Wide × 72\" Long</p>"
          }
        },
        "6057b9c2-c12b-4f42-a225-8f797c040f55": {
          "type": "text",
          "settings": {
            "parent_column": "left",
            "enlarge_text": true,
            "text": "<h3>WIRING KIT INCLUDED</h3><ul><li>(1) 6.5mm to Banana Clip</li><li>(1) 6.5mm to 3.5mm</li><li>(1) 6.5mm to RCA</li><li>(1) 6.5mm to XLR Adapter</li></ul><p>*Plus Bonus Cables for other configurations</p>"
          }
        },
        "ab8cadbe-4e11-4668-ad52-2e2401ada089": {
          "type": "text",
          "settings": {
            "parent_column": "right",
            "enlarge_text": true,
            "text": "<h3>SOUND LOUNGE AMPLIFIER</h3><p><strong>Model</strong>: SMP300 (300 Watts)<br/><strong>Dimensions</strong>: 16.25 × 3 × 9.25 inches<br/><strong>Power</strong>: 120/240 Volts<br/><strong>Weight</strong>: 5lbs</p>"
          }
        },
