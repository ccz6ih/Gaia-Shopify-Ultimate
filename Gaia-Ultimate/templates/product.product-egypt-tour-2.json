        "76fa2165-a4cb-4aca-a03b-f6a545f7f60c": {
          "type": "text",
          "settings": {
            "parent_column": "center",
            "enlarge_text": false,
            "text": "<h3>Exclusive Pre-Diluvian Tour.</h3><p>The Gaia team has hand-curated this one-of-a-kind experience and it's only available through the Gaia Marketplace.</p>"
          }
        },
        "5c1d294c-9915-4022-b460-e1f736bb4135": {
          "type": "liquid",
          "settings": {
            "parent_column": "left",
            "code": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"87.864\" height=\"63.966\" viewBox=\"0 0 87.864 55.914\" style=\"margin: 0 auto 15px; display: block;\"><path d=\"M61.407,31.463A11.981,11.981,0,1,0,49.426,19.481,11.931,11.931,0,0,0,61.407,31.463Zm-31.951,0A11.981,11.981,0,1,0,17.475,19.481,11.931,11.931,0,0,0,29.457,31.463Zm0,7.988C20.151,39.451,1.5,44.123,1.5,53.429v9.985H57.414V53.429C57.414,44.123,38.762,39.451,29.457,39.451Zm31.951,0c-1.158,0-2.476.08-3.874.2,4.633,3.355,7.868,7.868,7.868,13.779v9.985H89.364V53.429C89.364,44.123,70.713,39.451,61.407,39.451Z\" transform=\"translate(-1.5 -7.5)\" fill=\"#02b5b4\"/></svg>"
