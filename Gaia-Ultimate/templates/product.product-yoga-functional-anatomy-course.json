            "text": "",
            "dropdown_text": "<ul><li>Introduction to Tiffany Cruikshank</li><li>Introduction to Yoga Medicine</li><li>Course Information</li><li>Introductory Concepts</li><li>Terms</li><li>Section 1 Review</li><li>Section 1 Homework</li><li>Section 1 Homework</li><li>Section 1 Quiz</li></ul>",
