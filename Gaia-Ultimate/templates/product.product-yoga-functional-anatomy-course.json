    "6a2fb62f-79e7-42de-acea-4e5fab243fb0": {
      "type": "columns-1",
      "blocks": {
        "12d522a9-b741-4d4c-9b79-bb469c9fa36d": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Who is this training for?",
            "text": "",
            "dropdown_text": "<p>This training is best suited for yoga teachers, yoga therapists, movement therapists, fitness instructors, physical therapists, and acupuncturists, as well as any instructors or healthcare providers with an interest or specialty in movement or pain.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "What are the prerequisites to this training?",
            "text": "",
            "dropdown_text": "<p>While this training is open to all, a basic understanding of anatomy will be helpful.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "fada70bb-9ebc-48cd-87d2-ba2bb418ab07": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Is the training all lecture-based?",
            "text": "",
            "dropdown_text": "<p>No. There are seven sections, and each consists of a lecture, a movement practice, and a homework assignment.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "36d254e6-c118-4eb9-868e-c7838412525e": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Are there any live sessions?",
            "text": "",
            "dropdown_text": "<p>No, all content is pre-recorded and self-paced!</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "64c54989-1338-47b7-bd63-ddfa422511b7": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "How long does it take to complete this training? Is there a deadline to finish it?",
            "text": "",
            "dropdown_text": "<p>The training is 22 hours, but the total time to complete it may be longer due to the self-paced nature of the training and the time it will take to complete the homework assignments. There is no deadline for completion.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "19434ac0-1bc8-4fa7-9407-033dd509cb20": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Does this training count as credit toward Yoga Medicine’s 500-HR/1000-HR Teacher Training?",
            "text": "",
            "dropdown_text": "<p>Yes. Once you complete the training you will have the option to log your hours on the Yoga Medicine website.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "195adf6e-7d69-4458-9adb-eaa295bb77f4": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "What props will I need?",
            "text": "",
            "dropdown_text": "<p>If you have yoga props available, please have the following nearby: one or two yoga blocks, two tennis balls or myofascial release balls of the same size, a yoga blanket or large towel, and one yoga strap.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "1c76f18a-f9fb-4f79-bfa9-a8156959e268": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Is there a required reading list for this training?",
            "text": "",
            "dropdown_text": "<p>There isn’t a required reading list but recommended reading may be suggested during the training.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "99dbb4a3-517b-49fe-a98d-3087ee41abc1": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Can I get contact continuing education hours if I’m a registered teacher with Yoga Alliance?",
            "text": "",
            "dropdown_text": "<p>Yes, currently Yoga Alliance is accepting all continuing education completed online. This includes both contact and non-contact hours. In order to receive continuing education hours for the training, you will need to complete all sessions and have the Yoga International certificate of completion.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "a6ba696d-87ce-4021-9070-389f2280aaa4": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Do I need to have a Yoga international membership to take this training?",
            "text": "",
            "dropdown_text": "<p>No. You must create an account to access the course materials but you do not need to pay for a membership. If you'd like a membership, you can sign up for a free trial to test it out first! Membership includes unlimited access to classes, meditations, articles, member courses, and more.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        }
      },
