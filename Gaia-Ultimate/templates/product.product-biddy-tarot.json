    "d2f3e665-9bf4-4aee-8b67-425b66d670c6": {
      "type": "columns-1",
      "blocks": {
        "75f8a537-55ac-4222-9783-a4fd0477d5b9": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "MODULE #1 - Getting Started",
            "text": "",
            "image": "shopify://shop_images/Module-1.jpg",
            "dropdown_text": "<h5>You’ll Learn:</h5><ul><li>The basic foundations of how to master the Tarot card meanings<br/></li><li>What Tarot is – and isn't. I bust the myths about Tarot and show you how to make the most of this intuitive tool<br/></li><li>How to choose your first Tarot deck<br/></li><li>How to get to know your Tarot deck from Day One</li></ul>",
            "background_color": "",
            "text_color": ""
          }
        },
        "4c239ee9-479d-4f81-b5b6-a7c9750699a5": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "MODULE #2 - Minor Arcana Systems + Cups + Pentacles + Keywords",
            "text": "",
            "image": "shopify://shop_images/Module-2.jpg",
            "dropdown_text": "<h5>You’ll Learn:</h5><ul><li>What the Major and Minor Arcana cards really mean in a Tarot reading</li><li>The two fundamental (and easy-to-learn) systems that unlock keys to the Minor Arcana</li><li>How to interpret the Suit of Cups and Pentacles Tarot card meanings. (And yes, we’ll explore every single card together!)</li><li>The quickest way to learn the key themes for every Tarot card</li></ul>",
            "background_color": "",
            "text_color": ""
          }
        },
        "0a6fb51b-ba50-461a-992b-45e0e72261a5": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "MODULE #3: Symbolism & Stories + 5-Minute Tarot + Swords + Wands",
            "text": "",
            "image": "shopify://shop_images/Module-3.jpg",
            "dropdown_text": "<h5>You’ll Learn:</h5><ul><li>How to easily decipher the symbolism within each Tarot card to access your intuition and inner wisdom</li><li>How to tell the story within a Tarot card</li><li>The best way to build a personal connection with the Tarot - in just 5 minutes a day!</li><li>How to interpret the Tarot cards of the Suit of Swords and the Suit of Wands</li></ul>",
            "background_color": "",
            "text_color": ""
          }
        },
        "d5af11b3-e1d0-4ae7-aef9-b21af820cfff": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "MODULE #4: Court Cards + Good Cards, Bad Cards",
            "text": "",
            "image": "shopify://shop_images/Module-4.jpg",
            "dropdown_text": "<h5>You’ll Learn:</h5><ul><li>How to demystify those pesky Tarot court cards once and for all</li><li>How to know if a court card is you or someone else</li><li>Why there are no 'bad' cards in the Tarot deck – yes, even the Tower card has its strengths!</li><li>A powerful way to interpret 'negative' Tarot cards in a positive light</li></ul>",
            "background_color": "",
            "text_color": ""
          }
        },
        "d2c67790-d1b5-4bce-8784-42372bc6dc67": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "MODULE #5: Majors + Meditations",
            "text": "",
            "image": "shopify://shop_images/Module-5.jpg",
            "dropdown_text": "<h5>You’ll Learn:</h5><ul><li>Why the Major Arcana cards are some of the most powerful cards in the Tarot deck</li><li>A powerful technique to dive deep into the energy of the Tarot cards and make them your own</li><li>How to interpret the meanings of the first 11 Major Arcana cards</li></ul>",
            "background_color": "",
            "text_color": ""
          }
        },
        "ef8142f1-11fe-4a33-8cb8-a2b7d594f364": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "MODULE #6: Majors + Reversals",
            "text": "",
            "image": "shopify://shop_images/Module-6.jpg",
            "dropdown_text": "<h5>You’ll Learn:</h5><ul><li>How to interpret the meanings of the final 11 Major Arcana cards</li><li>How the Major Arcana cards are deeply connected to one another (otherwise known as \"The Fool's Journey\")</li><li>My favorite techniques for interpreting reversed Tarot cards – without the doom and gloom!</li></ul>",
            "background_color": "",
            "text_color": ""
          }
        },
        "46f581b5-473f-4fc6-855d-f6c5dfcf4d05": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "MODULE #7: Tarot Card Combos + ‘Flow’ + 2-Card Readings",
            "text": "",
            "image": "shopify://shop_images/Module-7.jpg",
            "dropdown_text": "<h5>You’ll Learn:</h5><ul><li>7 strategies for deciphering Tarot card combinations quickly and easily</li><li>How to read the ‘flow’ between Tarot cards or highly intuitive and powerful readings</li><li>How to perform an in-depth 2-card Tarot reading</li></ul>",
            "background_color": "",
            "text_color": ""
          }
        },
