        "heading_D8De98": {
          "type": "heading",
          "settings": {
            "title": "What’s included in this astral projection training course:",
            "heading_size": "h2"
          }
        },
        "text_eAiErT": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<ul><li><strong>47</strong> immersive <strong>video classes</strong>.</li><li><strong>7 guided meditations</strong> to support each step of the journey. </li><li><strong>A 90-minute guided audio journey</strong> with binaural beats to trigger altered states.</li><li><strong>15+</strong> guided <strong>experiential exercises</strong> woven throughout the modules </li><li><strong>6 printable worksheets</strong> to support the practice. </li><li><strong>A Bonus module </strong>on the ancient Egyptian approach to <strong>Astral Projection</strong>, including a guided tea ritual. </li><li><strong>A deep dive into Jade’s signature S.T.A.T.E. Method</strong> - the 5-step induction process previously used in a scientific study.</li></ul>"
          }
