            "title_size": 58,
            "subheading": "<div id=\"yoga-header-subtitle\">\n<span class=\"yoga-philosophy-header-feature-1\">12 Hours of Learning</span>\n<span class=\"yoga-philosophy-header-feature-2\">For Yoga Enthusiasts\n</span>\n<span class=\"yoga-philosophy-header-feature-3\">Learn from Home\n</span>\n<span class=\"yoga-philosophy-header-feature-4\">Unlimited Course Access\n</span>\n</div>",
