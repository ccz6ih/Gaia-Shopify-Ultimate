        "8d2cb095-136c-4a83-8f19-f388b6643486": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "Be able to identify which <strong>foods to eat and which to avoid</strong> to help heal and nourish the body and improve gut issues, inflammation, hormonal issues, chronic disease, and more."
          }
        },
        "89ba8538-8598-4a52-9e15-e336d32dcd6a": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "Know how to <strong>fill your pantry and fridge with foods that will nourish</strong> your body and help to boost your immunity, longevity, energy, and regain your vitality."
          }
        },
        "ecde982d-b265-4d9a-9d45-9930a23b5531": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "Beﾠ<strong>qualified to use your Food Matters Nutrition Certification</strong>ﾠto not only improve your health using nutrition but also help others do the same, creating a positive impact in their lives."
          }
        },
        "c0441649-f49d-4518-bd5a-91a8be8ac72d": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "Understand theﾠ<strong>importance of bio individuality</strong>ﾠand that there is no one-size-fits-all approach when it comes to nutrition and health and how to apply this principle to your own life."
          }
        },
        "126b4575-ab8b-4651-a00b-2606b6bb53ac": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "Know how toﾠ<strong>utilize nutrition and natural healing methods</strong>ﾠto handle any future health issues that arise, ensuring you stay healthier for longer."
          }
        },
        "a1bf180e-6d2e-47e5-b691-c948d3bcfcd8": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
