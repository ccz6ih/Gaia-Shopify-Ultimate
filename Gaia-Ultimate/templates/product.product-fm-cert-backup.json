        },
        "0442b548-f79b-4cfe-9141-bd40de0f04f3": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "BONUS #21 EXCLUSIVE ACCESS",
            "text": "<h3><strong>Membership to the Program’s Student Referral Program</strong></h3><p>Start earning back your tuition fees when you join our referral program. Once you've enrolled, you will be eligible to share the program with friends and family, and for anyone who purchases through your referral link, you will receive a referral commission payment (cash paid directly to your account).</p><p><strong>Valued at: $2,590 </strong>- Yours Free</p>",
