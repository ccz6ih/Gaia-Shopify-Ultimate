        "template--20197640634689__e6fa5fae-029e-48df-a6da-fe4caef08809-text-1": {
          "type": "text",
          "settings": {
            "parent_column": "right",
            "enlarge_text": false,
            "text": "<h3>Gaia members save 10%</h3><p>Just for being a Gaia member, you will save 10% when you purchase.</p>"
          }
