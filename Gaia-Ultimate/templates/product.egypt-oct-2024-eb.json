    "05a6ccb4-5008-4aea-bd7b-71a71b3b7286": {
      "type": "text-with-icons",
      "blocks": {
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-1": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What accommodations should I expect?",
            "text": "<p>Throughout your Egypt trip, you will enjoy 5-star accommodations every night.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-3": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What's the difference between Double and Single occupancy?",
            "text": "<p>Single occupancy ensures you will have your own room at all accommodations during the trip. Double occupancy means you will share a room with another tour participant at all accommodations. Room pairings are based on compatibility within the tour group.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-4": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Do I need vaccinations to travel to Egypt?",
            "text": "<p>No vaccinations are required upon arrival in Egypt. It's recommended to consult with your healthcare provider before traveling.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-5": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Do you cater to Vegetarians or Vegans?",
            "text": "<p>The upscale hotels and restaurants we visit offer a variety of Egyptian and Western dishes, including plentiful vegetarian options and some vegan choices.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-7": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What service can I expect when traveling with Mohamed Ibrahim?",
            "text": "<p>Mohamed Ibrahim’s company, Saba Tours, has been operating for 15 years and is a member of the Egyptian Travel Agents Association (E.T.A.A.) and the International Air Transport Association (IATA). You can anticipate a professional team with extensive experience in tourism and touring.</p>"
          }
        }
      },
