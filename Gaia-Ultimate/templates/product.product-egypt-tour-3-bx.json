          }
        },
        "5126e38e-daf5-4953-a36a-6c08bdde1ba3": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 11: Dahshur - Friday, March 29th",
            "text": "<ul><li>Breakfast</li><li>Drive to downtown Cairo</li><li>Visit The Egyptian Museum in Cairo (see the Prediluvian Jars, Unfinished box & the Schist disc)</li><li>Lunch</li><li>Private 2 hour Visit inside the Great Pyramid (7-9pm)</li><li>Overnight at the Four<br/>Seasons Plaza</li></ul>",
