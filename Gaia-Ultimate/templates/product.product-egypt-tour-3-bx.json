            "text_color": ""
          }
        },
        "46f98c92-e505-4141-a9a0-fa35c3e1337c": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 2: Giza Plateau - Wednesday, March 20th",
            "text": "<ul><li>Private sunrise visit at the Sphinx around 6:00 a.m. </li><li>Return to the hotel for breakfast</li><li><em><strong>Stargate of Ancient Egypt </strong></em>presentation by Mohamed Ibrahim</li><li>Visit Giza Plateau</li><li>Visit the Valley Temple</li><li>Lunch</li><li>Visit the Essential Oil Centre</li><li>Overnight at Marriott Mena House Hotel<br/></li></ul>",
            "image": "shopify://shop_images/Giza_Plateau.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "af9886df-0842-456c-a4da-f86a8fae9128": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 3: Cairo/Luxor - Thursday, March 21st",
            "text": "<ul><li>Breakfast</li><li>Flight to Luxor</li><li>Visit Karnak Temple</li><li>Visit the Open-Air Museum at Karnak</li><li>Visit the Chapel of 7 Gates</li><li>Lunch</li><li>Drive to Steigenberger Luxor</li><li>Overnight at Steigenberger Luxor<br/></li></ul>",
            "image": "shopify://shop_images/Karnak.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "665f407f-c58f-4cfe-8e14-b0c7e48b8013": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 4: Dendera-Luxor - Friday, March 22nd",
            "text": "<ul><li>Early Breakfast</li><li>Drive to Dendera</li><li>Visit Hathor Temple</li><li>Drive to Luxor</li><li>Lunch at a local restaurant</li><li>Visit Luxor Temple in the evening</li><li>Overnight at Steigenberger Luxor</li></ul>",
            "image": "shopify://shop_images/Dendera_Luxor-min.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "a0ac19a9-eb3f-4293-b194-c7a3b463e4f6": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 5: Nile Cruise - Saturday, March 23rd",
            "text": "<ul><li>Optional Hot Air Balloon ride ($150)</li><li>Breakfast</li><li>Check-Out from Steigenberger Luxor</li><li>Drive to M/S Royal Elite Nile Cruise </li><li>Lunch aboard the ship</li><li>Visit Luxor Museum</li><li>Return to M/S Royal Elite Nile Cruise </li><li>Dinner at the Nile Cruise</li><li>Overnight at  M/S Royal Elite Nile Cruise<br/></li></ul>",
            "image": "shopify://shop_images/Nile_Cruise.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "356bfe06-89e2-457a-a782-ada1263e0d36": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 6: West Bank/Sailing - Sunday, March 24th",
            "text": "<ul><li>Optional Hot Air Balloon ride ($150)</li><li>Early Breakfast</li><li>Drive to the West Bank of Luxor</li><li>Visit The Famous Valley of The Kings</li><li>Visit Hatshepsut Temple</li><li>Visit the Alabaster Factory</li><li>Visit the 700 ton Colossi of Memenon</li><li>Return to the  M/S Royal Elite Nile Cruise </li><li>Lunch aboard the ship</li><li>Sail to Esna</li><li><em><strong>Lost Civilizations of Ancient Egypt</strong></em> presentation by Mohamed Ibrahim (Part 2)</li><li>Dinner at Nile Cruise</li><li>Overnight at the Nile Cruise</li></ul>",
            "image": "shopify://shop_images/WestBank-min.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "66db8b2b-fdc9-4434-bd63-38c72353b779": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 7: Edfu-kom Ombo - Monday, March 25th",
            "text": "<ul><li>Early morning drive to Edfu Temple</li><li>Visit Edfu Temple</li><li>Return to M/S Royal Elite Nile Cruise</li><li>Breakfast</li><li>Sailing to Kom Ombo</li><li>Lunch aboard the ship</li><li>Visit Kom Ombo</li><li>Dinner aboard M/S Royal Elite</li><li>Sail to Aswan</li><li>Overnight aboard M/S Royal Elite</li></ul>",
            "image": "shopify://shop_images/Edfu_Temple-min.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "dd20cdd8-6dc0-42a2-91c4-c110a0716601": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 8: Aswan - Tuesday, March 26th",
            "text": "<ul><li>Breakfast</li><li>Take the motorboat to Elephantine Island</li><li>Visit Satet Temple & Khnum Temple</li><li>Return by boat to M/S Royal Elite</li><li>Lunch aboard the ship</li><li>Drive to the Unfinished Obelisk (1200 Ton)</li><li>Visit Philae Island, Isis temple</li><li>Dinner aboard M/S Royal Elite</li><li>Overnight aboard  M/S Royal Elite</li></ul>",
            "image": "shopify://shop_images/Satet_Temple_1_-min.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "fe9d9b01-84d8-42dd-aa2f-b13bfa9cb5a5": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 9: Aswan/Cairo - Wednesday, March 27th",
            "text": "<ul><li>Breakfast</li><li>Drive to Aswan airport to fly to Cairo</li><li>Upon arriving in Cairo, drive to The St. Regis Cairo</li><li>Lunch on the way</li><li>Check into the hotel and rest of the day is free for you to explore</li><li>Overnight at the Four<br/>Seasons Plaza</li></ul>",
            "image": "shopify://shop_images/Cairo_9e35e516-9ce1-474e-be9a-3f0e22556efc.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "61cfa1f6-c4f1-446d-a5ef-2f4486dc1020": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 10: Sakkara - Thursday, March 28th",
            "text": "<ul><li>Breakfast</li><li>Drive to Sakkara</li><li>Visit the Step Pyramid Complex</li><li>Lunch</li><li>Drive to Dahshur</li><li>Visit the Red Pyramid from inside</li><li>Visit the Bent Pyramid from outside</li><li>Overnight at the Four<br/>Seasons Plaza<br/></li></ul>",
            "image": "shopify://shop_images/sakkara.jpg",
            "dropdown_text": "",
            "background_color": "#ffffff",
