        "57393d7c-eaea-43e6-934b-e35643791451": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 1: Cairo - Tuesday, March 19th",
            "text": "<ul><li>Arrive at Cairo airport</li><li>Meet Saba Tours assistant & transfer to hotel</li><li>Introductory meeting at 5 p.m.</li><li>Welcome Dinner</li><li>Accommodations at Marriott Mena House Hotel<br/></li></ul>",
