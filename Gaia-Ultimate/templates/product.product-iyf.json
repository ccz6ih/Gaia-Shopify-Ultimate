    "text_and_video_QmQMeK": {
      "type": "text-and-video",
      "settings": {
        "video_url": "https://www.youtube.com/watch?v=L4lzW0fZPk4",
        "subtitle": "",
        "title": "Location",
        "heading_size": "h2",
        "text": "<p><strong>Parmarth Niketan </strong>is a true, spiritual haven, lying on the holy banks of Mother Ganga, in the lap of the lush Himalayas. It is also the largest ashram in Rishikesh. Parmarth Niketan provides its thousands of pilgrims – who come from all corners of the Earth – with a clean, pure and sacred atmosphere as well as abundant, beautiful gardens. With several hundred rooms, the facilities are a perfect blend of modern amenities and traditional, spiritual simplicity.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "video_width": "50",
        "layout": "right",
        "color_scheme": "none",
