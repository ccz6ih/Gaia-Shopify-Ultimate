        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "disabled": true,
          "settings": {
            "reveal": false,
            "title": "What to Bring",
            "text": "",
            "dropdown_text": "<p><strong>IMPORTANT: </strong>We will have a Breathflow Session during the second and third days of the retreat.<br/><strong>Please bring a YOGA MAT </strong>as you will be lying down. Also bring a <strong>small pillow </strong>or <strong>folded towel </strong>to support your head.</p>",
