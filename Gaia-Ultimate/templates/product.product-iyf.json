    "faq_8X7aCm": {
      "type": "faq",
      "blocks": {
        "question_mBCepC": {
          "type": "question",
          "settings": {
            "title": "Where is IYF held?",
            "text": "<p>The International Yoga Festival is held at Parmarth Niketan Ashram in Rishikesh, Uttarakhand, India. To learn more about Parmarth and how to get there,<a href=\"https://internationalyogafestival.org/location/\" target=\"_blank\">click here</a>. Please note: IYF’s venue is ONLY at Parmarth Niketan, not at any other locations throughout Rishikesh.</p>"
          }
        },
        "question_EtXtq6": {
          "type": "question",
          "settings": {
            "title": "Will I need to show proof of a negative COVID test?",
            "text": "<p>There are currently no COVID protocols in place at the ashram.</p>"
          }
        },
        "question_D7Jdig": {
          "type": "question",
          "settings": {
            "title": "What styles of yoga will be taught at IYF?",
            "text": "<p>Every year we have more than 70+ hours of yoga classes, taught by renowned teachers from around the world practicing multiple styles of Yoga including Kundalini Yoga, Vinyasa Yoga, Iyengar Yoga and Hatha Yoga.  <em>To see the full list of IYF 2025’s presenters,</em> <a href=\"https://internationalyogafestival.org/presenters/\" target=\"_blank\">click here.</a></p>"
          }
        },
        "question_Jnz4KK": {
          "type": "question",
          "settings": {
            "title": "When will the schedule be released?",
            "text": "<p>We’re sure you can appreciate that with the large number of teachers, classes and days that we need to coordinate, it isn’t always possible to confirm an exact date when a schedule will be released. However, it will be shortly before the Festival opens. Look for updates on website and social media.</p><p>List of presenters and schedule is subject to change at short notice.</p>"
          }
        },
        "question_XbDFcA": {
          "type": "question",
          "settings": {
            "title": "Do I need to attend every class?",
            "text": "<p>While we encourage you to participate fully in the Festival, attendance is optional.</p>"
          }
        },
        "question_GjTrHT": {
          "type": "question",
          "settings": {
            "title": "What is included with my ticket?",
            "text": "<p>All registration options include meals, hot drinks, classes, lectures and performances. In an effort to keep our waste to a minimum, please bring a reusable water bottle. We have filtered water machines throughout the Ashram at no charge.</p>"
          }
        },
        "question_HbE6bY": {
          "type": "question",
          "settings": {
            "title": "How do I become a country ambassador?",
            "text": "<p>The first person to register from each country will become a country ambassador.</p>"
          }
        }
      },
