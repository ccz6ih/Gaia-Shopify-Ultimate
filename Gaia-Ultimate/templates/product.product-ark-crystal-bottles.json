    "6a2fb62f-79e7-42de-acea-4e5fab243fb0": {
      "type": "columns-1",
      "blocks": {
        "12d522a9-b741-4d4c-9b79-bb469c9fa36d": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "How do I use the bottle?",
            "text": "",
            "dropdown_text": "<p>Allow 20-30 minutes of ARK crystal treatment before drinking. In addition to frequent daily use, we highly recommend repeating the process overnight.</p>",
            "background_color": "#01b4b4",
            "text_color": "#ffffff"
          }
        },
        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "How much water does an ARK Water Bottle hold?",
            "text": "",
            "dropdown_text": "<p>The bottle holds approximately 750mL or 25 fluid ounces.</p>",
            "background_color": "#01b4b4",
            "text_color": "#ffffff"
          }
        },
        "88fe273d-dad8-4fcb-8e72-e298aeffea83": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Can I put hot liquids in the bottle?",
            "text": "",
            "dropdown_text": "<p>No, you should not put boiling water, hot coffee, or hot tea in the ARK Water Bottle.</p>",
            "background_color": "#01b4b4",
            "text_color": "#ffffff"
          }
        },
        "fada70bb-9ebc-48cd-87d2-ba2bb418ab07": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "How do I clean the bottle?",
            "text": "",
            "dropdown_text": "<p>Remove the ARK crystal first. Hand wash all parts separately, using warm soapy water and a bottle brush, and let air dry. Before reassembling, ensure that all the pieces are completely dry. While filling the bottle, if some water gets into the bottom piece, unscrew it gently, dry it off, and then screw it back on securely.</p>",
            "background_color": "#01b4b4",
            "text_color": "#ffffff"
          }
        },
        "fada70bb-9ebc-48cd-87d2-ba2bb418ab08": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "What is ARK’s Return Policy?",
            "text": "",
            "dropdown_text": "<p>ARK offers a full 30-day satisfaction guarantee for which you may return your ARK crystal in its original packaging and original condition for any reason with a full refund.</p><p>Upon inspection of the returned item(s), ARK Crystal will process your refund to the original payment method.</p>",
            "background_color": "#01b4b4",
            "text_color": "#ffffff"
          }
        }
      },
