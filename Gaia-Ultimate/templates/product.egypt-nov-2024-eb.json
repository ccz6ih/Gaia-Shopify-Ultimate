    "6a2fb62f-79e7-42de-acea-4e5fab243fb0": {
      "type": "columns-1",
      "blocks": {
        "12d522a9-b741-4d4c-9b79-bb469c9fa36d": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Exclusions",
            "text": "",
            "dropdown_text": "<ul><li>International flights (before and after the tour)</li><li>Visas: Travelers must ensure they have the required entry visas. Assistance may be available at Cairo airport depending on your nationality.</li><li>Tipping & gratuities for the Saba Tours team</li><li>Personal expenses, optional activities, and traveler's insurance</li><li>Laundry services</li><li>Any additional services or tours not mentioned in the itinerary</li></ul>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Reservation and Payment",
            "text": "",
            "dropdown_text": "<p>Full payment is required at the time of booking to confirm your reservation.</p>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "88fe273d-dad8-4fcb-8e72-e298aeffea83": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Cancellation and Refunds",
            "text": "",
            "dropdown_text": "<p>All cancellations must be made in writing.</p><ul><li>Before September 17, 2024: Full refund.</li><li>September 18, 2024, to October 2, 2024: 50% refund per person.</li><li>October 3, 2024, to October 17, 2024: 25% refund per person.</li><li>After October 17, 2024: No refund.</li><li>No refunds for unused services are voluntarily foregone.</li></ul>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "8fef7e85-3dbd-4573-b556-4afbf969813d": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Waiver of Responsibility",
            "text": "",
            "dropdown_text": "<p>By signing up, you agree to our Terms, Cancellation and Refunds Policy, and Waiver.</p><p>We are not liable for delays, theft, damage, injury, or any irregularities during the journey.</p>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "fada70bb-9ebc-48cd-87d2-ba2bb418ab07": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Changes",
            "text": "",
            "dropdown_text": "<p>Itinerary subject to change due to flight times or unforeseen circumstances, with the same content guaranteed.</p>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "36d254e6-c118-4eb9-868e-c7838412525e": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Insurance",
            "text": "",
            "dropdown_text": "<p>Travel insurance is highly recommended to cover trip costs, cancellations, medical emergencies, and other unforeseen events.</p>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        }
      },
