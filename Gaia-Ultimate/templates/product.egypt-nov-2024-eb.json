    "5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc3": {
      "type": "testimonials",
      "blocks": {
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-1": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“An extraordinary and unforgettable tour. Can't sing the praise loud enough so many extras and special days.”</p>",
            "author": "Daniela S.",
            "author_info": ""
          }
        },
        "7e9d57d8-1932-46f6-bab6-3585cd9c9507": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“Wonderful to not to worry about any type of logistics; I would recommend 100% the tour to everybody”</p>",
            "author": "Jorge F.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-2": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“You  have to go to Egypt with Gaia because of the special access to Giza without the crowds, it’s a completely different experience to be there alone at sunset when it’s quiet.”</p>",
            "author": "Dana S.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-3": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“The accommodations in Giza and Luxor exceeded all our expectations! The food was fabulous.”</p>",
            "author": "Carmen S.",
            "author_info": ""
          }
        },
        "924d31af-e63b-4b93-bd80-52bca5e71eab": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“The experiences that I had both inside the temples and pyramids were astounding.  Physical energy increases and healings that I experienced on this trip are like none before.” </p>",
            "author": "Susan P.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-4": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“The trip was life changing for me... it was a spiritual calling to be there and the entire experience, people included, was ineffable from start to finish. Life will never be the same for me.”</p>",
            "author": "James C. ",
            "author_info": ""
          }
        }
      },
