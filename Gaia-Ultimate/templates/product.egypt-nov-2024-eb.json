    "05a6ccb4-5008-4aea-bd7b-71a71b3b7286": {
      "type": "text-with-icons",
      "blocks": {
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-1": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What accommodations should I expect?",
            "text": "<p>During your Egypt trip, you can expect 5-star hotel accommodations every night of your trip.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-3": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What's the difference between Double and Single?",
            "text": "<p>Single occupancy means you will have your own room at all accommodations during the trip. Double occupancy means you will share a room with another tour participant at all accommodations during the trip. Roommates are paired based on compatibility within the tour group.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-4": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Do I need to have a vaccine for Egypt travel?",
            "text": "<p>No vaccinations are required upon arrival in Egypt. It's advisable to consult with your healthcare provider before your trip.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-5": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Do you cater to Vegetarians or Vegans?",
            "text": "<p>The upscale hotels and restaurants we visit offer a variety of Egyptian and Western dishes, including ample vegetarian options and some vegan choices.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-7": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What service can I expect when traveling with Mohamed Ibrahim?",
            "text": "<p>Mohamed Ibrahim founded Saba Tours 15 years ago and is a member of the Egyptian Travel Agents Association (E.T.A.A.) and the International Air Transport Association (IATA). You can expect a professional team with extensive experience in tourism. Explore Egypt's wonders with confidence.</p>"
          }
        }
      },
