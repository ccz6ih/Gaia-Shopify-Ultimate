    "a9222eb4-8d59-40cd-9ce4-bad54c0c56ad": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/MohamehIbrahim_a3ba3b43-ea03-44a4-a2cc-5d8ef4d0a5b4.jpg",
        "image_mask": "rounded",
        "image2_mask": "none",
        "subtitle": "",
        "title": "Meet Your Local Guide",
        "heading_size": "h1",
        "text": "<h3>Mohamed Ibrahim</h3><p>Mohamed Ibrahim is an Egyptologist, hieroglyphics expert, and tour guide whose passion for ancient Egypt led him to research this enigmatic place and time in history, seeking answers to deeper questions that mainstream Egyptology doesn’t explore. Born in Memphis, Egypt, Ibrahim grew up around the mysterious ancient pyramid complexes of the Giza plateau, Saqqara, Dahshur, and Abusir. He is an expert on the legendary star gates and healing and energy modalities from ancient Egypt. However, his favorite research to share encompasses the lost technology and civilization of his home country. As a tour guide, Ibrahim has led hundreds of tours accompanied by other world-famous experts.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "33",
        "layout": "left",
        "color_scheme": "1",
        "show_wave": false,
        "divider": false,
        "top_padding": true,
        "bottom_padding": true,
        "lazyload_images": true
      }
    },
    "text_and_image_Fe8dBP": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/Freddy_Silva.jpg",
        "image_mask": "rounded",
        "image2_mask": "none",
        "subtitle": "",
        "title": "Meet Your Special Guest Speaker",
        "heading_size": "h1",
        "text": "<h3>Freddy Silva</h3><p>A bestselling author and leading researcher of alternative history, Freddy Silva is a world renowned expert on crop circles and sacred sites. A pioneer in the research of the interaction between temples and consciousness, Silva is the author of the bestseller \"Secrets in the Fields,\" and director of several documentaries. While lecturing internationally, he was described as \"perhaps the best metaphysical speaker in the world right now.\" He has given keynote presentations at the International Science and Consciousness Conference, and the International Society for the Study of Subtle Energies & Energy Medicine, in addition to appearances on The History Channel, Discovery Channel, BBC, and numerous video documentaries available on Gaia.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "33",
        "layout": "left",
        "color_scheme": "1",
        "show_wave": true,
        "divider": false,
        "top_padding": true,
        "bottom_padding": true,
        "lazyload_images": true
      }
