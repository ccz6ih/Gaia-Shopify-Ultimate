        "2916552a-4524-4aff-acbc-634e4afb6d00": {
          "type": "dropdown",
          "settings": {
            "parent_column": "right",
            "reveal": true,
            "title": "A wellness center that perfectly embodies the majesty of nature & the timeless wisdom of Ayurveda",
            "text": "",
            "image": "shopify://shop_images/DO-TNL-Lawn.png",
            "dropdown_text": "<p>Nestled in the lush greenery of the Sahyadri mountains in Pune, India, is an exceptional wellness center that perfectly embodies the majesty of nature and the timeless wisdom of Ayurveda.</p><p>Managed by a family of Ayurvedic doctors, this idyllic retreat blends rustic, natural beauty with state-of-the-art facilities and warm hospitality to create a space that feels both timeless and contemporary, and offers the perfect canvas for deep healing and purification.</p><p>What better place is there than the majestic mountains of India, to immerse yourself in the healing wisdom of Ayurveda? </p><p>Who better to guide you, than a family of practitioners globally renowned for their skill, knowledge, and sincere care?</p><p>And who better to be by your side, than a supportive community of people with a shared goal for healing through nature’s wisdom?</p>",
            "dropdown_html": "<ul>\n<li>Use this text to answer questions in as much detail as possible for your customers.</li>\n<li>Use this text to answer questions in as much detail as possible for your customers.</li>\n</ul>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        }
      },
