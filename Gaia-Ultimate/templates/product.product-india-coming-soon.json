    "05a6ccb4-5008-4aea-bd7b-71a71b3b7286": {
      "type": "text-with-icons",
      "blocks": {
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-1": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Who should not go for a Panchakarma?",
            "text": "<p>Panchakarma requires you to be able to sit, sometimes for prolonged periods. Therefore we do not recommend attending if you are pregnant, severely ill, or experiencing a debilitating mental health condition that may hold you back from being able to undergo the necessary treatments.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-3": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What’s included in the ticket price?",
            "text": "<p>Your ticket includes the cost of all treatments, three meals a day, accommodation throughout the seven-day retreat, and airport transport to and from the venue. It does not include flights.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-4": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What kind of meals will I receive? What if I have special food requirements?",
            "text": "<p>On each day of the retreat, you’ll receive three vegetarian organic Ayurvedic meals customized to your Dosha and your personal requirements. Upon confirming your spot, we’ll send you a food personalization form for you to fill in.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-5": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Where will I be staying?",
            "text": "<p>You will be staying at our curated Ayurvedic retreat in the Sahyadri mountains of Pune, India. We will provide more details on the venue shortly after you’ve booked your spot.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-7": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "How do I get to the venue?",
            "text": "<p>We provide an airport pick-up service to and from the venue - just get to the airport and we’ll sort out everything else.</p>"
          }
        }
      },
      "block_order": [
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-1",
