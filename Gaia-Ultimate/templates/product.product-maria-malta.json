        "583c7003-2d98-42fd-bbae-515698196ce0": {
          "type": "text",
          "settings": {
            "parent_column": "left",
            "enlarge_text": false,
            "text": "<h3>Travel with a like-minded community</h3><p>Because this tour is limited to the Gaia community, you will have the opportunity to embark on this journey with others who share your curiosity and sense of adventure. </p>"
          }
        }
