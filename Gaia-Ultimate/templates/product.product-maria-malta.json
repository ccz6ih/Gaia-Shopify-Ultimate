    "05a6ccb4-5008-4aea-bd7b-71a71b3b7286": {
      "type": "text-with-icons",
      "blocks": {
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-1": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What is included in the tour package?",
            "text": "<p><br/>The tour includes expert guidance by Maria Wheatley, transportation from Hotel Europa to all sites, dowsing tuition, interaction with Earth energies, and ferry costs to Gozo. Accommodation, meals, and flights are not included, allowing flexibility for participants to arrange their own travel.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-3": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Do I need any prior experience with dowsing or Earth energy work?",
            "text": "<p><br/>No experience is required! Maria Wheatley will provide dowsing tuition and guide participants in connecting with Earth energies at each temple complex.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-4": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "How many megalithic temples are in Malta?",
            "text": "<p><br/>Malta is home to seven megalithic temple sites, recognized as UNESCO World Heritage Sites. These include Ġgantija, Ħaġar Qim, Mnajdra, Tarxien, Ta' Ħaġrat, Skorba, and Borg in-Nadur.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-5": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What is the history behind the megalithic temples of Malta?",
            "text": "<p><br/>Dating back to 3600–2500 BCE, Malta’s megalithic temples are among the oldest free-standing structures, predating the pyramids and Stonehenge. Built by a prehistoric civilization, they were used for religious and astronomical rituals. Their advanced architecture, including corbelled walls, altars, and carvings, showcases the engineering skills of Malta’s early builders.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-7": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Is there a discount for Gaia Members?",
            "text": "<p>Yes! Gaia Members receive a 10% discount!</p>"
          }
        }
      },
