        },
        "6b7d24e3-8868-4464-9e76-e240561f2e17": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "BONUS #3 FOOD MATTERS SIGNATURE PROGRAM",
            "text": "<h3><strong>7 Days of Detoxification Focused Recipes & Shopping Lists</strong></h3><p>Reset your body, say goodbye to bloat, help support your body’s natural detoxification ability with specific recipes, shopping lists, and more designed to help you feel better and lighter instantly.</p><p><strong>Valued at: $199</strong> - Yours Free</p>",
            "image": "shopify://shop_images/cert-bonus-bundle-juice-detox-landscape.jpg",
            "dropdown_text": "",
