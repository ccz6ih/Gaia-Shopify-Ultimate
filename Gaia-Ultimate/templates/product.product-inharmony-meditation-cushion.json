    "5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2": {
      "type": "testimonials",
      "blocks": {
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-1": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“This is a beautiful piece and extremely comfortable. The sound system is excellent and very easy to use. I bought this chair for my sound baths, and it works perfectly!”</p>",
            "author": "Tracey W.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-2": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I bought the meditation cushion to do some vibroacoustic therapy and it delivered plus more!! I had some major anxiety due to stress after the holidays and after doing three sessions on the meditation cushion the anxiety disappeared.”</p>",
            "author": "Sabrina R.",
            "author_info": ""
          }
        },
        "8ec9c348-b7b6-4b67-a1b6-e818230044ab": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I absolutely love my meditation cushion! It’s a wonderful and intuitive design. I love the quality and how user-friendly they made it!” </p>",
            "author": "Lauren M.",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-3": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I think it is an amazing product, I use it everyday. I am an advocate for self help and a practitioner of sound healing and a meditation guide so it works very well with all of my practices.”</p>",
            "author": "Hulu R.",
            "author_info": ""
          }
        }
      },
      "block_order": [
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-1",
