          "settings": {
            "reveal": false,
            "title": "Day 1 · Sunday, June 14, 2026",
            "text": "<p><strong>Arrive in Ft. Lauderdale</strong></p><p>Gather with your retreat pod for a relaxed welcome dinner and begin shifting into the peaceful, joyful energy of the journey ahead.</p>",
            "image": "shopify://shop_images/ft_lauderdale.jpg",
            "dropdown_text": "",
            "dropdown_image_fill": true,
            "background_color": "#03045e",
