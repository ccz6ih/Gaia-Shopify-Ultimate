    "columns_1_PHNHX7": {
      "type": "columns-1",
      "blocks": {
        "dropdown_LkTN4X": {
          "type": "dropdown",
          "settings": {
            "reveal": true,
            "title": "Day 1 – Personal Consciousness",
            "text": "",
            "dropdown_text": "<p>Dive into the 5 Basics of Optimal Health – Water, Food, Rest, Exercise, and Owning Your Power. Discover acts of self-love that fuel sustainable energy and joy, empowering you to thrive and serve those you love. Craft a Personal Vision that’s not just a dream, but a roadmap to a life of balance and purpose.</p>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "dropdown_hUtmDp": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Day 2 – Professional Consciousness",
            "text": "",
            "dropdown_text": "<p>Uncover the essence of your professional being. Whether it’s a career or a calling, define your success on your own terms. Align your pursuits with your deepest values, opening doors to financial freedom and a fulfilling life.</p>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "dropdown_tWzpFp": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Day 3 – Family Consciousness",
            "text": "",
            "dropdown_text": "<p>Explore the intricate web of family dynamics and cultural DNA. Transform communication breakdowns into bridges of understanding and compassion. Elevate your relationships, fostering love, healing, and a profound connection with the global family of Humankind.</p><p>Don’t miss this opportunity to evolve your life. Our intimate setting ensures personalized attention, but it also means spots are limited. Act now to secure your place in this life-changing experience!</p>",
            "background_color": "#2e2767",
            "text_color": "#ffffff"
          }
        },
        "button_ey9UcA": {
          "type": "button",
          "settings": {
            "link": "#register",
            "link_text": "Register Now",
            "link_entitled": "",
            "link_text_entitled": "",
            "align_button": "center"
          }
        }
      },
