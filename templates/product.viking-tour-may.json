    "text_and_image_tERdG8": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/DSC01515_703d66f5-e43d-403d-b999-d3fa7cdad37f.jpg",
        "image_mask": "square",
        "image2_mask": "none",
        "subtitle": "",
        "title": "Reunite with your primal self, enjoy the Norwegian outdoors, and connect with incredible people.",
        "heading_size": "h2",
        "text": "<p><strong>An epic adventure like no other for entrepreneurs, leaders & high-performing humans.</strong></p><p>Most trips, events, or masterminds consist of boiler-plated hotels, conference rooms, and a line-up of impressive speakers… but they aren’t unique, don’t lead to stories of a lifetime, create incredible memories,  or allow for deeper connections, and they don’t end up making an impact on the attendees lives.  </p><p>After attending over 47 high end events and working with high level leaders for 15 years, we know which events stand out in our memories, and which ones are easily forgotten.</p><p>So, we decided to <strong>craft and design this unique experience</strong> to help you have the trip of a lifetime, while breaking through to another level of performance in your life and business. </p><p>Whether you are:</p><ul><li>an adventurer looking to discover Norway in a unique way </li><li>a Viking enthusiast, or just curious to learn about Viking culture and wisdom</li><li>or an entrepreneur / leader who wants to enjoy your success, digitally detox, and have a new peak experience</li></ul><p>…then we have you covered! </p><p></p>",
        "button_label": "Join Now",
        "button_link": "#offer",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "50",
        "layout": "right",
        "color_scheme": "none",
        "show_wave": false,
        "divider": false,
        "top_padding": true,
        "bottom_padding": false,
        "lazyload_images": true
      }
    },
