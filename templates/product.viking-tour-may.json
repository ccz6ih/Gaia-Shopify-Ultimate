    "6db691b5-0534-45ec-97a0-e4a6c1dcff87": {
      "type": "columns-1",
      "blocks": {
        "b3aeaf69-97a6-4e33-af39-c15ac9f01b04": {
          "type": "image",
          "disabled": true,
          "settings": {
