    "05a6ccb4-5008-4aea-bd7b-71a71b3b7286": {
      "type": "text-with-icons",
      "blocks": {
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-1": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What is included in “The Viking Initiation Norway” ticket?",
            "text": "<p>Accommodations (rooms for 1 or 2) in a 3-star quality hotel.</p><p>Food & non-alcoholic drinks are included for all 8 days of the event</p><p>Transportation to and from activities/excursions during the 8 days</p><p>All planned activities, content sessions, and excursions during the 8 days.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-3": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Where will we be staying?",
            "text": "<p>We will be staying at the<a href=\"https://www.gudvangen.com/\"> <span style=\"text-decoration:underline\">Gudvangen Fjordtell</span></a> (3 star hotel) right next to the Viking Village.‍ Featuring Viking style, standard family apartments with a kitchen.</p><p>5 restaurants (À la carte, Seafood, Cafe Gudvangen, Viking Veikro, Buffet restaurant)</p><p>Cafeteria with inside and outside seating for 250 people</p><p>Fully stocked Bar</p><p>Souvenir shop</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-4": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What will the temperature be?",
            "text": "<p>Temperature & Weather in September will be:</p><p>High of 59°F</p><p>Low of 35°F</p><p>More on the humid side</p><p>No snow, potential for rain </p><p>65% clear skies, 35% overcast</p><p>8am - 8pm daylight</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-5": {
          "type": "text_block",
          "disabled": true,
          "settings": {
            "icon": "",
            "title": "Do you cater for Vegetarians or Vegans?",
            "text": "<p>The high end hotels and restaurants we will be visiting serve a variety of Egyptian and Western dishes with plenty of vegetarian options and some vegan options.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-7": {
          "type": "text_block",
          "disabled": true,
          "settings": {
            "icon": "",
            "title": "What service can I expect when traveling with Mohamed Ibrahim?",
            "text": "<p>Mohamed Ibrahim and his company Saba Tours was established 15 years ago and is a member of the Egyptian Travel Agents Association (E.T.A.A)  the International Air Transport Association (IATA). You can expect a professional team with a high level of experience in the field of tourism and touring.</p>"
          }
        }
      },
