    "8fa15309-9d49-4742-841b-e2e9386063cd": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/CS4060_Events_Ancient_Civilizations_Conference_2023_headshots_Erich.png",
        "image_mask": "splat-1",
        "image2_mask": "none",
        "subtitle": "",
        "title": "Meet Your Guide",
        "heading_size": "h1",
        "text": "<h3>Erich von Däniken</h3><p>Erich von Däniken<strong> </strong>is a world-renowned author of 45 books, including <em>Chariots of the Gods</em>, <em>Confessions of an Egyptologist, and Evolution is Wrong</em>. For over 50 years, he has pursued the theory that extraterrestrials may have visited Earth in the remote past. Von Däniken is an avid researcher and traveler who is fluent in four languages, averaging 100,000 miles per year to examine phenomena in remote places. </p><p>He has contributed to numerous film and TV productions and won instant fame when the television special <em>In Search of Ancient Astronauts </em>aired. Von Däniken has appeared in the Gaia Original series <em>Ancient Civilizations</em> and <em>Deep Space</em> and is the host of Gaia’s <em>Beyond the Legend</em> and <em>The Gods Were Astronauts</em>. His research organization, A.A.S. R.A. (Archaeology, Astronautics & SETI Research Association), has an international member base of around 10,000. </p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "33",
        "layout": "left",
        "color_scheme": "1",
        "show_wave": true,
        "divider": false,
        "top_padding": true,
        "bottom_padding": true,
        "lazyload_images": true
      }
    },
    "a9222eb4-8d59-40cd-9ce4-bad54c0c56ad": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/MohamehIbrahim_a3ba3b43-ea03-44a4-a2cc-5d8ef4d0a5b4.jpg",
        "image_mask": "splat-1",
        "image2_mask": "none",
        "subtitle": "",
        "title": "Meet Your Guide",
        "heading_size": "h1",
        "text": "<h3>Mohamed Ibrahim</h3><p>Mohamed Ibrahim is an Egyptologist, hieroglyphics expert, and tour guide whose passion for ancient Egypt led him to begin researching this enigmatic place and time in history, looking for answers to deeper questions that mainstream Egyptology doesn’t explore. Born in Memphis, Egypt, Ibrahim grew up around the mysterious ancient pyramid complexes of the Giza plateau, Saqqara, Dahshur, and Abusir. He is an expert on the legendary star gates, plus healing and energy modalities from ancient Egypt. But his favorite research to share encompasses the lost technology and civilization of his home country. As a tour guide, Ibrahim has led hundreds of tours accompanied by other world-famous experts.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "33",
        "layout": "left",
        "color_scheme": "1",
        "show_wave": true,
        "divider": false,
        "top_padding": true,
        "bottom_padding": true,
        "lazyload_images": true
      }
    },
