        "template--21473222754625__e348726c-dfa1-4b3a-a236-dff330f40c17-text-1": {
          "type": "text",
          "settings": {
            "parent_column": "left",
            "enlarge_text": true,
            "text": "<p>The goal of this training is to <strong>show you how a yoga lifestyle and the commonalities of longevity combine</strong> into a tried-and-true package to add years to your life<br/></p>"
          }
