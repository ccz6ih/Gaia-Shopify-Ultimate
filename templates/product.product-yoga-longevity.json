    "6a2fb62f-79e7-42de-acea-4e5fab243fb0": {
      "type": "columns-1",
      "blocks": {
        "12d522a9-b741-4d4c-9b79-bb469c9fa36d": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Who is this course for?",
            "text": "",
            "dropdown_text": "<p>This course is for anyone who is interested in exploring practices for longevity. All ages are encouraged to join in!</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Are there any prerequisites for this course?",
            "text": "",
            "dropdown_text": "<p>No. All that’s required is curiosity and a desire to learn.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "fada70bb-9ebc-48cd-87d2-ba2bb418ab07": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Is this course suitable for all physical activity?",
            "text": "",
            "dropdown_text": "<p>Yes. As in any learning environment, you are encouraged to identify your unique learning goals and work in a way that honors and respects your ability and intention.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "36d254e6-c118-4eb9-868e-c7838412525e": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "What props will I need?",
            "text": "",
            "dropdown_text": "<p>If possible, it will be helpful to have yoga blocks, a blanket, and a bolster or pillow available. You may also want access to an outdoor space for walking meditation.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "64c54989-1338-47b7-bd63-ddfa422511b7": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Can I get continuing education hours if I’m a registered teacher with Yoga Alliance?",
            "text": "",
            "dropdown_text": "<p>Yes, this course is eligible for eight Continuing Education hours with Yoga Alliance, but in order to receive them you will need to complete all sessions.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "19434ac0-1bc8-4fa7-9407-033dd509cb20": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Do I need to be a Yoga International member to take this course?",
            "text": "",
            "dropdown_text": "<p>No. You must create an account to access the course materials but you do not need to pay for a membership.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "195adf6e-7d69-4458-9adb-eaa295bb77f4": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Is the course all lecture based?",
            "text": "",
            "dropdown_text": "<p>No. Each section also includes practices that will consist of breathwork, meditation, journaling, or asana.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "933b0ea5-c150-4405-ab9b-c75d4ef3384a": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Are there any live sessions?",
            "text": "",
            "dropdown_text": "<p>No, all content is prerecorded and self-paced!</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "e44c6cb7-2bbb-4f0e-a4da-3083f0a9007b": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Will I have lifelong access to the course?",
            "text": "",
            "dropdown_text": "<p>Yes. The entire course will be available in perpetuity.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "df0040ab-a4ee-46ae-90ec-abfe3c590ce8": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "How long does it take to complete this course? Is there a deadline to finish it?",
            "text": "",
            "dropdown_text": "<p>The course is eight hours, but the total time to complete it may be longer due to its self-paced nature. There is no deadline for completion.</p>",
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        }
      },
