<div class="page-width page-width--tiny page-content">
  <div class="form-vertical">
    <h3 style="text-align: center">{{ 'customer.login.already_member' | t }}</h3>
    <p>&nbsp;</p>
    <button class="btn btn--full" onclick="handleLoginRedirect()">
      {{ 'customer.login.sign_in_gaia' | t }}
    </button>
  </div>
  <div class="form-vertical product__policies rte-setting" style="text-align: center">
    <p>
    {{ 'customer.login.dont_have_account' | t }} <a href="https://www-stg-4b2c19.gaia.com/go?sku=G%201M%20TS&utm_source=marketplace">{{ 'customer.login.sign_up' | t }}</a>
    </p>
  </div>
</div>

<script>
function handleLoginRedirect() {
  const urlParams = new URLSearchParams(window.location.search);
  const returnUrl = urlParams.get('return_url');
  const baseUrl = 'https://www-stg-4b2c19.gaia.com/mp-login';
  const redirectPath = returnUrl ? decodeURIComponent(returnUrl) : '/account';
  const fullRedirectUrl = `${baseUrl}?redirect=${encodeURIComponent(redirectPath)}`;
  window.location.href = fullRedirectUrl;
}
</script>
