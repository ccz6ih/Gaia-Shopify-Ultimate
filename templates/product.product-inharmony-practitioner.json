      "blocks": {
        "template--21433204572481__610597e9-bbb0-4b12-86e2-895892d04535-text-1": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>Prioritizing your health and wellness is crucial to feeling better, doing more, and living life to the fullest. Our mission is to aid others in achieving the transformative health benefits we've experienced by making our technology widely accessible. With our patented system, which includes vibroacoustic therapy equipment you can swiftly and comfortably attain a deeply relaxed state through advanced sound and vibration therapies.</p>"
          }
        }
      },
      "block_order": [
