      "blocks": {
        "74639dea-c061-4239-9dcd-c23cbe256242": {
          "type": "heading",
          "settings": {
            "title": "This training introduces you to the principals,practices, and historical background that underlie iRest Yoga Nidra as a comprehensivepath of mediation.",
            "heading_size": "h1"
          }
        },
        "43f60cfc-5d20-42d4-9008-f863931b04d4": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><strong>You’ll learn: </strong></p>"
