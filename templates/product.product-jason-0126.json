    "text_columns_84z3z7": {
      "type": "text-columns",
      "blocks": {
        "text_block_BMVyhV": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "rounded",
            "image_width": 320,
            "title": "",
            "heading_size": "h3",
            "text": "<p>Peter Heibloem is a visionary speaker, conscious entrepreneur, and devoted father of five, living with his wife Roxanne on the beautiful Sunshine Coast, Australia.<br/><br/>With a background in Commerce and a natural talent for communication, Peter built a successful career as a business leader and public speaker, launching multiple ventures and co-creating two thriving insurance portfolios alongside Roxanne—both of which they successfully sold. But it was a powerful spiritual awakening that changed the trajectory of Peter’s life.<br/><br/>Feeling called to a greater mission, Peter and Roxanne chose to leave behind the conventional path and dedicate their lives to awakening consciousness and supporting others on their journey of healing and transformation.<br/></p>",
            "align_text": "left",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_kydTWi": {
