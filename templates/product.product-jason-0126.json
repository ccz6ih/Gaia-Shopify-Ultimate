      "blocks": {
        "64c54989-1338-47b7-bd63-ddfa422511b7": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "About Tickets",
            "text": "",
            "dropdown_text": "<p>● <strong>General Admission Ticket Inclusions:</strong></p><p>3-day access to both the in-person event and the livestream.</p><p>● <strong>Livestream Ticket Inclusions:</strong></p><p>3-day access to the <strong>Superhuman </strong>online event.</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        },
        "dropdown_fPhRCc": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "About Deposit & Payments",
            "text": "",
            "dropdown_text": "<p>To secure your spot, a <strong>$750 non-refundable</strong> <strong>down payment</strong> is required.<br/><br/>The remaining balance is split into two equal payments of <strong>$723.50</strong>, due on <strong>December 1, 2025</strong>, and <strong>January 1, 2026</strong>.</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        },
        "dropdown_9NLEEr": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "About Refunds & Cancellations",
            "text": "",
            "dropdown_text": "<p>As outlined in our Terms & Conditions<strong>,</strong> all ticket purchases are <strong>non-refundable</strong> and considered donations. However, the vendor may provide credits toward future events.</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        },
        "12d522a9-b741-4d4c-9b79-bb469c9fa36d": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Is food, airfare, and hotel accommodations included in the price?",
            "text": "",
            "dropdown_text": "<p>While food, airfare and hotel costs are NOT included in the ticket price, there will be a discounted rate for nearby hotel stays. More details on accommodations will be provided closer to the registration deadline.</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        },
        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Do I have to bring anything to the seminar?",
            "text": "",
            "dropdown_text": "<p>Nothing outside of yourself and your willingness to transform and evolve into the best possible YOU!</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        },
        "fada70bb-9ebc-48cd-87d2-ba2bb418ab07": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "How many people are attending the seminar?",
            "text": "",
            "dropdown_text": "<p>This event is open to the first 444 people who sign up.</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        },
        "36d254e6-c118-4eb9-868e-c7838412525e": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "What venue is the retreat happening at? Do I have to stay at a certain hotel?",
            "text": "",
            "dropdown_text": "<p>The retreat is taking place at the James L. Knight Center in Miami, FL. You can chose any hotel nearby that you would like to stay at. However, we have a room block at the Hyatt Regency Miami and will send the booking link upon registering.</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        },
        "dropdown_tM7EyX": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Where can I learn more about the Terms and Conditions for the Transformation event?",
            "text": "",
            "dropdown_text": "<p>You can view the Terms and Conditions/Agreement <a href=\"https://www.jasonshurka.com/transformationtc\"><span style=\"text-decoration:underline\">HERE</span></a></p><p>When you purchase your ticket, that means you agree to our Terms and Conditions.</p>",
            "dropdown_image_fill": true,
            "background_color": "#c2bda9",
            "text_color": "#101123"
          }
        }
      },
