        },
        "2ad230b4-5581-46d8-9996-59367300a74e": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "An introduction to the common language that is used in iRest meditation."
          }
        }
      },
