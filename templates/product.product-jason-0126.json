        },
        "89ba8538-8598-4a52-9e15-e336d32dcd6a": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "Background information on how iRest is drawn from a 38 stage map of meditation that integrates the philosophies of Samkhya, Patanjali, Advaita, and Unqualified Nondual Realization."
          }
        },
        "ecde982d-b265-4d9a-9d45-9930a23b5531": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "About the evidence-based research showing the efficacy of iRest and its use with various psycho-physical issues and populations."
          }
        },
        "c0441649-f49d-4518-bd5a-91a8be8ac72d": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "How to understand iRest as a comprehensive approach to meditation."
          }
        },
        "126b4575-ab8b-4651-a00b-2606b6bb53ac": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "Guidelines regarding the teacher-student relationship and ethical considerations."
          }
        },
        "a1bf180e-6d2e-47e5-b691-c948d3bcfcd8": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "#01b4b4",
            "text": "How to work one-on-one with people in what we call “iRest Co-Meditation Dyads.”"
