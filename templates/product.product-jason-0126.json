    "text_columns_AUEqbM": {
      "type": "text-columns",
      "blocks": {
        "text_block_fXpnKG": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "rounded",
            "image_width": 320,
            "title": "",
            "heading_size": "h3",
            "text": "<p>Aaron Abke is a transformative spiritual teacher bridging The Law of One, Non-Duality, and Spiritual Intelligence to illuminate the path of Self-Realization. His work empowers seekers to awaken into Fourth Density Consciousness—a state of unity, love, and higher awareness.<br/><br/>Born in Silicon Valley and raised in a pastor’s home, Aaron’s journey led him from ministry and theology into a direct, experiential understanding of truth. Following a profound awakening at age 27, he devoted his life to guiding others toward the remembrance of oneness and the realization of the Infinite Self.<br/><br/>Through his online teachings, masterclasses, and workshops, Aaron shares practical wisdom for integrating spiritual awakening into everyday life. His mission is to help humanity embody enlightened consciousness—one heart, one mind, one creation.</p>",
            "align_text": "left",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_mBG3iV": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/Aaron-Abke-mid-shot.png",
