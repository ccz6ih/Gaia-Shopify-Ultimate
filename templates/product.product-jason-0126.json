            "image_width": 410,
            "title": "Aaron Abke",
            "heading_size": "h2",
            "text": "",
            "align_text": "center",
            "button_label": "",
            "button_link": ""
          }
        }
      },
      "block_order": [
        "text_block_fXpnKG",
        "text_block_mBG3iV"
      ],
      "settings": {
        "title": "",
        "heading_size": "h3",
