    "rich_text_t4H4rL": {
      "type": "rich-text",
      "blocks": {
        "heading_7ixc7R": {
          "type": "heading",
          "settings": {
            "title": "Tour Highlights",
            "heading_size": "h0"
          }
        },
        "text_kNHJiC": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>Private access inside the Great Pyramid and Paws of the Sphinx – Meditate in the King’s Chamber during a rare and powerful private ceremony.</p><p>Visit the Grand Egyptian Museum through William’s trained eye.</p><p>Luxor & Karnak Temples – Decode the language of light and sound etched into every wall.</p><p>Temple of Horus at Edfu – Uncover the Starwalker legacy and the blueprint of resurrection.</p><p>Sailing the Nile – Drift down the river of eternity on the exclusive  Sanctuary SunBoat III, surrounded by desert, sky, and stars.</p><p>Sacred Teachings – Daily mystical teaching and amazing historical presentations from William Henry.</p><p>Conscious Community – Travel with a group of like-minded seekers devoted to truth, healing, and cosmic remembrance.</p>"
          }
        },
        "button_xgR3mf": {
          "type": "button",
          "settings": {
            "link": "#offer",
            "link_text": "Sign Up Now"
          }
        },
        "text_kyCnDc": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><strong>Questions? </strong>Connect with our travel manager. 👉 <a href=\"http://www.gaia.com/travelmanager\" target=\"_blank\" title=\"http://www.gaia.com/travelmanager\">Reserve a time.</a></p>"
          }
        }
      },
