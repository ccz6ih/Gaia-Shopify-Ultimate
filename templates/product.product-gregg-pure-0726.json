        "12d522a9-b741-4d4c-9b79-bb469c9fa36d": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Attendee Information",
            "text": "",
            "dropdown_text": "<p><strong>This is an IN-PERSON event only. The program is NOT broadcast online.</strong></p><p>Airfare, transportation, accommodation, meals and extra services are NOT included in the price.</p><p><strong>VENUE: </strong>Denver Center for the Performing Arts – Seawell Ballroom</p><p><strong>ADDRESS: </strong>1101 13th St., Denver, CO 80204</p><p><strong>TIMES:</strong> 9:00 AM to 5:00 PM (Doors open 7.00 AM)</p><p><strong>PROVIDED: </strong>Pocket Folder + Note Pad + Pen</p><p><strong>BREAKS:</strong> Morning, 30 mins. Lunch, 90 mins. Afternoon, 30 mins.</p><p><strong>SEATING: </strong>First-Come, First-Served.</p><p>YOUR NAME will be on the event check-in list, and you will receive a pre-printed name tag.</p><p>TRANSLATION is not provided. The event is in English only.</p><p>✦ By completing your payment, you confirm your registration and acknowledge your agreement to the event’s Terms & Conditions.</p><p>✦ Payments are to be made via credit card or the payment options displayed on the Gaia Marketplace site when purchasing.</p>",
            "dropdown_image_fill": true,
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Cancellation and Refund Policy",
            "text": "",
            "dropdown_text": "<p>Refundable (minus 10%) if canceling before June 1, 2026 <br/>Refundable (minus 20%) if canceling after June 1, 2026 <br/><strong>Non-refundable if canceling after July 1, 2026 </strong></p><p><strong>Note: </strong>If the event is canceled for any reason, you will receive a refund minus a 5% administrative fee. Please submit your cancellation requests in writing via email.</p>",
            "dropdown_image_fill": true,
            "background_color": "#ffffff",
            "text_color": ""
          }
        },
