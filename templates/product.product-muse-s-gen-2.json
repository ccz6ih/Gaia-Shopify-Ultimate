    "5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2": {
      "type": "testimonials",
      "blocks": {
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-1": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I find the app and headband really useful… I love the real-time feedback. Even more fun, I can immediately see the impact on my heart rate variability of my meditation session… Love this product!”</p>",
            "author": "Amanda",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-2": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I love the Muse S… Muse S provides a baseline of data that is helping me track my progress more quickly getting into a deeper state of relaxation and increase the quality of sleep so that once again, I feel refreshed...”</p>",
            "author": "J Daniel",
            "author_info": ""
          }
        },
        "template--20293138153793__5a7cb87a-96ea-4e6b-be7d-e8cbd28c4fc2-testimonial-3": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“Amazing little piece of technology. I don’t know how yo guys do it… Worth the money for sure!”</p>",
            "author": "Ryan",
            "author_info": ""
          }
        }
      },
