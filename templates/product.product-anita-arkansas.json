    "text_and_image_JPgmwm": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/Anita_Moorjani-Headshot2.jpg",
        "image_mask": "portrait",
        "image2_mask": "none",
        "subtitle": "",
        "title": "Anita Moorjani",
        "heading_size": "h1",
        "text": "<p><strong>Anita Moorjani </strong>is a renowned author and spiritual speaker known for her transformative journey beyond the brink of death. While living in Hong Kong, Anita battled end-stage cancer before experiencing a remarkable near-death experience (NDE) that shifted her perspective on life. Her bestselling memoir,“Dying to Be Me”, chronicles her profound journey and miraculous healing. It’s popularity established her as the premierNDEexpert. A beacon of inspiration, Anita travels the world sharing her insights on self-love, consciousness, and the interconnectedness of all things. Her teachings empower others to embody the highest version of themselves and live vibrant, authentic lives. Anita continues to be a guiding light in the realm of spiritual exploration.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "33",
        "layout": "right",
        "color_scheme": "1",
        "show_wave": false,
        "divider": false,
        "top_padding": true,
        "bottom_padding": true,
        "lazyload_images": true
      }
    },
    "text_and_image_9Ditee": {
      "type": "text-and-image",
      "disabled": true,
      "settings": {
        "image": "shopify://shop_images/Screenshot_2024-06-03_at_9.41.56_AM.png",
        "image_mask": "rounded",
        "image2_mask": "none",
        "subtitle": "",
        "title": "",
        "heading_size": "h1",
        "text": "<h3><strong>Hanaa Abd Elkhaleq</strong></h3><p>Graduated from the Faculty of Archaeology at Cairo University, specializing in Egyptian Antiquities. Discovered that working in the field of archaeology is not her passion and would not significantly add to her career growth. Consequently, she pursued a diploma in Tourist Guidance from the Faculty of Tourism and Hotels at Helwan University. She has been working as a tour guide since 2003, gaining extensive experience in the field and thoroughly enjoying the journey.</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "33",
        "layout": "left",
        "color_scheme": "1",
        "show_wave": true,
        "divider": false,
        "top_padding": false,
        "bottom_padding": true,
        "lazyload_images": true
      }
    },
