    "05a6ccb4-5008-4aea-bd7b-71a71b3b7286": {
      "type": "text-with-icons",
      "blocks": {
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-1": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What accommodations should I expect?",
            "text": "<p>Throughout your stay at the Silver Birch Spring Retreat, anticipate luxurious and carefully selected accommodations, ensuring comfort and rejuvenation every evening.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-3": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What's the difference between Single Supplement and Silver Birch Spring Retreat?",
            "text": "<p>Single Supplement guarantees you a private room for the duration of the retreat, while Silver Birch Spring Retreat offers an immersive experience amidst stunning natural surroundings, with options for both single and shared accommodations.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-4": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Do I need to have a vaccine to attend the Silver Birch Spring Retreat",
            "text": "<p>No specific vaccinations are required for participation. However, it's recommended to consult with your healthcare provider prior to the retreat.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-5": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "Do you cater for Vegetarians or Vegans",
            "text": "<p>Yes, the Silver Birch Spring Retreat offers a variety of culinary options including vegetarian and vegan dishes. Our selected accommodations and dining venues provide a range of nutritious and delicious meals to suit diverse dietary preferences.</p>"
          }
        },
        "template--20197640634689__05a6ccb4-5008-4aea-bd7b-71a71b3b7286-text_block-7": {
          "type": "text_block",
          "settings": {
            "icon": "",
            "title": "What service can I expect when attending the Silver Birch Spring Retreat?",
            "text": "<p>At the Silver Birch Spring Retreat, you can anticipate a dedicated team with extensive expertise in organizing transformative retreat experiences. Our retreat is meticulously curated to ensure professionalism, exceptional service, and a seamless journey for all participants.</p>"
          }
        }
      },
