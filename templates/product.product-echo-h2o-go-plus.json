        "template--20868296540481__e2a98328-4518-42cd-a5fb-0970de2060ab-text-1": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>Benefits of drinking hydrogen water</p><p>Experience the benefits of advanced molecular hydrogen with hydrogen-enriched water. Our breakthrough hydration technology delivers powerful antioxidants that optimize cellular health, improve focus, and increase longevity. Say goodbye to ordinary water and embrace a healthier lifestyle with our hydrogen-enriched water. Order now and start feeling the difference!</p>"
          }
        },
        "3950cba8-7061-43dd-a1db-229bd0e1346b": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "",
            "text": "<strong>Boosts Antioxidant Activity</strong>: Hydrogen water is rich in antioxidants, which neutralize free radicals that can cause cellular damage and inflammation."
          }
        },
        "022a1968-4d58-4222-b945-1f1c774d85a7": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "",
            "text": "<strong>Reduces Inflammation</strong>: The antioxidants in hydrogen water help reduce inflammation throughout the body, which is linked to many chronic health conditions."
          }
        },
        "757f0355-780b-4949-be97-278466cbbf10": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "",
            "text": "<strong>Improves Athletic Performance</strong>: Drinking hydrogen water before and after exercise can improve endurance, reduce muscle fatigue, and speed up recovery time."
          }
        },
        "9e2c197a-1f22-4883-9aab-6558f30856c0": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "",
            "text": "<strong>Supports Brain Health</strong>: Hydrogen water has been shown to improve cognitive function, memory, and mood by reducing oxidative stress and inflammation in the brain."
          }
        },
        "99aab274-c389-4bac-a685-79925d0ca475": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "",
            "text": "<strong>Enhances Skin Health</strong>: Hydrogen water can help reduce oxidative stress and inflammation in the skin, which can lead to a more youthful and radiant appearance."
          }
        },
        "4484672a-4afd-4a9c-8fe4-9580243a6331": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "",
            "text": "<strong>Boosts Immune Function</strong>: The antioxidants in hydrogen water can help support immune function by reducing oxidative stress and inflammation throughout the body."
          }
        },
        "7d6d87ef-6328-4e7b-84b6-833004d09a5b": {
          "type": "sales_point",
          "settings": {
            "icon": "checkmark-no-circle",
            "icon_color": "",
            "text": "<strong>Supports Weight Loss</strong>: Hydrogen water can help support weight loss efforts by reducing oxidative stress and inflammation, which are linked to obesity."
          }
