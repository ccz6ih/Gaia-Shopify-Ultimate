        "a5c74000-1b77-4b3f-8cd8-e2b144865401": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<h4>“I'm so grateful to have participated in the Get Loved Up LA Yoga Teaching Training. The training is like none other, it goes beyond the basics you'd find in a typical yoga training program to include a social justice component. Koya Webb is an outstanding teacher who has provided quality instruction while nurturing and fostering community among her students in an intensive setting. Hands down there's no one else I would want to receive this training from.”<\/h4><p><strong> - Kerri Sawyer<\/strong><\/p>"
          }
        }
      },
      "block_order": [
        "a5c74000-1b77-4b3f-8cd8-e2b144865401"
      ],
