    "6a2fb62f-79e7-42de-acea-4e5fab243fb0": {
      "type": "columns-1",
      "blocks": {
        "12d522a9-b741-4d4c-9b79-bb469c9fa36d": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Do I need to be an advanced yoga practitioner to enroll?",
            "text": "",
            "dropdown_text": "<p>No, this training is designed for practitioners of all levels. Whether you’re new to yoga or have years of experience, this course will deepen your practice and teaching skills.<\/p>",
            "dropdown_image_fill": true,
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "8b288a22-fe25-4939-a8bc-2bd82abe3281": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Is the 200-hour training recognized by Yoga Alliance?",
            "text": "",
            "dropdown_text": "<p>Yes, upon successful completion, you’ll be eligible to register with Yoga Alliance as a RYT-200 (Registered Yoga Teacher, 200-hour level).<\/p>",
            "dropdown_image_fill": true,
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "fada70bb-9ebc-48cd-87d2-ba2bb418ab07": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "Will I be qualified to teach yoga after completing this course?",
            "text": "",
            "dropdown_text": "<p>Yes, you will be fully certified to teach yoga and equipped with the skills to lead classes confidently in studios, online, or privately.<\/p>",
            "dropdown_image_fill": true,
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "36d254e6-c118-4eb9-868e-c7838412525e": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "How long does the course take to complete?",
            "text": "",
            "dropdown_text": "<p>The training typically spans 4-8 weeks.<\/p>",
            "dropdown_image_fill": true,
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        },
        "64c54989-1338-47b7-bd63-ddfa422511b7": {
          "type": "dropdown",
          "settings": {
            "reveal": false,
            "title": "What if I can’t finish in 8 weeks or even a year because life happens?",
            "text": "",
            "dropdown_text": "<p>Don’t worry. We understand life happens You’ll have lifetime access to the materials, so you can revisit the certification at your convenience.<\/p>",
            "dropdown_image_fill": true,
            "background_color": "#7e4592",
            "text_color": "#ffffff"
          }
        }
      },
