      "blocks": {
        "template--20086275309889__3124092b-a473-448b-b237-7c9b098cd472-text-1": {
          "type": "text",
          "settings": {
            "parent_column": "right",
            "enlarge_text": true,
            "text": "<p><\/p><p><\/p><p><strong>{{ product.title }}<\/strong><\/p><p>Our 200-hour Yoga Teacher Training is designed for anyone ready to deepen their personal practice and learn the art of teaching yoga. With a focus on alignment, breathwork and mindfulness, this certification will empower you with the tools to lead inspiring yoga classes and live a life of wellness and balance. Whether you want to teach professionally or enrich your own practice, this training offers a holistic foundation in yoga philosophy, anatomy and self-care. At Get Loved Up, we help you connect with your true purpose and use yoga as a tool for personal and collective transformation.<\/p>"
          }
        },
