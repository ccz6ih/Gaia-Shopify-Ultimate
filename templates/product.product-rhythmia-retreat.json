          "settings": {
            "parent_column": "left",
            "enlarge_text": false,
            "text": "<h3>Travel with a like-minded community</h3><p>This is your opportunity to embark on a life transformation with others who are ready to do the same. \t</p>"
          }
        },
        "5f9f4cc3-2ea8-4cd4-9626-a8036b722fe6": {
