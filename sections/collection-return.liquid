{% if collection %}
  <div class="return-section color-scheme-{{ section.settings.color_scheme }}">
    {%- if section.settings.color_scheme != 'none' -%}
      {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme -%}
    {%- endif -%}
    <div class="page-width text-center">
      <a href="{% if collection.handle == 'frontpage' %}/{% else %}{{ collection.url }}{% endif %}" class="btn return-link">
      {% comment %}
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-arrow-left" viewBox="0 0 50 15"><path d="M50 5.38v4.25H15V15L0 7.5 15 0v5.38z"/></svg>
        {% endcomment %}
        {{ 'products.general.collection_return' | t: collection: collection.title }}
        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="8" viewBox="0 0 12 8" fill="none">
<path d="M1 3.5C0.723858 3.5 0.5 3.72386 0.5 4C0.5 4.27614 0.723858 4.5 1 4.5L1 3.5ZM11.3536 4.35355C11.5488 4.15829 11.5488 3.84171 11.3536 3.64645L8.17157 0.464467C7.97631 0.269205 7.65973 0.269204 7.46447 0.464467C7.2692 0.659729 7.2692 0.976311 7.46447 1.17157L10.2929 4L7.46447 6.82843C7.2692 7.02369 7.2692 7.34027 7.46447 7.53553C7.65973 7.7308 7.97631 7.7308 8.17157 7.53553L11.3536 4.35355ZM1 4.5L11 4.5L11 3.5L1 3.5L1 4.5Z" fill="#26B4B2"/>
</svg>
      </a>
    </div>
  </div> 
{% endif %}

{% schema %}
{
  "name": "t:sections.collection-return.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.collection-return.settings.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.collection-return.settings.color_scheme.label",
      "default": "2",
      "options": [
        {
          "value": "none",
          "label": "t:sections.collection-return.settings.color_scheme.options.none.label"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
