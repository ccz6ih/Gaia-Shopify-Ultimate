{{ 'ign-video-feature-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ign-section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .ign-section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Color overrides using direct color settings */
  .ign-video-feature-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }
  
  .ign-video-feature-section-{{ section.id }} .ign-video-feature-title {
    color: {{ section.settings.heading_color }};
  }
  
  .ign-video-feature-section-{{ section.id }} .ign-video-feature-subtitle,
  .ign-video-feature-section-{{ section.id }} .ign-feature-description,
  .ign-video-feature-section-{{ section.id }} .ign-video-credit {
    color: {{ section.settings.text_color }};
  }
  
  .ign-video-feature-section-{{ section.id }} .ign-feature-title {
    color: {{ section.settings.feature_heading_color }};
  }
  
  .ign-video-feature-section-{{ section.id }} .ign-feature-item {
    background-color: {{ section.settings.feature_bg_color }};
    border-color: {{ section.settings.feature_border_color }};
  }
  
  .ign-video-feature-section-{{ section.id }} .ign-video-control-btn {
    background-color: {{ section.settings.control_bg_color }};
  }
  
  .ign-video-feature-section-{{ section.id }} .ign-video-control-btn svg {
    color: {{ section.settings.control_icon_color }};
  }
{%- endstyle -%}

<div class="ign-video-feature-section ign-video-feature-section-{{ section.id }} gradient ign-section-{{ section.id }}-padding">
  <div class="page-width">
    
    {%- comment -%} Section Header {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ign-video-feature-header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="ign-video-feature-title {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="ign-video-feature-subtitle rte">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ign-video-feature-grid">
      
      {%- comment -%} LEFT SIDE - Video {%- endcomment -%}
      <div class="ign-video-feature-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.video_url != blank -%}
          <div class="ign-video-container" id="ign-video-container-{{ section.id }}">
            <video
              id="ign-video-{{ section.id }}"
              class="ign-video-player"
              {% if section.settings.enable_video_looping %}loop{% endif %}
              muted
              playsinline
              preload="metadata"
              {% if section.settings.cover_image %}
                poster="{{ section.settings.cover_image | image_url: width: 1500 }}"
              {% endif %}
            >
              <source src="{{ section.settings.video_url }}" type="video/mp4">
              Your browser does not support the video tag.
            </video>
            
            {%- comment -%} Video Controls {%- endcomment -%}
            <div class="ign-video-controls">
              <button
                type="button"
                class="ign-video-control-btn ign-play-pause-btn"
                data-video-id="ign-video-{{ section.id }}"
                aria-label="Play/Pause video"
              >
                <svg class="ign-icon-play" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <svg class="ign-icon-pause" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                  <rect x="6" y="4" width="4" height="16"></rect>
                  <rect x="14" y="4" width="4" height="16"></rect>
                </svg>
              </button>
              
              <button
                type="button"
                class="ign-video-control-btn ign-mute-btn"
                data-video-id="ign-video-{{ section.id }}"
                aria-label="Mute/Unmute video"
              >
                <svg class="ign-icon-sound-on" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                </svg>
                <svg class="ign-icon-sound-off" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
              </button>
            </div>
          </div>
          
          {%- comment -%} Video Credit {%- endcomment -%}
          {%- if section.settings.video_credit != blank -%}
            <div class="ign-video-credit">
              {{ section.settings.video_credit }}
            </div>
          {%- endif -%}
          
        {%- elsif section.settings.cover_image != blank -%}
          <div class="ign-video-placeholder">
            <img
              src="{{ section.settings.cover_image | image_url: width: 1100 }}"
              alt="{{ section.settings.cover_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.cover_image.width }}"
              height="{{ section.settings.cover_image.height }}"
            >
          </div>
        {%- else -%}
          {%- comment -%} Fallback placeholder {%- endcomment -%}
          <div class="ign-video-placeholder ign-video-placeholder-empty">
            <div class="ign-video-placeholder-content">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <p>Upload a video or cover image</p>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT SIDE - Feature Grid {%- endcomment -%}
      <div class="ign-feature-grid-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="ign-feature-grid">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'feature_item' -%}
                <div class="ign-feature-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <div class="ign-feature-icon">
                      <img
                        src="{{ block.settings.icon | image_url: width: 120 }}"
                        alt="{{ block.settings.icon.alt | escape }}"
                        loading="lazy"
                        width="60"
                        height="60"
                      >
                    </div>
                  {%- endif -%}
                  
                  <div class="ign-feature-content">
                    {%- if block.settings.title != blank -%}
                      <h3 class="ign-feature-title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <div class="ign-feature-description rte">
                        {{ block.settings.description }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    const video = document.getElementById('ign-video-{{ section.id }}');
    if (!video) return;

    const playPauseBtn = document.querySelector('[data-video-id="ign-video-{{ section.id }}"].ign-play-pause-btn');
    const muteBtn = document.querySelector('[data-video-id="ign-video-{{ section.id }}"].ign-mute-btn');
    
    if (!playPauseBtn || !muteBtn) return;
    
    const iconPlay = playPauseBtn.querySelector('.ign-icon-play');
    const iconPause = playPauseBtn.querySelector('.ign-icon-pause');
    const iconSoundOn = muteBtn.querySelector('.ign-icon-sound-on');
    const iconSoundOff = muteBtn.querySelector('.ign-icon-sound-off');

    // Play/Pause functionality
    playPauseBtn.addEventListener('click', function() {
      if (video.paused) {
        video.play();
        iconPlay.style.display = 'none';
        iconPause.style.display = 'block';
      } else {
        video.pause();
        iconPlay.style.display = 'block';
        iconPause.style.display = 'none';
      }
    });

    // Mute/Unmute functionality
    muteBtn.addEventListener('click', function() {
      if (video.muted) {
        video.muted = false;
        iconSoundOff.style.display = 'none';
        iconSoundOn.style.display = 'block';
      } else {
        video.muted = true;
        iconSoundOff.style.display = 'block';
        iconSoundOn.style.display = 'none';
      }
    });

    // Auto-hide controls when playing
    let controlsTimeout;
    const container = document.getElementById('ign-video-container-{{ section.id }}');
    
    if (container) {
      container.addEventListener('mousemove', function() {
        container.classList.remove('ign-hide-controls');
        clearTimeout(controlsTimeout);
        if (!video.paused) {
          controlsTimeout = setTimeout(function() {
            container.classList.add('ign-hide-controls');
          }, 2000);
        }
      });

      container.addEventListener('mouseleave', function() {
        if (!video.paused) {
          container.classList.add('ign-hide-controls');
        }
      });
    }

    // Update icons based on video state
    video.addEventListener('play', function() {
      iconPlay.style.display = 'none';
      iconPause.style.display = 'block';
    });

    video.addEventListener('pause', function() {
      iconPlay.style.display = 'block';
      iconPause.style.display = 'none';
    });
  })();
</script>

{% schema %}
{
  "name": "IGN Video Feature Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Showcase a video alongside key features in a grid layout. Perfect for product highlights and differentiators."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#191880"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1B1B57"
    },
    {
      "type": "color",
      "id": "feature_bg_color",
      "label": "Feature background",
      "default": "#F8F8FB"
    },
    {
      "type": "color",
      "id": "feature_border_color",
      "label": "Feature border",
      "default": "#E5E5E5"
    },
    {
      "type": "color",
      "id": "feature_heading_color",
      "label": "Feature heading color",
      "default": "#191880"
    },
    {
      "type": "color",
      "id": "control_bg_color",
      "label": "Control button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "control_icon_color",
      "label": "Control icon color",
      "default": "#1B1B57"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience the Difference"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Discover features that set us apart and transform your experience</p>"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Upload video to Files and paste the URL here (MP4 recommended)"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image",
      "info": "Displayed while video loads or as fallback"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Loop video",
      "default": false
    },
    {
      "type": "text",
      "id": "video_credit",
      "label": "Video credit (optional)",
      "placeholder": "Video by..."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Recommended: 60x60px PNG with transparency"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Explain how this feature benefits your customers</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IGN Video Feature Grid",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "title": "Premium Quality",
            "description": "<p>Crafted with the finest materials and attention to detail</p>"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Innovative Design",
            "description": "<p>Cutting-edge technology meets thoughtful user experience</p>"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Proven Results",
            "description": "<p>Backed by science and validated by thousands of satisfied customers</p>"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Easy to Use",
            "description": "<p>Simple setup and intuitive operation for everyone</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}