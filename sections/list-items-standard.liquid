
{% if product.metafields.list-item-key.propCurrent != blank %}
<div class="list-items-for-tabs-parent">
    <div class="list-items-for-tabs-holder">
        <div class="list-items-for-tab-el">
            <ul>
                {% for listItem in product.metafields.list-item-key.propCurrent %}
                <li {% if forloop.first%} default {%endif %} class="tabItem">
                    <a href="#{{ product.metafields.id-of-bl.type[forloop.index0]}}">
                    {{listItem}}
                    </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
<script>
    $(".tabItem").click(function(){
    $(".tabItem").removeAttr("default")
        $(this).attr("default", "default")
    })
</script>
 {% endif %}
