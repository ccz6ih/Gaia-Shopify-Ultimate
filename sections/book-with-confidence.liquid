<div class="book-with-confidence-parent">
    <div class="book-with-cofidence-holder">
      {% if product.metafields.bk-title-c.key != blank %}
        <h2 class="title-book-with-confidence blockTitleOfWidgets">
            {{ product.metafields.bk-title-c.key}}
        </h2>
      {% endif %}
      {% comment %}
      {% if product.metafields.ful-bok-cap.key != blank %}
        <div class="fullCapacity-modules fulCap-Desktop">
          {{product.metafields.ful-bok-cap.key }}
      </div>
        {% endif %}

        {% if product.metafields.ful-bok-cap-m.key != blank %}
          <div class="fullCapacity-modules fulCap-Mobile">
            {{product.metafields.ful-bok-cap-m.key}}
        </div>
          {% endif %}
          {% endcomment %}
        <div class="book-with-cofidence-el">
            {% for con-block in product.metafields.confidence-icon.key %}
                <div class="book-with-confidence-inside">
                    <div class="iconHolder-of-confidence">
                        <img src="{{con-block}}" class="icon-above-confidence-block-texts" alt="{{con-block.alt}}" />
                    </div>
                    <div class="textsHolder-for-confidence">
{% if product.metafields.confidence-title.key[forloop.index0] != blank %}
                        <h2 class="ConfidenceTitleMain">{{product.metafields.confidence-title.key[forloop.index0]}}</h2>
                      {% endif %} 

              {% comment  %} 
                      {% if product.metafields.book-with-conf-.full-cap-title[forloop.index0] != blank %}
                        <div class="fullCapacity-modules fulCap-Desktop">
                          {{product.metafields.book-with-conf-.full-cap-title[forloop.index0] }}
                      </div>
                        {% endif %}
                 
                        {% if product.metafields.book-with-conf-m.full-cap-title[forloop.index0] != blank %}
                          <div class="fullCapacity-modules fulCap-Mobile">
                            {{product.metafields.book-with-conf-m.full-cap-title[forloop.index0]}}
                        </div>
                          {% endif %}

                         
                      {% if product.metafields.full-capacity-body.info-full[forloop.index0] != blank %}
                        <div class="fullCapacity-modules fulCap-Desktop">
                          {{product.metafields.full-capacity-body.info-full[forloop.index0] }}
                      </div>
                        {% endif %}

                        {% if product.metafields.full-capacity-body-m.info-full[forloop.index0] != blank %}
                          <div class="fullCapacity-modules fulCap-Mobile">
                            {{product.metafields.full-capacity-body-m.info-full[forloop.index0]}}
                        </div>
                          {% endif %}
            {% endcomment %}
                 
                        {% if product.metafields.confidence-info.key[forloop.index0] != blank %}
                        <p class="ConfidenceBodyText">{{product.metafields.confidence-info.key[forloop.index0]}}</p>
                        {% endif %}

                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
    {
      "name": "Book With Confedence Meta",
      "class": "book-with-confidence",
      "settings": [

      
       {
          "type": "text",
          "id": "title",
          "label": "Book With Confidence Section title",
          "default": "Book With Confidence"
        }
       
      ],
      "presets": [
        {
            "name": "Book With Confedence"
                  }
      ]
    } 
  {% endschema %}  