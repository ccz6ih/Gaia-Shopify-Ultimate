                          </svg></span>{{ product.metafields.date-tab-location.key[forloop.index0] }}</span>
                         
                      

                          {% if product.metafields.ful-cap-intro.info-key[forloop.index0] != blank %}
                            <div class="fullCapacity-modules fulCap-Desktop">
                              {{product.metafields.ful-cap-intro.info-key[forloop.index0] }}
                          </div>
                            {% endif %}

                            {% if product.metafields.ful-cap-intro-m.info-key[forloop.index0] != blank %}
                              <div class="fullCapacity-modules fulCap-Mobile">
                                {{product.metafields.ful-cap-intro-m.info-key[forloop.index0] }}
                            </div>
                              {% endif %}
                           
                              {% if product.metafields.it-custom.check-show[forloop.index0] == "true" %}
                              <h3 class="inclusions-items-title">Inclusions:</h3>
                              {% endif %}

                              {% if product.metafields.inclusions.type[forloop.index0] != blank %}
                              <div class="fullCapacity-modules fulCap-Desktop">
                                {{ product.metafields.inclusions.type[forloop.index0] }}
                            </div>
                              {% endif %}

                              {% if product.metafields.inclusions-m.type[forloop.index0] != blank %}
                                <div class="fullCapacity-modules fulCap-Mobile">
                                  {{product.metafields.inclusions-m.type[forloop.index0] }}
                              </div>
                                {% endif %}

                         
                            </div>
                            </div>
                          </li>
                        {% endfor %}
                      </ul>
                </div>
              </div>
        </div>
    </div>
</div>
<script>
    const splide = new Splide('.tabsSplider');

    splide.on('pagination:mounted', function (data) {
        // Add your class to the UL element
        data.list.classList.add('splide__pagination--custom');

        // `items` contains all dot items
        data.items.forEach(function (item) {
            // Correctly concatenate "Day" with the numeric page index
            item.button.textContent = 'Day ' + (item.page + 1);
        });
    });

    splide.mount();
</script>

{% schema %}
    {
      "name": "Itenarary-tabs",
      "class": "itenarary-pdp-tabs",
      "settings": [

      
       {
          "type": "text",
          "id": "title",
          "label": "Itenarary",
          "default": "Itenarary"
        }
       
      ],
      "presets": [
        {
            "name": "Itenarary-tabs",
            "category": "Product Page Widgets"
        }
      ]
    } 
{% endschema %}  