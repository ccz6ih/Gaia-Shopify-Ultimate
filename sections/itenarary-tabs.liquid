                            <div class="hold-the-tab-details">
                            <div class="image-block-for-tab">
                                <img loading="eager" src="{{ tab }}" class="imageInDayTab" alt="{{ tab.alt }}" />
                            </div>
                            <div class="info-for-day-tab">
                            <h2 class="dayLocationEvent">{{ product.metafields.location-in-the-day.tab[forloop.index0] }}</h2>
