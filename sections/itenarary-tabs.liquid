<div class="itenarary-tabs-parent">
    <div class="itenarary-tabs-holder">
         {% comment %} Default {% endcomment %}
      {% if product.metafields.it-sec-title-.key != blank %}
        <h2 class="itenarary-blocks-el">
            {{product.metafields.it-sec-title-.key}}       
        </h2>
      {% endif %}
         {% comment %} 
      {%if product.metafields.ite-ful-cap.title-desktop != blank %}
        <div class="fullCapacity-modules fulCap-Desktop">
          {{product.metafields.ite-ful-cap.title-desktop}}
        </div>
        {% endif %}


      {%if product.metafields.ite-ful-cap-m.title-desktop != blank %}
        <div class="fullCapacity-modules fulCap-Mobile">
          {{product.metafields.ite-ful-cap-m.title-desktop}}
        </div>
        {% endif %}
      {% endcomment %}

        <div class="itenarary-tabs-el">
