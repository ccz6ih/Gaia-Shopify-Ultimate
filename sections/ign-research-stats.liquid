{% comment %}
  RESEARCH STATS - FULLY CUSTOMIZABLE
  All colors, spacing, typography customizable via Shopify schema
  FIXED: Step changed to 1 for precise percentage control
{% endcomment %}

<style>
/* ===== RESEARCH STATS - FULLY CUSTOMIZABLE ===== */

.research-stats-section-{{ section.id }} {
  padding: {{ section.settings.section_padding }}px 20px;
  background: {{ section.settings.background_color }};
  position: relative;
  overflow: hidden;
}

{% if section.settings.show_particles %}
/* Floating particles background */
.research-stats-section-{{ section.id }}::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 50%, {{ section.settings.primary_color | color_modify: 'alpha', 0.03 }} 0%, transparent 50%),
              radial-gradient(circle at 80% 80%, {{ section.settings.secondary_color | color_modify: 'alpha', 0.03 }} 0%, transparent 50%);
  pointer-events: none;
}
{% endif %}

.stats-container-{{ section.id }} {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* Section Header */
.stats-header-{{ section.id }} {
  text-align: {{ section.settings.header_alignment }};
  margin-bottom: {{ section.settings.header_spacing }}px;
  {% if section.settings.enable_animations %}
  animation: fadeInDown-{{ section.id }} 0.8s ease;
  {% endif %}
}

.stats-pretitle-{{ section.id }} {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.pretitle_size }}px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: {{ section.settings.primary_color }};
  margin-bottom: 16px;
  {% if section.settings.enable_animations %}
  opacity: 0;
  animation: fadeIn-{{ section.id }} 0.8s ease 0.2s forwards;
  {% endif %}
}

.stats-title-{{ section.id }} {
  font-family: 'Poppins', sans-serif !important;
  font-size: {{ section.settings.title_size }}px;
  font-weight: 800 !important;
  line-height: 1.2;
  color: {{ section.settings.title_color }};
  margin: 0 0 24px 0;
  {% if section.settings.enable_animations %}
  opacity: 0;
  animation: fadeIn-{{ section.id }} 0.8s ease 0.4s forwards;
  {% endif %}
}

.stats-subtitle-{{ section.id }} {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.subtitle_size }}px;
  font-weight: 400;
  line-height: 1.6;
  color: {{ section.settings.text_color }};
  max-width: 700px;
  margin: 0 auto;
  {% if section.settings.enable_animations %}
  opacity: 0;
  animation: fadeIn-{{ section.id }} 0.8s ease 0.6s forwards;
  {% endif %}
}

/* Card Grid */
.stats-grid-{{ section.id }} {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cards_per_row }}, 1fr);
  gap: {{ section.settings.card_gap }}px;
}

.stat-card-{{ section.id }} {
  background: {{ section.settings.card_background }};
  border-radius: {{ section.settings.card_radius }}px;
  padding: {{ section.settings.card_padding }}px;
  box-shadow: 0 4px 20px {{ section.settings.card_shadow }};
  position: relative;
  overflow: hidden;
  transition: all {{ section.settings.animation_speed }}s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  {% if section.settings.enable_animations %}
  opacity: 0;
  transform: translateY(30px);
  animation: fadeInUp-{{ section.id }} 0.8s ease forwards;
  {% else %}
  opacity: 1;
  {% endif %}
}

{% if section.settings.enable_animations %}
.stat-card-{{ section.id }}:nth-child(1) { animation-delay: 0.2s; }
.stat-card-{{ section.id }}:nth-child(2) { animation-delay: 0.4s; }
.stat-card-{{ section.id }}:nth-child(3) { animation-delay: 0.6s; }
.stat-card-{{ section.id }}:nth-child(4) { animation-delay: 0.8s; }
{% endif %}

{% if section.settings.show_top_border %}
.stat-card-{{ section.id }}::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: {{ section.settings.border_height }}px;
  background: linear-gradient(90deg, {{ section.settings.primary_color }} 0%, {{ section.settings.secondary_color }} 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}
{% endif %}

{% if section.settings.enable_hover %}
.stat-card-{{ section.id }}:hover {
  transform: translateY(-{{ section.settings.hover_lift }}px);
  box-shadow: 0 12px 40px {{ section.settings.card_shadow }};
}

.stat-card-{{ section.id }}:hover::before {
  opacity: 1;
}
{% endif %}

{% if section.settings.show_glow %}
/* Premium glow effect */
.stat-card-{{ section.id }}::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, {{ section.settings.primary_color | color_modify: 'alpha', 0.05 }} 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.stat-card-{{ section.id }}:hover::after {
  opacity: 1;
}
{% endif %}

/* Growth Stat Number - Prominent */
.stat-number-{{ section.id }} {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.number_size }}px;
  font-weight: 900;
  color: {{ section.settings.number_color }};
  margin-bottom: 12px;
  line-height: 1;
  {% if section.settings.number_gradient %}
  background: linear-gradient(135deg, {{ section.settings.number_color }} 0%, {{ section.settings.number_color | color_darken: 20 }} 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  {% endif %}
}

.stat-label-{{ section.id }} {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.label_size }}px;
  font-weight: 600;
  color: {{ section.settings.primary_color }};
  margin-bottom: 0;
  line-height: 1.5;
}

/* Vertical Bar Styles */
.vertical-bar-wrapper-{{ section.id }} {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 20px;
  height: {{ section.settings.bar_height }}px;
  margin-top: auto;
  padding-top: 24px;
}

.bar-axis-{{ section.id }} {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  font-family: 'Poppins', sans-serif;
  font-size: 11px;
  font-weight: 600;
  color: {{ section.settings.text_color | color_modify: 'alpha', 0.5 }};
  min-width: 36px;
  text-align: right;
  padding-right: 8px;
}

/* Growth Chart - Better Sizing */
.chart-wrapper-{{ section.id }} {
  position: relative;
  height: {{ section.settings.bar_height }}px;
  margin-top: auto;
  flex-grow: 1;
  min-height: {{ section.settings.bar_height }}px;
}

.chart-wrapper-{{ section.id }} canvas {
  width: 100% !important;
  height: 100% !important;
}

/* Multi-Metric Styles */
.multi-header-{{ section.id }} {
  margin-bottom: 32px;
}

.multi-timeframe-{{ section.id }} {
  font-family: 'Poppins', sans-serif;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
  margin-bottom: 8px;
}

.multi-title-{{ section.id }} {
  font-family: 'Poppins', sans-serif !important;
  font-size: {{ section.settings.multi_title_size }}px;
  font-weight: 800 !important;
  color: {{ section.settings.title_color }};
  margin: 0;
  line-height: 1.1;
}

.metric-row-{{ section.id }} {
  margin-bottom: 24px;
}

.metric-row-{{ section.id }}:last-child {
  margin-bottom: 0;
}

.metric-info-{{ section.id }} {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.metric-label-{{ section.id }} {
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: {{ section.settings.title_color }};
}

.metric-value-{{ section.id }} {
  font-family: 'Poppins', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: {{ section.settings.primary_color }};
  background: {{ section.settings.badge_background }};
  padding: 6px 14px;
  border-radius: {{ section.settings.badge_radius }}px;
  box-shadow: 0 2px 8px {{ section.settings.primary_color | color_modify: 'alpha', 0.15 }};
}

.metric-bar-container-{{ section.id }} {
  position: relative;
  width: 100%;
  height: 40px;
  background: {{ section.settings.bar_background }};
  border: 1px solid {{ section.settings.bar_border }};
  border-radius: {{ section.settings.bar_radius }}px;
  overflow: hidden;
}

/* Percentage Stat - Vertical Bar Container */
.vertical-bar-container-{{ section.id }} {
  position: relative;
  flex: 1;
  max-width: 100px;
  height: 100%;
  background: {{ section.settings.bar_background }};
  border: 1px solid {{ section.settings.bar_border }};
  border-radius: {{ section.settings.bar_radius }}px;
  overflow: hidden;
}

/* Animations */
@keyframes fadeInDown-{{ section.id }} {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn-{{ section.id }} {
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp-{{ section.id }} {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Tablet Responsive */
@media (max-width: 990px) {
  .stats-grid-{{ section.id }} {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile Responsive */
@media (max-width: 749px) {
  .research-stats-section-{{ section.id }} {
    padding: {{ section.settings.section_padding | divided_by: 1.5 }}px 16px;
  }
  
  .stats-header-{{ section.id }} {
    margin-bottom: {{ section.settings.header_spacing | divided_by: 1.5 }}px;
  }
  
  .stats-title-{{ section.id }} {
    font-family: 'Poppins', sans-serif !important;
    font-size: {{ section.settings.title_size | times: 0.6 }}px;
  }
  
  .stats-subtitle-{{ section.id }} {
    font-size: {{ section.settings.subtitle_size | times: 0.9 }}px;
  }
  
  .stats-grid-{{ section.id }} {
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_gap | times: 0.75 }}px;
  }
  
  .stat-card-{{ section.id }} {
    padding: {{ section.settings.card_padding | times: 0.7 }}px;
  }
  
  .stat-number-{{ section.id }} {
    font-size: {{ section.settings.number_size | times: 0.65 }}px;
  }
  
  .stat-label-{{ section.id }} {
    font-size: {{ section.settings.label_size | times: 0.9 }}px;
  }
  
  .multi-title-{{ section.id }} {
    font-size: {{ section.settings.multi_title_size | times: 0.7 }}px;
  }
  
  .chart-wrapper-{{ section.id }} {
    height: {{ section.settings.bar_height | times: 0.8 }}px;
    min-height: {{ section.settings.bar_height | times: 0.8 }}px;
  }
  
  .vertical-bar-wrapper-{{ section.id }} {
    height: {{ section.settings.bar_height | times: 0.8 }}px;
  }
}
</style>

<div class="research-stats-section-{{ section.id }}">
  <div class="stats-container-{{ section.id }}">
    
    {% if section.settings.show_header %}
      <div class="stats-header-{{ section.id }}">
        {% if section.settings.pretitle != blank %}
          <div class="stats-pretitle-{{ section.id }}">{{ section.settings.pretitle }}</div>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="stats-title-{{ section.id }}">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="stats-subtitle-{{ section.id }}">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}
    
    <div class="stats-grid-{{ section.id }}">
    {% for block in section.blocks %}
      
      {% comment %} PERCENTAGE STAT - Vertical Bar {% endcomment %}
      {% if block.type == 'percentage_stat' %}
        <div class="stat-card-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="stat-number-{{ section.id }}">{{ block.settings.percentage }}%</div>
          <div class="stat-label-{{ section.id }}">{{ block.settings.label }}</div>
          
          <div class="vertical-bar-wrapper-{{ section.id }}">
            <div class="bar-axis-{{ section.id }}">
              <span>100%</span>
              <span>75%</span>
              <span>50%</span>
              <span>25%</span>
              <span>0%</span>
            </div>
            <div class="vertical-bar-container-{{ section.id }}">
              <div class="vertical-bar-fill-{{ section.id }}" data-target="{{ block.settings.percentage }}"></div>
            </div>
          </div>
        </div>
      {% endif %}
      
      {% comment %} GROWTH STAT - Chart.js Curve {% endcomment %}
      {% if block.type == 'growth_stat' %}
        <div class="stat-card-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="stat-number-{{ section.id }}">+{{ block.settings.percentage }}%</div>
          <div class="stat-label-{{ section.id }}">{{ block.settings.label }}</div>
          
          <div class="chart-wrapper-{{ section.id }}">
            <canvas 
              id="growth-chart-{{ block.id }}" 
              data-growth="{{ block.settings.percentage }}"
              data-days="{{ block.settings.days | default: 30 }}"
              data-primary="{{ section.settings.primary_color }}"
              data-secondary="{{ section.settings.secondary_color }}">
            </canvas>
          </div>
        </div>
      {% endif %}
      
      {% comment %} MULTI-METRIC STAT - Horizontal Bars {% endcomment %}
      {% if block.type == 'multi_metric' %}
        <div class="stat-card-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="multi-header-{{ section.id }}">
            {% if block.settings.timeframe != blank %}
              <p class="multi-timeframe-{{ section.id }}">{{ block.settings.timeframe }}</p>
            {% endif %}
            <h3 class="multi-title-{{ section.id }}">{{ block.settings.title }}</h3>
          </div>
          
          <div>
            {% assign metrics = block.settings.metrics | split: '|' %}
            {% for metric in metrics %}
              {% assign parts = metric | split: ':' %}
              {% assign label = parts[0] %}
              {% assign value = parts[1] | times: 1 %}
              
              <div class="metric-row-{{ section.id }}">
                <div class="metric-info-{{ section.id }}">
                  <span class="metric-label-{{ section.id }}">{{ label }}</span>
                  <span class="metric-value-{{ section.id }}">{{ value }}%</span>
                </div>
                <div class="metric-bar-container-{{ section.id }}">
                  <div class="metric-bar-fill-{{ section.id }}" data-target="{{ value }}"></div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
      
    {% endfor %}
    </div>
  
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>

<script>
(function() {
  'use strict';
  
  const sectionId = '{{ section.id }}';
  const barGradient = '{{ section.settings.bar_gradient }}';
  const primaryColor = '{{ section.settings.primary_color }}';
  const secondaryColor = '{{ section.settings.secondary_color }}';
  const animationSpeed = {{ section.settings.animation_speed }};
  const barRadius = {{ section.settings.bar_radius }};
  
  function hexToRgba(hex, alpha) {
    if (!hex || hex.length < 7) return `rgba(0, 0, 0, ${alpha})`;
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }
  
  function animateBars() {
    // Animate vertical bars
    const verticalBars = document.querySelectorAll('.vertical-bar-fill-' + sectionId);
    
    verticalBars.forEach((bar, index) => {
      const target = parseInt(bar.getAttribute('data-target'));
      const parent = bar.parentElement;
      const parentHeight = parent.offsetHeight;
      const pixelHeight = (parentHeight * target) / 100;
      
      let bgGradient;
      if (barGradient === 'three_color') {
        bgGradient = `linear-gradient(180deg, ${primaryColor} 0%, ${secondaryColor} 50%, ${hexToRgba(primaryColor, 0.8)} 100%)`;
      } else if (barGradient === 'two_color') {
        bgGradient = `linear-gradient(180deg, ${primaryColor} 0%, ${secondaryColor} 100%)`;
      } else {
        bgGradient = primaryColor;
      }
      
      bar.style.cssText = `
        display: block !important;
        position: absolute !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 0px !important;
        background: ${bgGradient} !important;
        border-radius: ${barRadius}px ${barRadius}px 0 0 !important;
        z-index: 1 !important;
        transition: height ${animationSpeed * 1.2}s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        box-shadow: 0 -4px 20px ${hexToRgba(primaryColor, 0.3)} !important;
      `;
      
      setTimeout(() => {
        bar.style.height = pixelHeight + 'px';
      }, 100 + (index * 150));
    });
    
    // Animate horizontal bars
    const horizontalBars = document.querySelectorAll('.metric-bar-fill-' + sectionId);
    
    horizontalBars.forEach((bar, index) => {
      const target = parseInt(bar.getAttribute('data-target'));
      const parent = bar.parentElement;
      const parentWidth = parent.offsetWidth;
      const pixelWidth = (parentWidth * target) / 100;
      
      let bgGradient;
      if (barGradient === 'three_color') {
        bgGradient = `linear-gradient(90deg, ${primaryColor} 0%, ${secondaryColor} 50%, ${hexToRgba(primaryColor, 0.8)} 100%)`;
      } else if (barGradient === 'two_color') {
        bgGradient = `linear-gradient(90deg, ${primaryColor} 0%, ${secondaryColor} 100%)`;
      } else {
        bgGradient = primaryColor;
      }
      
      bar.style.cssText = `
        display: block !important;
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        height: 100% !important;
        width: 0px !important;
        background: ${bgGradient} !important;
        border-radius: ${barRadius}px !important;
        z-index: 1 !important;
        transition: width ${animationSpeed}s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        box-shadow: 4px 0 12px ${hexToRgba(primaryColor, 0.2)} !important;
      `;
      
      setTimeout(() => {
        bar.style.width = pixelWidth + 'px';
      }, 200 + (index * 200));
    });
  }
  
  // Create growth charts with improved styling
  function createCharts() {
    if (typeof Chart === 'undefined') {
      setTimeout(createCharts, 100);
      return;
    }
    
    document.querySelectorAll('[id^="growth-chart-"]').forEach(canvas => {
      const growth = parseInt(canvas.dataset.growth);
      const days = parseInt(canvas.dataset.days) || 30;
      const chartColor = canvas.dataset.primary || primaryColor;
      const chartSecondary = canvas.dataset.secondary || secondaryColor;
      
      const dataPoints = [];
      const labels = [];
      const numPoints = 25;
      
      for (let i = 0; i <= numPoints; i++) {
        const day = Math.floor((i / numPoints) * days);
        const progress = i / numPoints;
        // Smooth easing curve
        const value = growth * (1 - Math.pow(1 - progress, 2.5));
        dataPoints.push(value);
        
        // Only show first and last day labels
        if (i === 0) {
          labels.push('day 0');
        } else if (i === numPoints) {
          labels.push('day ' + days);
        } else {
          labels.push('');
        }
      }
      
      const ctx = canvas.getContext('2d');
      
      // Create gradient for fill
      const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
      gradient.addColorStop(0, hexToRgba(chartColor, 0.25));
      gradient.addColorStop(0.5, hexToRgba(chartColor, 0.1));
      gradient.addColorStop(1, hexToRgba(chartColor, 0));
      
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            data: dataPoints,
            borderColor: chartColor,
            backgroundColor: gradient,
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointRadius: 0,
            pointHoverRadius: 6,
            pointHoverBackgroundColor: chartColor,
            pointHoverBorderColor: '#fff',
            pointHoverBorderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            intersect: false,
            mode: 'index'
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              enabled: true,
              backgroundColor: 'rgba(0, 0, 0, 0.8)',
              titleFont: { family: 'Poppins', weight: '600' },
              bodyFont: { family: 'Poppins' },
              padding: 12,
              cornerRadius: 8,
              callbacks: {
                label: function(context) {
                  return '+' + Math.round(context.parsed.y) + '% improvement';
                }
              }
            }
          },
          scales: {
            x: {
              display: true,
              grid: { 
                display: false 
              },
              ticks: {
                color: 'rgba(0, 0, 0, 0.35)',
                font: { 
                  size: 11,
                  family: 'Poppins',
                  weight: '500'
                },
                maxRotation: 0
              },
              border: { display: false }
            },
            y: {
              display: true,
              position: 'right',
              min: 0,
              max: Math.ceil(growth / 25) * 25 + 25,
              grid: { 
                display: false 
              },
              ticks: {
                color: 'rgba(0, 0, 0, 0.35)',
                font: { 
                  size: 11,
                  family: 'Poppins',
                  weight: '500'
                },
                stepSize: 25,
                callback: function(value) { 
                  return value + '%'; 
                }
              },
              border: { display: false }
            }
          },
          animation: {
            duration: animationSpeed * 1200,
            easing: 'easeOutQuart'
          }
        }
      });
    });
  }
  
  // Use IntersectionObserver for better performance
  const section = document.querySelector('.research-stats-section-' + sectionId);
  
  if (section) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setTimeout(animateBars, 300);
          setTimeout(createCharts, 400);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    
    observer.observe(section);
  } else {
    // Fallback if observer fails
    setTimeout(animateBars, 500);
    setTimeout(createCharts, 600);
  }
  
})();
</script>

{% schema %}
{
  "name": "IGN Research Stats",
  "settings": [
    {
      "type": "header",
      "content": "📝 Content"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Section Header",
      "default": true
    },
    {
      "type": "text",
      "id": "pretitle",
      "label": "Pretitle",
      "default": "University Studied"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Real Results**"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Published in peer-reviewed journals."
    },
    {
      "type": "header",
      "content": "🎨 Colors"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color (Bars & Accents)",
      "default": "#DE5201"
    },
