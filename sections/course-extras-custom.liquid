<div class="course-extras-slider-parent">
    <div class="course-extras-slider-holder">
        <p class="course-extras-slider-title"> 
          {%if product.metafields.lab-title-ke.key != blank %}
            {% else %}
        {{section.settings.title}} 
          {% endif %}
        </p>
        <h2 class="course-extras-paragraph">
          {% if product.metafields.sec-c-title.key != blank %}
            {{product.metafields.sec-c-title.key}}
            {% else %}
        {{section.settings.body-text}}
          {% endif %}
        </h2>
        <div class="course-extras-slider-el">
            <div class="courseExtrasSlider" role="group">
              <div class="splide__arrows">
                <button class="splide__arrow splide__arrow--prev">
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                  <g filter="url(#filter0_d_390_620)">
                    <circle cx="18" cy="18" r="16" transform="rotate(-180 18 18)" fill="white"/>
                  </g>
