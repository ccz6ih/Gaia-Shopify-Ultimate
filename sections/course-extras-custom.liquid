                </svg>
                </button>
              </div>
                <div class="splide__track">
                      <ul class="splide__list">
            {% for courseType in product.metafields.crs-extra-.image %}
                          <li class="splide__slide">
                            <div class="course-block-extra-holder">
                            <div class="course-extras-image-cover">
                            <img alt="{{courseType.title}}" src="{{courseType}}" class="course-extra-image-cover-main" />
                            </div>
                            <div class="text-content-for-course">
                          {% if product.metafields.crs-title-.key[forloop.index0] != blank %}
                            <h4 class="course-extra-title-main">{{product.metafields.crs-title-.key[forloop.index0]}} </h4>
                          {% endif %}
                            {% if product.metafields.course-html-type-txt-v.key[forloop.index0] %}
                              <div class="course-extra-title-main">{{ product.metafields.course-html-type-txt-v.key[forloop.index0] }}</div>
                            {% endif %}
                            {% if product.metafields.crs-body-info.key[forloop.index0] != blank %}
                            <p class="course-extra-body-text">{{product.metafields.crs-body-info.key[forloop.index0]}}</p>
                            {% endif %}
                            {% if product.metafields.course-html-type-v.key[forloop.index0] != blank %}
                            <div class="course-extra-body-text">{{product.metafields.course-html-type-v.key}}</div>
                            {% endif %} 
                            <div class="value-main-extra"><span class="billSign"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="11" viewBox="0 0 14 11" fill="none">
                            <path d="M13.5369 0.784439C13.4471 0.716997 13.3445 0.678166 13.2388 0.671605C13.1332 0.665044 13.0278 0.69097 12.9327 0.746939C10.778 2.01506 9.22381 1.41631 7.57868 0.781939C5.85512 0.118189 3.90195 -0.634311 1.29686 0.898189C1.19193 0.959903 1.10352 1.05584 1.04171 1.17508C0.979903 1.29431 0.947177 1.43204 0.947266 1.57256V9.07881C0.947185 9.20613 0.974045 9.33138 1.02532 9.44276C1.07659 9.55414 1.15058 9.64798 1.24032 9.71545C1.33007 9.78291 1.43261 9.82177 1.53829 9.82838C1.64397 9.83498 1.7493 9.8091 1.84437 9.75319C3.99909 8.48506 5.55331 9.08381 7.19844 9.71819C8.17658 10.0932 9.22848 10.5001 10.4316 10.5001C11.3489 10.5001 12.3535 10.2644 13.4803 9.60194C13.5852 9.54023 13.6736 9.44428 13.7354 9.32505C13.7972 9.20582 13.8299 9.06809 13.8299 8.92756V1.42131C13.83 1.29396 13.8031 1.16867 13.7519 1.05724C13.7006 0.945821 13.6266 0.851936 13.5369 0.784439ZM12.5831 8.44506C10.6092 9.45506 9.13342 8.88694 7.57868 8.28819C6.60054 7.91319 5.54863 7.50569 4.34557 7.50569C3.61253 7.50729 2.88503 7.65839 2.19397 7.95256V2.05506C4.16791 1.04506 5.6437 1.61256 7.19844 2.21194C8.71837 2.79756 10.4165 3.45194 12.5831 2.54756V8.44506ZM7.38856 3.25006C7.05979 3.25006 6.73841 3.36736 6.46505 3.58712C6.19169 3.80689 5.97864 4.11924 5.85282 4.4847C5.72701 4.85015 5.69409 5.25228 5.75823 5.64024C5.82237 6.02821 5.98068 6.38457 6.21316 6.66428C6.44563 6.94398 6.74182 7.13446 7.06427 7.21163C7.38671 7.28881 7.72094 7.2492 8.02468 7.09782C8.32842 6.94645 8.58803 6.6901 8.77068 6.3612C8.95334 6.03231 9.05083 5.64563 9.05083 5.25006C9.05 4.71994 8.87461 4.2118 8.56305 3.83695C8.25149 3.46209 7.82917 3.25106 7.38856 3.25006ZM7.38856 5.75006C7.30637 5.75006 7.22602 5.72074 7.15768 5.6658C7.08934 5.61086 7.03608 5.53277 7.00462 5.44141C6.97317 5.35004 6.96494 5.24951 6.98098 5.15252C6.99701 5.05553 7.03659 4.96644 7.09471 4.89651C7.15283 4.82658 7.22687 4.77896 7.30749 4.75967C7.3881 4.74038 7.47165 4.75028 7.54759 4.78812C7.62352 4.82597 7.68843 4.89005 7.7