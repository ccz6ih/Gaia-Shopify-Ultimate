                          </svg></span>{{product.metafields.course-value.ticket[forloop.index0]}}</div>
                          </div>
                          </div>
                          </li>
          {% endfor %}
                      </ul>
                </div>
              </div>
        </div>
    </div>
</div>

<script>

  var splideNew = new Splide('.courseExtrasSlider', {
    perPage: 2,
    arrows: true,
    pagination: false,
    perMove: 1,
    type: 'loop',
    autoplay: 'pause',
    adaptiveHeight: true,
    rewind: true,
    drag: true,
    interval: 4000,
    speed: 2000,
    keyboard: true,
    padding: {
      right: 320
    },
    breakpoints: {

      1780: {
        perPage: 2
      },
      1580: {
        perPage: 2
      },

      1240: {
        perPage: 2
      },

      990: {
        perPage: 2
      },
 

      767: {
        perPage: 1,
        perMove: 1,
 
        pagination: false,
        padding: {
      right: 0
    },


      }

    }
  });

  splideNew.mount();


</script>

{% schema %}
    {
      "name": "Course Extras Slider",
      "class": "fd-matters",
      "settings": [

      
       {
          "type": "text",
          "id": "title",
          "label": "Section Label",
          "default": "Section Label"
        },
        {
          "type": "textarea",
          "id": "body-text",
          "label": "Section Title",
          "default": "Seciton Title"
        }
       
      ],
      "presets": [
        {
            "name": "Course Extras Slider",
            "category": "Product Page Widgets"
        }
      ]
    } 
{% endschema %}  