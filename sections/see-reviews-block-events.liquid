<div class="reviews-block-banner">
    <div class="reviews-block-banner-holder" >
        <div class="reviews-block-banner-el">
            <div class="inside-reviews-holder">
            <div class="left-block-title-arrow">
                <h2 class="title-reviews-arrow">{{section.settings.title}} <svg xmlns="http://www.w3.org/2000/svg" width="22" height="12" viewBox="0 0 22 12" fill="none">
                <path d="M20.5865 0.422287C20.305 0.140762 19.9531 0 19.5308 0C19.1085 0 18.7566 0.140762 18.4751 0.422287L10.522 8.37537L2.56891 0.422287C2.28739 0.140762 1.93548 0 1.5132 0C1.09091 0 0.739003 0.140762 0.457478 0.422287C0.152493 0.727273 0 1.08504 0 1.4956C0 1.90616 0.152493 2.2522 0.457478 2.53372L9.46628 11.5425C9.60704 11.7067 9.77126 11.824 9.95894 11.8944C10.1466 11.9648 10.3343 12 10.522 12C10.7097 12 10.8974 11.9648 11.085 11.8944C11.2727 11.824 11.4369 11.7067 11.5777 11.5425L20.5865 2.53372C20.8915 2.2522 21.044 1.90616 21.044 1.4956C21.044 1.08504 20.8915 0.727273 20.5865 0.422287Z" fill="white"/>
              </svg></h2>
            </div>
            <div class="right-block-button">
                <a href="{{section.settings.btn-link}}">{{section.settings.btn-text}}</a>
            </div>
            </div>
        </div>
    </div> 

</div>
<script> 
  document.addEventListener("DOMContentLoaded", function() {
    const titleReviewsArrow = document.querySelector("h2.title-reviews-arrow");
    const customRSlider = document.getElementById("custom-r-slider");

    if (titleReviewsArrow && customRSlider) {
        titleReviewsArrow.addEventListener("click", function() {
            customRSlider.scrollIntoView({ behavior: "smooth" });
        });
    }
});

</script>

{% schema %}
    {
      "name": "Reviews Events Block",
      "class": "reviews-event-banner",
      "settings": [
  
       {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Explore your spirituality"
        },
        { 
          "type": "text",
          "id": "btn-text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
            "type": "url",
            "id": "btn-link",
            "label": "Button link"
        }
      ],
      "presets": [
        {
          "name": "Reviews Events Block",
          "category": "Page Banners" 
        }
      ]
    } 
  {% endschema %}  