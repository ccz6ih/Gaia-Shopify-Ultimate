<script>
  $(".ftI").click(function(){
        if (window.innerWidth > 767) { // Check if the screen width is greater than 767px
        $(".ffT").toggleClass("removeMargin");
        $(".ffIT").toggleClass("hideTheEntireContent")
        $(this).children("svg").toggleClass("rotateTheX");
        }else{
            $(".ffT").toggleClass("giveMargin");
        $(".ffIT").toggleClass("showContentFully");
            $(this).children(".mobile-expand-arrow").toggleClass("hideTheArrow");  
            $(this).children(".mobile-expanded-close").toggleClass("showTheClose");  
        }
    });
</script>
